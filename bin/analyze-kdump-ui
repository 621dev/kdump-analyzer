#!/bin/bash
# analyze-kdump 터미널 메뉴 UI
#
# 장애 현장에서 SSH나 콘솔로 접속한 서버에서 메뉴로 vmcore를 분석합니다.
#   - 이 서버(local): 이 서버에서 analyze-kdump를 실행합니다.
#   - 원격 서버: 서버 상태에 맞춰 세 가지 방식 중 하나로 분석합니다.
#       installed  원격에 설치된 analyze-kdump로 리포트 생성
#       upload     스크립트를 원격 임시 디렉터리로 보내 실행 (원격에는 crash와 vmlinux만 필요)
#       fetch      vmcore를 이 서버로 가져와서 분석 (원격에는 SSH 접속만 필요)
#     어느 방식이든 LLM 분석은 이 서버의 설정으로 실행합니다(API 키/구독 로그인을 원격에 둘 필요 없음).
#
# 환경변수:
#   ANALYZE_KDUMP_CONF     설정 파일 (기본 <설치 위치>/analyze-kdump.conf)
#   ANALYZE_KDUMP_SERVERS  접속 서버 목록 파일 (기본 <설치 위치>/servers.conf)
#   ANALYZE_KDUMP_BIN      analyze-kdump 경로 (기본: 이 스크립트와 같은 디렉터리)
# 설치 위치는 install.sh로 설치한 위치(.install-info가 있는 곳)이고, 아니면 기본 설치 위치
# /opt/kdump-analyzer입니다(거기 설치가 없고 예전 위치 /opt/kdump-tools에 있으면 그곳).

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
TOOL="${ANALYZE_KDUMP_BIN:-$SCRIPT_DIR/analyze-kdump}"
if [ -f "$SCRIPT_DIR/../.install-info" ]; then
    TOOL_BASE=$(cd "$SCRIPT_DIR/.." && pwd)
elif [ ! -f /opt/kdump-analyzer/.install-info ] && [ -f /opt/kdump-tools/.install-info ]; then
    TOOL_BASE=/opt/kdump-tools
else
    TOOL_BASE=/opt/kdump-analyzer
fi
CONFIG_FILE="${ANALYZE_KDUMP_CONF:-$TOOL_BASE/analyze-kdump.conf}"
SERVERS_FILE="${ANALYZE_KDUMP_SERVERS:-$TOOL_BASE/servers.conf}"
WHIPTAIL="${WHIPTAIL:-whiptail}"
PAGER_CMD="${PAGER_CMD:-less}"
TITLE="analyze-kdump"
CURRENT_SERVER="local"

DEFAULT_REMOTE_TOOL="/opt/kdump-analyzer/bin/analyze-kdump"
# 1.19.0까지의 기본 원격 경로. 원격 경로가 새 기본값인데 그 서버에는 예전 위치에만 설치돼 있으면 이 경로를 씁니다.
LEGACY_REMOTE_TOOL="/opt/kdump-tools/bin/analyze-kdump"
DEFAULT_CRASH_DIR="/var/crash"
# install.sh로 설치했다면 bin/의 상위 디렉터리에 설치 정보(.install-info)가 있습니다.
INSTALL_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
INSTALL_INFO="$INSTALL_DIR/.install-info"
UPDATE_CACHE="$INSTALL_DIR/.update-check"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)

# ---------------------------------------------------------------- 화면 helper

ui_size() {
    local lines cols
    lines=$(tput lines 2>/dev/null || echo 24)
    cols=$(tput cols 2>/dev/null || echo 80)
    UI_H=$((lines - 4))
    UI_W=$((cols - 8))
    [ "$UI_H" -gt 30 ] && UI_H=30
    [ "$UI_W" -gt 100 ] && UI_W=100
    [ "$UI_H" -lt 15 ] && UI_H=15
    [ "$UI_W" -lt 60 ] && UI_W=60
    UI_LIST_H=$((UI_H - 8))
}

# 안내 문구가 화면에서 차지하는 줄 수(긴 줄이 접히는 것 포함). 한글은 wc -L이 두 칸으로 셉니다.
ui_text_lines() {
    local width=$((UI_W - 4)) lines=0 line w

    while IFS= read -r line; do
        w=$(printf '%s' "$line" | wc -L)
        if [ "$w" -eq 0 ]; then
            lines=$((lines + 1))
        else
            lines=$((lines + (w + width - 1) / width))
        fi
    done < <(printf '%b\n' "$1")
    echo "$lines"
}

# 메뉴 상자 높이를 안내 문구 줄 수와 항목 수에 맞춥니다.
# 목록 영역을 고정으로 크게 잡으면 whiptail이 안내 문구를 첫 줄만 남기고 잘라 버립니다.
ui_fit() {
    local text="$1" items="$2" text_lines avail max

    ui_size
    max=$UI_H
    text_lines=$(ui_text_lines "$text")
    avail=$((max - 8 - text_lines))
    UI_LIST_H=$items
    if [ "$UI_LIST_H" -gt "$avail" ]; then
        UI_LIST_H=$avail
    fi
    [ "$UI_LIST_H" -lt 3 ] && UI_LIST_H=3
    UI_H=$((text_lines + UI_LIST_H + 8))
    [ "$UI_H" -gt "$max" ] && UI_H=$max
}

# 목록 맨 끝에 붙이는 "이전 메뉴로" 항목의 태그
BACK="<"
BACK_LABEL="← 이전 메뉴로"
# 취소 버튼 이름. 메인 메뉴에서만 "종료"로 바꿉니다.
UI_CANCEL="뒤로"

# whiptail은 선택 결과를 stderr로 내보내므로 stdout과 바꿔서 캡처합니다.
ui_menu() {
    local text="$1"
    shift
    ui_fit "$text" $(($# / 2))
    "$WHIPTAIL" --title "$TITLE" --ok-button "선택" --cancel-button "$UI_CANCEL" \
        --menu "$text" "$UI_H" "$UI_W" "$UI_LIST_H" "$@" 3>&1 1>&2 2>&3
}

ui_radio() {
    local text="$1\n(스페이스: 고르기, Enter: 확인)"
    shift
    ui_fit "$text" $(($# / 3))
    "$WHIPTAIL" --title "$TITLE" --ok-button "선택" --cancel-button "$UI_CANCEL" \
        --radiolist "$text" "$UI_H" "$UI_W" "$UI_LIST_H" "$@" 3>&1 1>&2 2>&3
}

ui_input() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --ok-button "확인" --cancel-button "$UI_CANCEL" \
        --inputbox "$1" 10 "$UI_W" "$2" 3>&1 1>&2 2>&3
}

ui_yesno() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --yesno "$1" 12 "$UI_W"
}

ui_msg() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --msgbox "$1" "$UI_H" "$UI_W"
}

# 오래 걸리는 확인 작업 동안 띄워 두는 안내 화면입니다(입력을 기다리지 않음).
# Python 3.6 이상: python3, 없으면 RHEL 8 최소 설치의 /usr/libexec/platform-python
find_python() {
    local p
    for p in "$(command -v python3 2>/dev/null)" /usr/libexec/platform-python; do
        if [ -n "$p" ] && [ -x "$p" ] && "$p" -c 'import sys; sys.exit(sys.version_info < (3, 6))' 2>/dev/null; then
            printf '%s' "$p"
            return 0
        fi
    done
    return 1
}

ui_info() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --infobox "$1" 8 "$UI_W"
}

# 리포트·분석 보기. less 하단에 나가는 방법을 항상 표시합니다(less는 Esc로 닫히지 않음).
view_file() {
    if [ "$PAGER_CMD" = "less" ] && command -v less >/dev/null 2>&1; then
        less -R -Ps"[q] 이전 화면으로   [↑↓ PgUp PgDn] 이동   [/] 검색   %f" "$1"
    elif command -v "$PAGER_CMD" >/dev/null 2>&1; then
        "$PAGER_CMD" "$1"
    else
        ui_size
        "$WHIPTAIL" --title "$(basename "$1") - Enter/Esc: 이전 화면으로" --scrolltext --textbox "$1" "$UI_H" "$UI_W"
    fi
}

# 진행 바: progress_bar <현재> <전체>
progress_bar() {
    local done="$1" total="$2" width=20 filled
    [ "$total" -gt 0 ] || total=1
    filled=$((done * width / total))
    [ "$filled" -gt "$width" ] && filled=$width
    printf '[%s%s]' "$(printf '%*s' "$filled" '' | tr ' ' '#')" "$(printf '%*s' "$((width - filled))" '' | tr ' ' '.')"
}

pause() {
    echo
    read -r -p "Enter를 누르면 메뉴로 돌아갑니다... " _
}

# ---------------------------------------------------------------- 설정 파일

# analyze-kdump와 같은 기준으로 conf 파일 권한을 확인합니다(셸 스크립트로 실행되기 때문).
config_is_safe() {
    local owner mode

    [ -f "$CONFIG_FILE" ] || return 0
    owner=$(stat -c '%u' "$CONFIG_FILE") || return 1
    mode=$(stat -c '%a' "$CONFIG_FILE") || return 1
    if [ "$owner" != "0" ] && [ "$owner" != "$(id -u)" ]; then
        return 1
    fi
    [ $((8#$mode & 8#022)) -eq 0 ]
}

conf_get() {
    local key="$1" default="${2:-}"

    if [ -f "$CONFIG_FILE" ] && config_is_safe; then
        (
            # shellcheck disable=SC1090
            . "$CONFIG_FILE" >/dev/null 2>&1
            printf '%s' "${!key:-$default}"
        )
    else
        printf '%s' "$default"
    fi
}

# conf 파일의 KEY="VALUE" 줄을 바꾸거나 추가합니다. 값은 큰따옴표 안에 들어가도록 이스케이프합니다.
conf_set() {
    local key="$1" value="$2" escaped tmp

    escaped=$(printf '%s' "$value" | sed -e 's/[\\"$`]/\\&/g')
    mkdir -p "$(dirname "$CONFIG_FILE")" || return 1
    tmp=$(mktemp "$CONFIG_FILE.XXXXXX") || return 1

    if [ -f "$CONFIG_FILE" ]; then
        CONF_LINE="$key=\"$escaped\"" awk -v key="$key" '
            index($0, key "=") == 1 { if (!done) print ENVIRON["CONF_LINE"]; done = 1; next }
            { print }
            END { if (!done) print ENVIRON["CONF_LINE"] }
        ' "$CONFIG_FILE" > "$tmp"
    else
        {
            echo "# analyze-kdump 설정 (analyze-kdump-ui에서 생성)"
            echo "$key=\"$escaped\""
        } > "$tmp"
    fi
    chmod 644 "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

report_dir() {
    conf_get REPORT_DIR "$TOOL_BASE/logs"
}

# ---------------------------------------------------------------- 접속 서버

# servers.conf 형식 (한 줄에 서버 하나):
#   이름|접속대상(user@host)|포트|sudo 사용(yes/no)|원격 analyze-kdump 경로|crash 디렉터리
servers_list() {
    [ -f "$SERVERS_FILE" ] || return 0
    grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$SERVERS_FILE"
}

server_line() {
    servers_list | awk -F'|' -v name="$1" '$1 == name { print; exit }'
}

# server_field <이름> <번호>: 1 이름, 2 대상, 3 포트, 4 sudo, 5 툴 경로, 6 crash 디렉터리
server_field() {
    server_line "$1" | cut -d'|' -f"$2"
}

server_label() {
    if [ "$1" = "local" ]; then
        echo "이 서버 ($(hostname))"
    else
        echo "$1 ($(server_field "$1" 2))"
    fi
}

servers_write() {
    local tmp

    mkdir -p "$(dirname "$SERVERS_FILE")" || return 1
    tmp=$(mktemp "$SERVERS_FILE.XXXXXX") || return 1
    {
        echo "# analyze-kdump-ui 접속 서버 목록"
        echo "# 이름|접속대상(user@host)|포트|sudo 사용(yes/no)|원격 analyze-kdump 경로|crash 디렉터리|분석 방식(auto/installed/upload/fetch)"
        cat
    } > "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$SERVERS_FILE"
}

server_save() {
    local name="$1" line="$2"
    { servers_list | awk -F'|' -v name="$name" '$1 != name'; echo "$line"; } | servers_write
}

server_delete() {
    servers_list | awk -F'|' -v name="$1" '$1 != name' | servers_write
}

# ssh 접속 대상: 비어 있거나 공백이 있거나 '-'로 시작하면 안 됩니다.
# '-'로 시작하면 ssh가 옵션(-oProxyCommand=... 등)으로 읽어 이 서버에서 명령이 실행될 수 있습니다.
valid_ssh_target() {
    case "$1" in
        ''|-*|*[[:space:]]*) return 1 ;;
    esac
}

# 원격 서버에서 명령을 실행합니다. 인자는 printf %q로 감싸 원격 셸에 그대로 전달합니다.
remote_run() {
    local name="$1" target port sudo quoted
    shift
    target=$(server_field "$name" 2)
    if ! valid_ssh_target "$target"; then
        echo "접속 대상이 올바르지 않습니다: $target (서버 설정을 확인해 주세요)" >&2
        return 255
    fi
    port=$(server_field "$name" 3)
    sudo=$(server_field "$name" 4)
    printf -v quoted '%q ' "$@"
    if [ "$sudo" = "yes" ]; then
        quoted="sudo -n $quoted"
    fi
    ssh "${SSH_OPTS[@]}" -p "${port:-22}" "$target" "$quoted"
}

# crash 셸처럼 터미널이 필요한 원격 명령을 실행합니다. sudo 비밀번호를 입력할 수 있습니다.
remote_tty() {
    local name="$1" target port sudo quoted
    shift
    target=$(server_field "$name" 2)
    if ! valid_ssh_target "$target"; then
        echo "접속 대상이 올바르지 않습니다: $target (서버 설정을 확인해 주세요)" >&2
        return 255
    fi
    port=$(server_field "$name" 3)
    sudo=$(server_field "$name" 4)
    printf -v quoted '%q ' "$@"
    if [ "$sudo" = "yes" ]; then
        quoted="sudo $quoted"
    fi
    ssh -t -p "${port:-22}" "$target" "$quoted"
}

server_method() {
    local method
    method=$(server_field "$1" 7)
    printf '%s' "${method:-auto}"
}

method_label() {
    case "$1" in
        auto) echo "자동 선택" ;;
        installed) echo "원격 설치본 실행" ;;
        upload) echo "무설치 실행 (스크립트를 임시로 보내 실행)" ;;
        fetch) echo "vmcore 가져와서 이 서버에서 분석" ;;
    esac
}

# 원격 서버 상태를 보고 분석 방식을 고릅니다: 설치본 > 무설치(crash 있음) > vmcore 가져오기
probe_method() {
    local out
    out=$(remote_run "$1" sh -c '
        case "$1" in */*) t=$1 ;; *) t=$(command -v "$1" 2>/dev/null || printf %s "$1") ;; esac
        if [ -x "$t" ]; then echo installed
        elif command -v crash >/dev/null 2>&1; then echo upload
        else echo fetch
        fi' sh "$(remote_tool "$1")" 2>/dev/null)
    case "$out" in
        installed|upload|fetch) printf '%s' "$out" ;;
        *) return 1 ;;
    esac
}

# 이 서버의 analyze-kdump를 원격 임시 디렉터리로 보냅니다. 출력: 원격 임시 디렉터리
upload_tool() {
    local dir
    dir=$(remote_run "$1" mktemp -d /tmp/kdump-tools.XXXXXX) || return 1
    case "$dir" in
        /tmp/kdump-tools.*) ;;
        *) return 1 ;;
    esac
    remote_run "$1" sh -c 'cat > "$1/analyze-kdump" && chmod 700 "$1/analyze-kdump"' sh "$dir" < "$TOOL" || return 1
    printf '%s' "$dir"
}

cleanup_upload() {
    case "$2" in
        /tmp/kdump-tools.*) remote_run "$1" rm -rf "$2" ;;
    esac
}

remote_tool() {
    local tool found
    tool=$(server_field "$1" 5)
    tool="${tool:-$DEFAULT_REMOTE_TOOL}"
    # 새 기본 경로로 등록했지만 그 서버에는 예전 기본 위치에만 설치돼 있으면 예전 경로를 씁니다.
    if [ "$tool" = "$DEFAULT_REMOTE_TOOL" ]; then
        found=$(remote_run "$1" sh -c 'if [ ! -x "$1" ] && [ -x "$2" ]; then echo "$2"; else echo "$1"; fi' \
            sh "$DEFAULT_REMOTE_TOOL" "$LEGACY_REMOTE_TOOL" 2>/dev/null | tail -n 1)
        case "$found" in
            "$DEFAULT_REMOTE_TOOL"|"$LEGACY_REMOTE_TOOL") tool="$found" ;;
        esac
    fi
    printf '%s' "$tool"
}

server_crash_dir() {
    local dir
    if [ "$1" = "local" ]; then
        dir=$(conf_get DEFAULT_VMCORE "")
        [ -d "$dir" ] || dir="$DEFAULT_CRASH_DIR"
    else
        dir=$(server_field "$1" 6)
    fi
    printf '%s' "${dir:-$DEFAULT_CRASH_DIR}"
}

# 원격 서버에서 받은 리포트와 그 분석 결과는 REPORT_DIR/remote/<서버 이름>에 모읍니다.
server_result_dir() {
    if [ "$1" = "local" ]; then
        report_dir
    else
        printf '%s/remote/%s' "$(report_dir)" "$1"
    fi
}

# ---------------------------------------------------------------- vmcore 분석

# 출력: "<mtime> <size> <경로>" (최근 순)
# 덤프 파일 이름: RHEL·SUSE는 <디렉터리>/vmcore, Ubuntu·Debian(kdump-tools)은 <YYYYMMDDHHMM>/dump.<YYYYMMDDHHMM>
# SSH로 받은 RHEL 덤프는 <디렉터리>/vmcore.flat입니다. crash가 읽지 못해 같은 디렉터리의 vmcore로 변환했으면
# vmcore가 있는 디렉터리의 vmcore.flat·dump.*는 목록에서 뺍니다.
DUMP_LIST_SH='for f in "$1"/*/vmcore "$1"/*/vmcore.flat "$1"/*/dump.[0-9]*; do [ -f "$f" ] || continue; case "$f" in */vmcore) ;; *) [ -f "${f%/*}/vmcore" ] && continue ;; esac; stat -c "%Y %s %n" "$f"; done | sort -rn'
list_vmcores() {
    local dir
    dir=$(server_crash_dir "$1")
    if [ "$1" = "local" ]; then
        sh -c "$DUMP_LIST_SH" sh "$dir"
    else
        remote_run "$1" sh -c "$DUMP_LIST_SH" sh "$dir"
    fi
}

human_size() {
    awk -v b="$1" 'BEGIN {
        split("B KB MB GB TB", u); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i]
    }'
}

choose_vmcore() {
    local server="$1" listing line mtime size path i=0 choice
    local -a items paths

    [ "$server" = "local" ] || ui_info "원격 서버에서 vmcore 목록을 읽는 중...\n\n$(server_label "$server")"
    listing=$(list_vmcores "$server")
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        mtime=${line%% *}
        line=${line#* }
        size=${line%% *}
        path=${line#* }
        i=$((i + 1))
        paths[i]="$path"
        items+=("$i" "$(date -d "@$mtime" '+%Y-%m-%d %H:%M') $(human_size "$size")  $path")
    done <<< "$listing"
    items+=("p" "경로 직접 입력" "$BACK" "$BACK_LABEL")

    choice=$(ui_menu "분석할 vmcore를 선택하세요. ($(server_label "$server"): $(server_crash_dir "$server"))" "${items[@]}") || return 1
    [ "$choice" = "$BACK" ] && return 1
    if [ "$choice" = "p" ]; then
        ui_input "vmcore 파일 또는 crash 디렉터리 경로:" "$(server_crash_dir "$server")"
        return
    fi
    printf '%s' "${paths[$choice]}"
}

# analyze-kdump 출력에서 "report:"/"analysis:" 경로를 읽습니다.
output_path() {
    sed -n "s/^$1:[[:space:]]*//p" "$2" | tail -n 1
}

exit_code_text() {
    case "$1" in
        0) echo "정상" ;;
        1) echo "입력/환경 오류" ;;
        2) echo "crash 실행 실패 (리포트 끝의 crash 실행 로그 확인)" ;;
        3) echo "LLM 분석 실패 (분석 파일에 사유 기록)" ;;
        255) echo "SSH 접속 실패" ;;
        *) echo "알 수 없는 오류" ;;
    esac
}

run_logged() {
    local log="$1"
    shift
    set -o pipefail
    "$@" 2>&1 | tee "$log"
    local status=$?
    set +o pipefail
    return "$status"
}

# 넷째 인자로 리포트 저장 디렉터리를 주면 설정의 REPORT_DIR 대신 씁니다(가져온 vmcore를 서버별로 모을 때).
analyze_local() {
    local vmcore="$1" mode="$2" log="$3" report_dir="${4:-}"
    local -a tool=("$TOOL")

    if [ -n "$report_dir" ]; then
        tool=(env "REPORT_DIR=$report_dir" "$TOOL")
    fi
    case "$mode" in
        shell)
            "${tool[@]}" "$vmcore"
            ;;
        report)
            run_logged "$log" "${tool[@]}" -r "$vmcore"
            ;;
        llm)
            run_logged "$log" "${tool[@]}" -llm "$vmcore"
            ;;
    esac
}

# 원격 서버에서 리포트를 만들고(뒤의 인자가 원격 명령) 가져온 뒤, 필요하면 이 서버에서 LLM 분석을 실행합니다.
remote_report_flow() {
    local server="$1" mode="$2" log="$3"
    local remote_report local_dir local_report status
    shift 3

    echo "[$server] crash 리포트 생성 중..."
    run_logged "$log" remote_run "$server" "$@"
    status=$?
    remote_report=$(output_path report "$log")
    if [ -z "$remote_report" ]; then
        return "$status"
    fi

    local_dir=$(server_result_dir "$server")
    mkdir -p "$local_dir" || return 1
    local_report="$local_dir/$(basename "$remote_report")"
    echo "[$server] 리포트 가져오는 중: $remote_report"
    if ! remote_run "$server" cat "$remote_report" > "$local_report"; then
        echo "리포트를 가져오지 못했습니다." | tee -a "$log"
        return 255
    fi
    echo "report:  $local_report" | tee -a "$log"
    if [ "$status" -ne 0 ] || [ "$mode" != "llm" ]; then
        return "$status"
    fi

    echo
    echo "[이 서버] LLM 분석 중..."
    run_logged "$log.llm" "$TOOL" --llm-report "$local_report"
    status=$?
    cat "$log.llm" >> "$log"
    return "$status"
}

analyze_remote_installed() {
    local server="$1" vmcore="$2" mode="$3" log="$4" tool

    tool=$(remote_tool "$server")
    if [ "$mode" = "shell" ]; then
        remote_tty "$server" "$tool" "$vmcore"
        return
    fi
    remote_report_flow "$server" "$mode" "$log" env ANALYZE_KDUMP_PROGRESS=1 "$tool" -r "$vmcore"
}

# 원격에 설치하지 않고, 이 서버의 analyze-kdump를 원격 임시 디렉터리로 보내 실행한 뒤 지웁니다.
# 원격 설정 파일은 읽지 않고 리포트도 임시 디렉터리에 만듭니다.
analyze_remote_upload() {
    local server="$1" vmcore="$2" mode="$3" log="$4" dir status

    echo "[$server] 스크립트를 임시로 보내는 중..."
    if ! dir=$(upload_tool "$server"); then
        echo "원격 임시 디렉터리에 스크립트를 보내지 못했습니다." | tee -a "$log"
        return 255
    fi

    if [ "$mode" = "shell" ]; then
        remote_tty "$server" "$dir/analyze-kdump" "$vmcore"
        status=$?
    else
        remote_report_flow "$server" "$mode" "$log" \
            env ANALYZE_KDUMP_PROGRESS=1 "REPORT_DIR=$dir/logs" "ANALYZE_KDUMP_CONF=$dir/none.conf" "$dir/analyze-kdump" -r "$vmcore"
        status=$?
    fi
    cleanup_upload "$server" "$dir"
    echo "[$server] 임시 파일 정리: $dir"
    return "$status"
}

# 원격 파일을 받으면서 받은 크기로 진행 바를 그립니다.
copy_with_progress() {
    local server="$1" src="$2" dest="$3" total="$4" pid status=0 start=$SECONDS current pct

    remote_run "$server" cat "$src" > "$dest" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        current=$(stat -c %s "$dest" 2>/dev/null || echo 0)
        pct=$((current * 100 / (total > 0 ? total : 1)))
        printf '\r\033[K  %s %3d%% %s/%s (%d초)' "$(progress_bar "$current" "$total")" "$pct" \
            "$(human_size "$current")" "$(human_size "$total")" "$((SECONDS - start))"
        sleep 0.5
    done
    wait "$pid" || status=$?
    current=$(stat -c %s "$dest" 2>/dev/null || echo 0)
    printf '\r\033[K  %s %3d%% %s/%s (%d초)\n' "$(progress_bar "$current" "$total")" \
        "$((current * 100 / (total > 0 ? total : 1)))" "$(human_size "$current")" "$(human_size "$total")" "$((SECONDS - start))"
    return "$status"
}

# vmcore를 이 서버의 crash 디렉터리(<서버 이름>-<원래 디렉터리 이름>/)로 가져와 이 서버에서 분석합니다.
# 이미 같은 크기로 가져온 vmcore가 있으면 다시 받지 않습니다.
analyze_remote_fetch() {
    local server="$1" vmcore="$2" mode="$3" log="$4"
    local local_crash dest_dir dest size free dmesg

    local_crash=$(server_crash_dir local)
    dest_dir="$local_crash/$server-$(basename "$(dirname "$vmcore")")"
    dest="$dest_dir/vmcore"

    size=$(remote_run "$server" stat -c %s "$vmcore") || {
        echo "원격 vmcore 정보를 읽지 못했습니다: $vmcore" | tee -a "$log"
        return 255
    }

    if [ -f "$dest" ] && [ "$(stat -c %s "$dest")" = "$size" ]; then
        echo "[$server] 이미 가져온 vmcore를 사용합니다: $dest"
    else
        mkdir -p "$dest_dir" || return 1
        free=$(df -PB1 "$dest_dir" | awk 'NR == 2 { print $4 }')
        if [ -n "$free" ] && [ "$size" -gt "$free" ]; then
            echo "디스크 공간이 부족합니다: 필요 $(human_size "$size"), 남은 공간 $(human_size "$free") ($dest_dir)" | tee -a "$log"
            return 1
        fi
        echo "[$server] vmcore 가져오는 중: $vmcore ($(human_size "$size"))"
        if ! copy_with_progress "$server" "$vmcore" "$dest.part" "$size" || [ "$(stat -c %s "$dest.part" 2>/dev/null)" != "$size" ]; then
            echo "vmcore를 가져오지 못했습니다." | tee -a "$log"
            rm -f "$dest.part"
            return 255
        fi
        mv "$dest.part" "$dest"
        chmod 600 "$dest"
        # 커널 로그: RHEL은 vmcore-dmesg.txt, Ubuntu·Debian은 dump.<시각> 옆의 dmesg.<시각>
        case "$(basename "$vmcore")" in
            dump.*) dmesg="$(dirname "$vmcore")/dmesg.$(basename "$vmcore" | cut -d. -f2-)" ;;
            *) dmesg="$(dirname "$vmcore")/vmcore-dmesg.txt" ;;
        esac
        remote_run "$server" cat "$dmesg" > "$dest_dir/vmcore-dmesg.txt" 2>/dev/null || rm -f "$dest_dir/vmcore-dmesg.txt"
        echo "[$server] 가져오기 완료: $dest"
    fi

    echo
    echo "[이 서버] 분석 시작"
    analyze_local "$dest" "$mode" "$log" "$(server_result_dir "$server")"
}

analyze_remote() {
    local server="$1" vmcore="$2" mode="$3" log="$4" method="$5" status

    case "$method" in
        installed)
            analyze_remote_installed "$server" "$vmcore" "$mode" "$log"
            ;;
        upload)
            analyze_remote_upload "$server" "$vmcore" "$mode" "$log"
            status=$?
            # 원격에 vmlinux가 없으면 vmcore를 가져와 이 서버에서 분석하도록 제안합니다.
            if [ "$status" -eq 1 ] && grep -q "vmlinux가 없습니다" "$log" && [ "$mode" != "shell" ]; then
                if ui_yesno "원격 서버에 이 커널의 vmlinux(디버그 심볼)가 없습니다.\n\nvmcore를 이 서버로 가져와서 분석할까요?\n(이 서버에 해당 커널의 vmlinux가 있어야 합니다)"; then
                    clear
                    analyze_remote_fetch "$server" "$vmcore" "$mode" "$log"
                    return
                fi
            fi
            return "$status"
            ;;
        fetch)
            analyze_remote_fetch "$server" "$vmcore" "$mode" "$log"
            ;;
    esac
}

# 원격 서버의 분석 방식을 고릅니다. 서버 설정이 auto이면 원격 상태를 확인해 기본 선택을 정합니다.
choose_method() {
    local server="$1" method detected note m
    local -a items=()

    method=$(server_method "$server")
    if [ "$method" = "auto" ]; then
        ui_info "원격 서버 상태를 확인하는 중...\n\n$(server_label "$server")"
        if detected=$(probe_method "$server"); then
            method="$detected"
            note="자동 감지 결과: $(method_label "$detected")"
        else
            ui_msg "원격 서버에 접속하지 못했습니다: $(server_label "$server")"
            return 1
        fi
    else
        note="서버 설정: $(method_label "$method")"
    fi

    for m in installed upload fetch; do
        items+=("$m" "$(method_label "$m")" "$([ "$m" = "$method" ] && echo ON || echo OFF)")
    done
    ui_radio "분석 방식을 고르세요. ($note)\n\n- 원격 설치본: 원격에 analyze-kdump, crash, vmlinux 필요\n- 무설치 실행: 원격에 crash, vmlinux 필요\n- vmcore 가져오기: 원격에는 SSH만 필요, 이 서버에 vmlinux 필요" "${items[@]}"
}

menu_analyze() {
    local vmcore mode log status report analysis choice method=""

    vmcore=$(choose_vmcore "$CURRENT_SERVER") || return
    [ -n "$vmcore" ] || return

    mode=$(ui_menu "분석 방법을 선택하세요.\n\n$vmcore" \
        report "리포트 생성" \
        llm "리포트 생성 + LLM 원인 분석" \
        shell "crash 셸 진입 (직접 분석)" \
        "$BACK" "$BACK_LABEL") || return
    [ "$mode" = "$BACK" ] && return

    if [ "$CURRENT_SERVER" != "local" ]; then
        method=$(choose_method "$CURRENT_SERVER") || return
        [ -n "$method" ] || return
    fi

    log=$(mktemp "${TMPDIR:-/tmp}/analyze-kdump-ui.XXXXXX")
    clear
    echo "===== $(server_label "$CURRENT_SERVER") : $vmcore ($mode${method:+, $(method_label "$method")}) ====="
    echo
    if [ "$CURRENT_SERVER" = "local" ]; then
        analyze_local "$vmcore" "$mode" "$log"
    else
        analyze_remote "$CURRENT_SERVER" "$vmcore" "$mode" "$log" "$method"
    fi
    status=$?

    if [ "$mode" = "shell" ]; then
        rm -f "$log" "$log.llm"
        return
    fi
    pause

    report=$(output_path report "$log")
    analysis=$(output_path analysis "$log")
    rm -f "$log" "$log.llm"

    while true; do
        local -a items=()
        [ -n "$analysis" ] && [ -f "$analysis" ] && items+=(analysis "LLM 분석 보기")
        [ -n "$report" ] && [ -f "$report" ] && items+=(report "리포트 보기")
        items+=(back "$BACK_LABEL")
        choice=$(ui_menu "결과: $(exit_code_text "$status") (종료 코드 $status)\n\n리포트: ${report:-없음}\n분석: ${analysis:-없음}" "${items[@]}") || return
        case "$choice" in
            analysis) view_file "$analysis" ;;
            report) view_file "$report" ;;
            *) return ;;
        esac
    done
}

# ---------------------------------------------------------------- 결과 보기

menu_results() {
    local dir report_prefix analysis_prefix choice file i action
    local -a items files

    dir=$(server_result_dir "$CURRENT_SERVER")
    report_prefix=$(conf_get REPORT_PREFIX kdump-report)
    analysis_prefix=$(conf_get ANALYSIS_PREFIX kdump-analysis)

    while true; do
        items=()
        files=()
        i=0
        while IFS= read -r file; do
            [ -n "$file" ] || continue
            i=$((i + 1))
            files[i]="$file"
            case "$(basename "$file")" in
                "$analysis_prefix"-*) items+=("$i" "[분석]   $(basename "$file")") ;;
                *) items+=("$i" "[리포트] $(basename "$file")") ;;
            esac
        done < <(ls -1t "$dir/$report_prefix"-*.txt "$dir/$analysis_prefix"-*.txt 2>/dev/null)

        if [ "$i" -eq 0 ]; then
            ui_msg "결과 파일이 없습니다.\n\n$dir"
            return
        fi

        items+=("$BACK" "$BACK_LABEL")
        choice=$(ui_menu "분석 결과 ($(server_label "$CURRENT_SERVER"))\n$dir\n\n파일을 고르면 내용을 보여줍니다. 보기 화면에서는 q로 돌아옵니다." "${items[@]}") || return
        [ "$choice" = "$BACK" ] && return
        file="${files[$choice]}"

        case "$(basename "$file")" in
            "$analysis_prefix"-*)
                view_file "$file"
                ;;
            *)
                action=$(ui_menu "$(basename "$file")" \
                    view "리포트 보기" \
                    llm "이 리포트를 LLM으로 (다시) 분석" \
                    "$BACK" "$BACK_LABEL") || continue
                [ "$action" = "$BACK" ] && continue
                if [ "$action" = "view" ]; then
                    view_file "$file"
                else
                    clear
                    "$TOOL" --llm-report "$file"
                    pause
                fi
                ;;
        esac
    done
}

# ---------------------------------------------------------------- 서버 선택/관리

menu_select_server() {
    local name choice
    local -a items=(local "$(server_label local)" "$([ "$CURRENT_SERVER" = local ] && echo ON || echo OFF)")

    while IFS='|' read -r name _; do
        [ -n "$name" ] || continue
        items+=("$name" "$(server_label "$name")" "$([ "$CURRENT_SERVER" = "$name" ] && echo ON || echo OFF)")
    done < <(servers_list)

    choice=$(ui_radio "분석할 서버를 선택하세요." "${items[@]}") || return
    [ -n "$choice" ] && CURRENT_SERVER="$choice"
}

valid_field() {
    case "$1" in
        *'|'*|'') return 1 ;;
        *) return 0 ;;
    esac
}

edit_server() {
    local name="$1" target port sudo tool crash_dir method current m
    local -a method_items=()

    if [ -z "$name" ]; then
        name=$(ui_input "서버 이름 (영문, 숫자, . _ -):" "") || return
        case "$name" in
            ''|local|*[!A-Za-z0-9._-]*)
                ui_msg "사용할 수 없는 이름입니다: $name"
                return
                ;;
        esac
        if [ -n "$(server_line "$name")" ]; then
            ui_msg "이미 등록된 이름입니다: $name"
            return
        fi
    fi

    target=$(ui_input "접속 대상 (user@host):" "$(server_field "$name" 2)") || return
    if ! valid_ssh_target "$target"; then
        ui_msg "접속 대상이 올바르지 않습니다: $target\n\nuser@host 형식으로 입력해 주세요(공백 없이, '-'로 시작하지 않게)."
        return
    fi
    port=$(ui_input "SSH 포트:" "$(server_field "$name" 3 | grep . || echo 22)") || return
    tool=$(ui_input "원격 서버의 analyze-kdump 경로:" "$(server_field "$name" 5 | grep . || echo "$DEFAULT_REMOTE_TOOL")") || return
    crash_dir=$(ui_input "원격 서버의 crash 디렉터리:" "$(server_field "$name" 6 | grep . || echo "$DEFAULT_CRASH_DIR")") || return
    if ui_yesno "원격 명령을 sudo로 실행할까요?\n\nroot가 아닌 계정으로 접속한다면 '예'를 선택하세요.\n(리포트 생성에는 비밀번호 없는 sudo(NOPASSWD)가 필요합니다)"; then
        sudo=yes
    else
        sudo=no
    fi

    current=$(server_method "$name")
    for m in auto installed upload fetch; do
        method_items+=("$m" "$(method_label "$m")" "$([ "$m" = "$current" ] && echo ON || echo OFF)")
    done
    method=$(ui_radio "기본 분석 방식을 고르세요. (분석할 때마다 바꿀 수 있습니다)\n\n자동 선택: 원격 설치본 → 무설치 실행(crash 있음) → vmcore 가져오기 순으로 고릅니다." "${method_items[@]}") || return
    [ -n "$method" ] || method=auto

    for f in "$target" "$port" "$tool" "$crash_dir"; do
        if ! valid_field "$f"; then
            ui_msg "빈 값이나 '|' 문자는 사용할 수 없습니다."
            return
        fi
    done
    case "$port" in
        *[!0-9]*)
            ui_msg "포트는 숫자여야 합니다: $port"
            return
            ;;
    esac

    if server_save "$name" "$name|$target|$port|$sudo|$tool|$crash_dir|$method"; then
        ui_msg "저장했습니다: $name ($target, $(method_label "$method"))"
    else
        ui_msg "저장하지 못했습니다: $SERVERS_FILE"
    fi
}

test_server() {
    local name="$1" tool out status detected

    tool=$(remote_tool "$name")
    ui_info "연결 테스트 중...\n\n$(server_label "$name")"
    out=$(remote_run "$name" sh -c '
        echo "접속: OK ($(hostname), $(id -un))"
        # 원격 경로가 명령 이름(analyze-kdump)이면 등록된 위치로 풉니다.
        case "$1" in */*) t=$1 ;; *) t=$(command -v "$1" 2>/dev/null || printf %s "$1") ;; esac
        if [ -x "$t" ]; then
            v=$("$t" --version 2>/dev/null | grep "^analyze-kdump " | head -n 1)
            echo "analyze-kdump: OK ($t, ${v:-버전 정보 없음: 이전 버전})"
        else
            echo "analyze-kdump: 없음 ($1)"
        fi
        # crash --version은 /dev/mem을 열어 보다 lockdown 경고를 커널 로그에 남기므로 패키지 정보로 버전을 읽습니다.
        if command -v crash >/dev/null 2>&1; then v=$(rpm -q --qf "%{VERSION}-%{RELEASE}" crash 2>/dev/null) || v=$(dpkg-query -W -f="\${Version}" crash 2>/dev/null) || v=; echo "crash: OK (crash ${v:-설치됨})"; else echo "crash: 없음"; fi
        n=$(for f in "$2"/*/vmcore "$2"/*/vmcore.flat "$2"/*/dump.[0-9]*; do [ -f "$f" ] || continue; case "$f" in */vmcore) ;; *) [ -f "${f%/*}/vmcore" ] && continue ;; esac; echo "$f"; done | wc -l); echo "vmcore: ${n}개 ($2)"
    ' sh "$tool" "$(server_crash_dir "$name")" 2>&1)
    status=$?
    if [ "$status" -ne 0 ] && [ -z "$out" ]; then
        out="접속 실패 (종료 코드 $status)"
    elif detected=$(probe_method "$name"); then
        out="$out\n\n설정된 분석 방식: $(method_label "$(server_method "$name")")\n자동 선택 시: $(method_label "$detected")"
    fi
    ui_msg "연결 테스트: $(server_label "$name")\n\n$out"
}

menu_servers() {
    local choice name action
    local -a items

    while true; do
        items=()
        while IFS='|' read -r name _; do
            [ -n "$name" ] || continue
            items+=("$name" "$(server_label "$name")")
        done < <(servers_list)
        items+=("+" "새 서버 추가" "$BACK" "$BACK_LABEL")

        choice=$(ui_menu "접속 서버 관리\n($SERVERS_FILE)" "${items[@]}") || return
        [ "$choice" = "$BACK" ] && return
        if [ "$choice" = "+" ]; then
            edit_server ""
            continue
        fi

        action=$(ui_menu "$(server_label "$choice")" \
            test "연결 테스트" \
            edit "수정" \
            delete "삭제" \
            "$BACK" "$BACK_LABEL") || continue
        case "$action" in
            test) test_server "$choice" ;;
            edit) edit_server "$choice" ;;
            delete)
                if ui_yesno "$choice 서버를 목록에서 삭제할까요?"; then
                    server_delete "$choice"
                    [ "$CURRENT_SERVER" = "$choice" ] && CURRENT_SERVER="local"
                fi
                ;;
        esac
    done
}

# ---------------------------------------------------------------- 설정

# 키|설명|종류(text/number/provider/bool)
SETTINGS=(
    "VMLINUX_BASE|vmlinux 보관 디렉터리|text"
    "REPORT_DIR|리포트 저장 디렉터리|text"
    "DEFAULT_VMCORE|기본 vmcore 또는 crash 디렉터리|text"
    "LLM_PROVIDER|LLM provider|provider"
    "CLI_AUTH|구독 CLI 인증 (로그인·토큰·연결 테스트)|auth"
    "LLM_MODEL|LLM 모델 (목록에서 선택, 비우면 기본값)|model"
    "LLM_BASE_URL|API 엔드포인트 (비우면 기본값)|text"
    "LLM_API_KEY_FILE|API 키 파일 경로|text"
    "LLM_CLI_PATH|구독 CLI 경로 (자동 탐색)|clipath"
    "LLM_CLI_TOKEN_FILE|Claude Code 장기 토큰 파일|text"
    "LLM_CLI_ARGS|구독 CLI 추가 인자|text"
    "LLM_MASK_SENSITIVE|LLM 입력 민감정보 마스킹|bool"
    "LLM_MAX_REPORT_CHARS|LLM 입력 최대 문자 수|number"
    "LLM_MAX_TOKENS|LLM 출력 최대 토큰|number"
    "LLM_TIMEOUT|LLM 호출 제한 시간(초)|number"
    "KDUMP_TOOLS_CHANNEL|업데이트 기준 (최신 릴리스 / 브랜치 최신 커밋)|channel"
    "KDUMP_TOOLS_REPO|업데이트 저장소 (GitHub owner/repo)|text"
    "KDUMP_TOOLS_BRANCH|업데이트 브랜치 (업데이트 기준이 branch일 때)|text"
    "KDUMP_TOOLS_UPDATE_CHECK|메뉴 시작 시 최신 버전 확인 (폐쇄망은 끄기)|bool"
)

setting_default() {
    case "$1" in
        VMLINUX_BASE) echo "$TOOL_BASE/vmlinux" ;;
        REPORT_DIR) echo "$TOOL_BASE/logs" ;;
        LLM_PROVIDER) echo openai ;;
        LLM_MASK_SENSITIVE) echo 1 ;;
        LLM_MAX_REPORT_CHARS) echo 60000 ;;
        LLM_MAX_TOKENS) echo 8192 ;;
        LLM_TIMEOUT) echo 120 ;;
        KDUMP_TOOLS_CHANNEL) echo release ;;
        KDUMP_TOOLS_REPO) echo 621dev/kdump-analyzer ;;
        KDUMP_TOOLS_BRANCH) echo main ;;
        KDUMP_TOOLS_UPDATE_CHECK) echo 1 ;;
    esac
}

edit_setting() {
    local key="$1" desc="$2" kind="$3" current value p

    current=$(conf_get "$key" "$(setting_default "$key")")
    case "$kind" in
        auth)
            menu_cli_auth
            return
            ;;
        model)
            edit_model
            return
            ;;
        clipath)
            edit_cli_path ""
            return
            ;;
        provider)
            local -a items=()
            for p in openai gemini claude claude-code codex; do
                items+=("$p" "$(case $p in
                    openai) echo "OpenAI / 호환 API (API 키)" ;;
                    gemini) echo "Google Gemini (API 키)" ;;
                    claude) echo "Anthropic Claude (API 키)" ;;
                    claude-code) echo "Claude Code CLI (Claude 구독)" ;;
                    codex) echo "Codex CLI (ChatGPT 구독)" ;;
                esac)" "$([ "$p" = "$current" ] && echo ON || echo OFF)")
            done
            value=$(ui_radio "$desc" "${items[@]}") || return
            ;;
        channel)
            value=$(ui_radio "$desc" \
                release "최신 릴리스 (검증된 버전, 권장)" "$([ "$current" != branch ] && echo ON || echo OFF)" \
                branch "브랜치 최신 커밋 (KDUMP_TOOLS_BRANCH, 릴리스 전 변경 포함)" "$([ "$current" = branch ] && echo ON || echo OFF)") || return
            rm -f "$UPDATE_CACHE" 2>/dev/null
            LATEST_OK=""
            ;;
        bool)
            if ui_yesno "$desc\n\n현재: $current\n\n켤까요?"; then value=1; else value=0; fi
            ;;
        number)
            value=$(ui_input "$desc (숫자):" "$current") || return
            case "$value" in
                ''|*[!0-9]*)
                    ui_msg "숫자를 입력해 주세요: $value"
                    return
                    ;;
            esac
            ;;
        *)
            value=$(ui_input "$desc:" "$current") || return
            ;;
    esac

    save_setting "$key" "$value" || return
    # 구독 CLI provider로 바꾸면 바로 로그인 상태를 확인할 수 있게 합니다.
    if [ "$kind" = "provider" ] && { [ "$value" = "claude-code" ] || [ "$value" = "codex" ]; }; then
        if ui_yesno "구독 CLI($value)를 사용하려면 이 서버에서 로그인되어 있어야 합니다.\n\n지금 로그인 상태를 확인하고 인증을 진행할까요?"; then
            menu_cli_auth
        fi
    fi
}

save_setting() {
    if conf_set "$1" "$2"; then
        ui_msg "저장했습니다.\n\n$1=\"$2\"\n($CONFIG_FILE)"
    else
        ui_msg "저장하지 못했습니다. 쓰기 권한을 확인해 주세요.\n\n$CONFIG_FILE"
        return 1
    fi
}

# ---------------------------------------------------------------- LLM 모델 목록

ui_password() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --ok-button "확인" --cancel-button "$UI_CANCEL" \
        --passwordbox "$1" 12 "$UI_W" 3>&1 1>&2 2>&3
}

trim() {
    local value="$1"
    value="${value//$'\r'/}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

# 환경변수 LLM_API_KEY, conf의 LLM_API_KEY, LLM_API_KEY_FILE 순으로 API 키를 찾습니다.
api_key_for_lookup() {
    local key key_file

    key="${LLM_API_KEY:-$(conf_get LLM_API_KEY "")}"
    if [ -z "$key" ]; then
        key_file=$(conf_get LLM_API_KEY_FILE "")
        if [ -n "$key_file" ] && [ -r "$key_file" ]; then
            key=$(sed -n '1p' "$key_file")
        fi
    fi
    trim "$key"
}

# provider의 모델 목록 API를 호출해 모델 이름을 한 줄에 하나씩 파일에 씁니다. 실패하면 MODEL_ERR에 사유를 둡니다.
# API 키는 명령줄에 보이지 않도록 curl 설정 파일로 넘깁니다.
fetch_models() {
    local provider="$1" out="$2" key base url cfg response err status

    MODEL_ERR=""
    if ! command -v curl >/dev/null 2>&1 || ! find_python >/dev/null; then
        MODEL_ERR="curl과 Python 3.6 이상(python3 또는 /usr/libexec/platform-python)이 필요합니다."
        return 1
    fi
    key=$(api_key_for_lookup)
    base=$(conf_get LLM_BASE_URL "")
    # 키 없이 쓰는 사내 호환 서버(Ollama 등)를 위해 LLM_BASE_URL이 있으면 키 없이도 시도합니다.
    if [ -z "$key" ] && { [ "$provider" != "openai" ] || [ -z "$base" ]; }; then
        MODEL_ERR="API 키가 없습니다. 설정의 LLM_API_KEY_FILE을 먼저 지정해 주세요."
        return 1
    fi

    cfg=$(mktemp "${TMPDIR:-/tmp}/kdump-models.XXXXXX")
    response="$cfg.json"
    err="$cfg.err"
    chmod 600 "$cfg"
    key=$(printf '%s' "$key" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    case "$provider" in
        openai)
            url="${base:-https://api.openai.com/v1/chat/completions}"
            url="${url%/chat/completions}/models"
            [ -n "$key" ] && printf 'header = "Authorization: Bearer %s"\n' "$key" > "$cfg"
            ;;
        claude)
            url="${base:-https://api.anthropic.com/v1/messages}"
            url="${url%/messages}/models?limit=100"
            {
                printf 'header = "x-api-key: %s"\n' "$key"
                printf 'header = "anthropic-version: %s"\n' "$(conf_get LLM_ANTHROPIC_VERSION 2023-06-01)"
            } > "$cfg"
            ;;
        gemini)
            url="https://generativelanguage.googleapis.com/v1beta/models?pageSize=200"
            printf 'header = "x-goog-api-key: %s"\n' "$key" > "$cfg"
            ;;
        *)
            MODEL_ERR="이 provider는 모델 목록을 조회할 수 없습니다: $provider"
            rm -f "$cfg"
            return 1
            ;;
    esac

    curl -fsS --connect-timeout 5 --max-time 15 --config "$cfg" "$url" > "$response" 2> "$err"
    status=$?
    rm -f "$cfg"
    if [ "$status" -ne 0 ]; then
        MODEL_ERR="모델 목록 API 호출 실패: $(head -c 200 "$err")"
        rm -f "$response" "$err"
        return 1
    fi

    # 공식 OpenAI API는 이미지·음성·임베딩 모델도 함께 주므로 대화용 모델만 남깁니다.
    PYTHONIOENCODING=utf-8 "$(find_python)" - "$provider" "$base" "$response" > "$out" 2> "$err" <<'PY'
import json, re, sys

provider, base, path = sys.argv[1:4]
with open(path, encoding="utf-8") as f:
    data = json.load(f)

names = []
if provider == "gemini":
    for model in data.get("models", []):
        if "generateContent" in model.get("supportedGenerationMethods", []):
            names.append(model.get("name", "").replace("models/", "", 1))
else:
    names = [model.get("id", "") for model in data.get("data", [])]
    if provider == "openai" and not base:
        skip = re.compile(r"audio|tts|image|embedding|transcribe|realtime|search|moderation|dall-e|whisper")
        names = sorted(n for n in names if re.match(r"(gpt|o[0-9]|chatgpt)", n) and not skip.search(n))

for name in names:
    if name:
        print(name)
PY
    status=$?
    rm -f "$response"
    if [ "$status" -ne 0 ] || [ ! -s "$out" ]; then
        MODEL_ERR="모델 목록을 읽지 못했습니다. $(head -c 200 "$err")"
        rm -f "$err"
        return 1
    fi
    rm -f "$err"
}

edit_model() {
    local provider current choice value tmp name i=0 found=0 note=""
    local -a items models

    provider=$(conf_get LLM_PROVIDER openai)
    current=$(conf_get LLM_MODEL "")
    case "$provider" in
        claude-code)
            # Claude Code CLI에는 모델 목록 명령이 없어 별칭을 제공합니다.
            items=(sonnet "Sonnet (최신 Sonnet)" opus "Opus (최신 Opus)" haiku "Haiku (최신 Haiku)")
            note="Claude Code는 별칭을 받으면 해당 계열의 최신 모델을 씁니다."
            ;;
        codex)
            note="Codex CLI에는 모델 목록 명령이 없습니다. 비워 두면 ~/.codex/config.toml의 모델을 씁니다."
            ;;
        *)
            tmp=$(mktemp "${TMPDIR:-/tmp}/kdump-model-list.XXXXXX")
            ui_info "모델 목록을 조회하는 중... ($provider)"
            if fetch_models "$provider" "$tmp"; then
                while IFS= read -r name; do
                    i=$((i + 1))
                    [ "$i" -gt 100 ] && break
                    models[i]="$name"
                    items+=("$i" "$name")
                done < "$tmp"
                note="$provider에서 조회한 모델 ${#models[@]}개"
            else
                note="모델 목록을 가져오지 못했습니다: $MODEL_ERR"
            fi
            rm -f "$tmp"
            ;;
    esac

    # 항목의 실제 모델 이름: claude-code는 태그가 곧 별칭이고, API 목록은 태그가 번호(models 배열 인덱스)입니다.
    model_of() {
        if [ "$provider" = "claude-code" ]; then
            printf '%s' "$1"
        else
            printf '%s' "${models[$1]}"
        fi
    }

    # radiolist 상태(ON/OFF)를 붙이고, 현재 값과 같은 항목을 선택해 둡니다.
    local -a radio=()
    local state
    for ((i = 0; i < ${#items[@]}; i += 2)); do
        state=OFF
        if [ -n "$current" ] && [ "$(model_of "${items[i]}")" = "$current" ]; then
            state=ON
            found=1
        fi
        radio+=("${items[i]}" "${items[i + 1]}" "$state")
    done
    radio+=("-" "기본값 사용 (비워 두기)" "$([ -z "$current" ] && echo ON || echo OFF)")
    radio+=("m" "직접 입력" "$([ -n "$current" ] && [ "$found" -eq 0 ] && echo ON || echo OFF)")

    choice=$(ui_radio "LLM 모델 ($provider)\n현재: ${current:-기본값}\n$note" "${radio[@]}") || return
    case "$choice" in
        '') return ;;
        -) value="" ;;
        m) value=$(ui_input "모델 이름:" "$current") || return ;;
        *) value=$(model_of "$choice") ;;
    esac
    save_setting LLM_MODEL "$value"
}

# ---------------------------------------------------------------- 구독 CLI 경로·인증

cli_name() {
    case "$1" in
        codex) echo codex ;;
        *) echo claude ;;
    esac
}

# 설정된 경로 또는 PATH의 CLI 실행 파일 경로를 출력합니다.
# LLM_CLI_PATH는 두 CLI가 함께 쓰므로, 파일 이름이 다른 CLI(claude/codex)를 가리키면 무시합니다.
cli_resolve() {
    local name path
    name=$(cli_name "$1")
    path=$(conf_get LLM_CLI_PATH "")
    if [ -z "$path" ] || [ "$(basename "$path")" != "$name" ]; then
        path="$name"
    fi
    command -v "$path" 2>/dev/null
}

# CLI를 실행합니다. 같은 폴더를 PATH 앞에 붙이고(nvm 설치본의 node), 토큰 파일이 있으면
# CLAUDE_CODE_OAUTH_TOKEN으로 넘깁니다(명령줄에 보이지 않게 환경변수로). CLI_TIMEOUT을 주면 시간 제한을 둡니다.
cli_exec() {
    local cli="$1" token_file token
    shift
    token_file=$(conf_get LLM_CLI_TOKEN_FILE "")
    (
        PATH="$(dirname "$cli"):$PATH"
        export PATH
        if [ -n "$token_file" ] && [ -r "$token_file" ]; then
            token=$(trim "$(sed -n '1p' "$token_file")")
            [ -n "$token" ] && export CLAUDE_CODE_OAUTH_TOKEN="$token"
        fi
        # 작업 폴더로 못 옮기면 엉뚱한 곳에서 CLI를 실행하지 않고 멈춥니다.
        if [ -n "${CLI_CWD:-}" ]; then
            cd "$CLI_CWD" || exit 1
        fi
        if [ -n "${CLI_TIMEOUT:-}" ]; then
            timeout "$CLI_TIMEOUT" "$cli" "$@"
        else
            "$cli" "$@"
        fi
    )
}

# 흔한 설치 위치에서 CLI를 찾아 "경로|버전"을 출력합니다(중복 제거).
find_cli_candidates() {
    local name="$1" path key version seen=" "

    for path in $(command -v "$name" 2>/dev/null) \
        /usr/local/bin/"$name" /usr/bin/"$name" /opt/*/bin/"$name" \
        /root/.local/bin/"$name" /root/.npm-global/bin/"$name" /root/.nvm/versions/node/*/bin/"$name" \
        /home/*/.local/bin/"$name" /home/*/.npm-global/bin/"$name" /home/*/.nvm/versions/node/*/bin/"$name"; do
        [ -x "$path" ] || continue
        key=$(readlink -f "$path")
        case "$seen" in
            *" $key "*) continue ;;
        esac
        seen="$seen$key "
        version=$(CLI_TIMEOUT=10 cli_exec "$path" --version 2>/dev/null </dev/null | head -n 1)
        echo "$path|${version:-버전 확인 실패}"
    done
}

edit_cli_path() {
    local provider="$1" name current path version choice value i=0 text
    local -a radio paths

    [ -n "$provider" ] || provider=$(conf_get LLM_PROVIDER openai)
    case "$provider" in
        claude-code|codex) ;;
        *)
            provider=$(ui_radio "어떤 구독 CLI의 경로를 찾을까요?" \
                claude-code "Claude Code (claude)" ON \
                codex "Codex (codex)" OFF) || return
            ;;
    esac
    name=$(cli_name "$provider")
    current=$(conf_get LLM_CLI_PATH "")

    ui_info "$name 실행 파일을 찾는 중..."
    while IFS='|' read -r path version; do
        [ -n "$path" ] || continue
        i=$((i + 1))
        paths[i]="$path"
        radio+=("$i" "$path ($version)" "$([ "$path" = "$current" ] && echo ON || echo OFF)")
    done < <(find_cli_candidates "$name")

    if [ "$i" -eq 0 ]; then
        text="$name 실행 파일을 찾지 못했습니다.\n설치: npm install -g $([ "$name" = claude ] && echo @anthropic-ai/claude-code || echo @openai/codex)"
    else
        text="찾은 $name 실행 파일 ${i}개 (괄호는 버전)"
    fi
    text="$text\nsudo로 실행하면 /usr/local/bin이 PATH에 없어 이름만으로는 못 찾을 수 있으니 전체 경로를 고르세요."
    radio+=("-" "비워 두기 (PATH에서 $name 찾기)" "$([ -z "$current" ] && echo ON || echo OFF)")
    if [ -n "$current" ] && ! printf '%s\n' "${paths[@]}" | grep -qxF -- "$current"; then
        radio+=("m" "직접 입력 (현재: $current)" ON)
    else
        radio+=("m" "직접 입력" OFF)
    fi

    choice=$(ui_radio "$text" "${radio[@]}") || return
    case "$choice" in
        '') return ;;
        -) value="" ;;
        m)
            value=$(ui_input "$name 실행 파일 전체 경로:" "$current") || return
            if [ -n "$value" ] && [ ! -x "$value" ]; then
                ui_msg "실행할 수 없는 경로입니다: $value"
                return
            fi
            ;;
        *) value="${paths[$choice]}" ;;
    esac
    save_setting LLM_CLI_PATH "$value"
}

# ---------------------------------------------------------------- 구독 CLI 설치

CLAUDE_INSTALL_URL="https://claude.ai/install.sh"
NODE_STREAM=22

node_major() {
    command -v node >/dev/null 2>&1 || return 1
    node --version 2>/dev/null | sed -n 's/^v\([0-9]*\).*/\1/p'
}

# Node.js가 없거나 너무 오래됐으면 설치합니다. RHEL 계열 기본 nodejs(16)는 Claude Code에 부족해서
# 모듈 스트림(nodejs:22)을 켜고 설치합니다.
ensure_nodejs() {
    local min="$1" major

    major=$(node_major)
    if [ -n "$major" ] && [ "$major" -ge "$min" ]; then
        if command -v npm >/dev/null 2>&1; then
            echo "Node.js v$major 사용 (필요: $min 이상)"
            return 0
        fi
        echo "Node.js v$major는 있지만 npm이 없습니다."
    elif [ -n "$major" ]; then
        echo "Node.js $min 이상이 필요합니다. (현재: v$major)"
    else
        echo "Node.js $min 이상이 필요합니다. (현재: 설치되어 있지 않음)"
    fi
    if command -v dnf >/dev/null 2>&1; then
        if dnf -q module list nodejs 2>/dev/null | grep -qE "^nodejs[[:space:]]+${NODE_STREAM}[[:space:]]"; then
            echo "dnf로 Node.js $NODE_STREAM 설치 중..."
            dnf -y module reset nodejs && dnf -y module enable "nodejs:$NODE_STREAM" &&
                dnf -y install nodejs npm && dnf -y distro-sync nodejs npm
        else
            echo "dnf로 nodejs 설치 중..."
            dnf -y install nodejs npm
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        echo "apt로 nodejs 설치 중..."
        apt-get update && apt-get install -y nodejs npm
    else
        echo "이 시스템의 패키지 관리자를 알 수 없습니다. Node.js $min 이상을 직접 설치해 주세요."
        return 1
    fi
    hash -r
    major=$(node_major)
    if [ -z "$major" ] || [ "$major" -lt "$min" ] || ! command -v npm >/dev/null 2>&1; then
        echo "Node.js $min 이상과 npm을 준비하지 못했습니다. (현재 Node.js: ${major:-없음}, npm: $(command -v npm >/dev/null 2>&1 && echo 있음 || echo 없음))"
        return 1
    fi
    echo "Node.js v$major 설치 완료"
}

# npm 전역 설치 후 실행 파일 경로를 출력합니다.
npm_install_cli() {
    local package="$1" name="$2" prefix

    echo "npm install -g $package"
    npm install -g "$package" || return 1
    prefix=$(npm prefix -g 2>/dev/null)
    [ -x "$prefix/bin/$name" ] || return 1
    INSTALLED_CLI="$prefix/bin/$name"
}

# 공식 설치 스크립트를 내려받아 실행합니다(Node.js 불필요). 실행 계정의 ~/.local/bin에 설치됩니다.
native_install_claude() {
    local script

    script=$(mktemp "${TMPDIR:-/tmp}/claude-install.XXXXXX.sh")
    echo "공식 설치 스크립트 받는 중: $CLAUDE_INSTALL_URL"
    if ! curl -fsSL --connect-timeout 10 --max-time 120 "$CLAUDE_INSTALL_URL" -o "$script"; then
        echo "설치 스크립트를 받지 못했습니다(인터넷 연결 확인)."
        rm -f "$script"
        return 1
    fi
    # 공식 설치 스크립트는 sudo 실행을 막습니다. 분석이 root로 실행되므로 root 설치가 의도된 동작이라
    # 스크립트가 안내하는 CLAUDE_INSTALL_ALLOW_SUDO=1로 허용합니다.
    CLAUDE_INSTALL_ALLOW_SUDO=1 bash "$script"
    local status=$?
    rm -f "$script"
    [ "$status" -eq 0 ] || return "$status"
    # 다른 위치에 예전 claude가 있어도 방금 설치한 것을 쓰도록, 공식 스크립트의 설치 위치를 먼저 봅니다.
    INSTALLED_CLI="$HOME/.local/bin/claude"
    [ -x "$INSTALLED_CLI" ] || INSTALLED_CLI=$(command -v claude 2>/dev/null || true)
    [ -n "$INSTALLED_CLI" ] && [ -x "$INSTALLED_CLI" ]
}

install_cli() {
    local provider="$1" name method status version

    name=$(cli_name "$provider")
    if [ "$(id -u)" -ne 0 ]; then
        ui_msg "설치는 root로 실행해야 합니다. (sudo analyze-kdump-ui)"
        return 1
    fi

    if [ "$provider" = "claude-code" ]; then
        method=$(ui_radio "Claude Code 설치 방법을 고르세요." \
            native "공식 설치 스크립트 (권장, Node.js 불필요, ~/.local/bin)" ON \
            npm "npm 전역 설치 (Node.js $NODE_STREAM 필요, 없으면 함께 설치)" OFF) || return 1
        [ -n "$method" ] || return 1
    else
        method=npm
    fi

    case "$method" in
        native)
            ui_yesno "다음을 실행합니다.\n\n  curl -fsSL $CLAUDE_INSTALL_URL | CLAUDE_INSTALL_ALLOW_SUDO=1 bash\n\n$(id -un) 계정의 ~/.local/bin/claude 에 설치합니다.\n분석이 이 계정으로 실행되므로 이 계정에 설치하는 것이 맞습니다.\n(공식 스크립트는 sudo 실행을 기본으로 막아서, 허용 옵션을 함께 지정합니다)\n\n진행할까요?" || return 1
            ;;
        npm)
            ui_yesno "다음을 실행합니다.\n\n  1. Node.js 확인 (없거나 오래됐으면 패키지 관리자로 Node.js $NODE_STREAM 설치)\n  2. npm install -g $([ "$name" = claude ] && echo @anthropic-ai/claude-code || echo @openai/codex)\n\n진행할까요?" || return 1
            ;;
    esac

    clear
    echo "===== $name 설치 ====="
    INSTALLED_CLI=""
    case "$method" in
        native)
            native_install_claude
            status=$?
            ;;
        npm)
            if [ "$name" = "claude" ]; then
                ensure_nodejs 22 && npm_install_cli @anthropic-ai/claude-code claude
            else
                ensure_nodejs 16 && npm_install_cli @openai/codex codex
            fi
            status=$?
            ;;
    esac

    if [ "$status" -eq 0 ] && [ -n "$INSTALLED_CLI" ]; then
        version=$(CLI_TIMEOUT=20 cli_exec "$INSTALLED_CLI" --version 2>/dev/null </dev/null | head -n 1)
        echo
        echo "설치 완료: $INSTALLED_CLI (${version:-버전 확인 실패})"
        pause
        # sudo 실행 경로에 없을 수 있으므로 설치된 전체 경로를 설정에 저장합니다.
        conf_set LLM_CLI_PATH "$INSTALLED_CLI"
        ui_msg "설치를 마쳤습니다: $name\n\n$INSTALLED_CLI\n${version:-}\n\n설정에 경로를 저장했습니다(LLM_CLI_PATH). 이어서 로그인을 진행합니다."
        return 0
    fi
    echo
    echo "설치에 실패했습니다. 위의 오류를 확인해 주세요."
    pause
    return 1
}

cli_auth_status() {
    local provider="$1" cli="$2"

    case "$provider" in
        claude-code) CLI_TIMEOUT=20 cli_exec "$cli" auth status --text 2>&1 </dev/null | head -n 8 ;;
        codex) CLI_TIMEOUT=20 cli_exec "$cli" login status 2>&1 </dev/null | head -n 5 ;;
    esac
}

# claude setup-token이 출력한 토큰을 받아 root만 읽을 수 있는 파일에 저장하고, 설정에는 경로만 남깁니다.
save_cli_token() {
    local token secrets file

    secrets="$(dirname "$CONFIG_FILE")/secrets"
    file="$secrets/claude-oauth-token"
    token=$(ui_password "Claude Code 장기 토큰을 붙여넣으세요. (claude setup-token 출력)\n\n토큰은 $file 에 root만 읽을 수 있게 저장하고,\n설정에는 파일 경로(LLM_CLI_TOKEN_FILE)만 남깁니다.") || return
    token=$(trim "$token")
    if [ -z "$token" ]; then
        ui_msg "토큰이 비어 있어 저장하지 않았습니다."
        return
    fi
    case "$token" in
        *[[:space:]]*)
            ui_msg "토큰에 공백이 들어 있습니다. 출력된 토큰 한 줄만 붙여넣어 주세요."
            return
            ;;
    esac
    install -d -m 700 "$secrets" || return
    (umask 077 && printf '%s\n' "$token" > "$file") || return
    chmod 600 "$file"
    save_setting LLM_CLI_TOKEN_FILE "$file"
}

# 짧은 요청을 한 번 보내 실제로 응답이 오는지 확인합니다(구독 사용량을 조금 씁니다).
cli_connection_test() {
    local provider="$1" cli="$2" model out status dir

    model=$(conf_get LLM_MODEL "")
    dir=$(mktemp -d "${TMPDIR:-/tmp}/kdump-cli-test.XXXXXX")
    ui_info "연결 테스트 중... (짧은 요청 1회, 최대 2분)"
    case "$provider" in
        claude-code)
            out=$(CLI_CWD="$dir" CLI_TIMEOUT=120 cli_exec "$cli" -p "Reply with exactly: OK" --output-format text \
                --tools "" --strict-mcp-config --no-session-persistence ${model:+--model "$model"} 2>&1 </dev/null)
            status=$?
            ;;
        codex)
            CLI_CWD="$dir" CLI_TIMEOUT=120 cli_exec "$cli" exec --skip-git-repo-check --sandbox read-only --color never \
                --ephemeral --output-last-message "$dir/out.txt" ${model:+--model "$model"} "Reply with exactly: OK" \
                > "$dir/log.txt" 2>&1 </dev/null
            status=$?
            out=$(cat "$dir/out.txt" 2>/dev/null)
            [ -n "$out" ] || out=$(tail -n 8 "$dir/log.txt")
            ;;
    esac
    case "$dir" in
        */kdump-cli-test.*) rm -rf "$dir" ;;
    esac
    if [ "$status" -eq 0 ]; then
        ui_msg "연결 테스트 성공 (${model:-기본 모델})\n\n응답: $(printf '%s' "$out" | tail -n 3)"
    else
        ui_msg "연결 테스트 실패 (종료 코드 $status)\n\n$(printf '%s' "$out" | tail -n 8)\n\n로그인 상태와 사용 한도를 확인해 주세요."
    fi
}

menu_cli_auth() {
    local provider name cli status choice token_file
    local -a items

    provider=$(conf_get LLM_PROVIDER openai)
    case "$provider" in
        claude-code|codex) ;;
        *)
            provider=$(ui_radio "어떤 구독 CLI를 인증할까요?\n(설정의 LLM_PROVIDER는 바뀌지 않습니다)" \
                claude-code "Claude Code (Claude Pro/Max 구독)" ON \
                codex "Codex (ChatGPT 구독)" OFF) || return
            ;;
    esac
    name=$(cli_name "$provider")

    while true; do
        if ! cli=$(cli_resolve "$provider"); then
            choice=$(ui_menu "$name 명령을 찾지 못했습니다.\n\n설치되어 있지 않다면 '설치'를 고르세요.\n이미 설치했다면 sudo 실행 경로(/usr/local/bin 없음) 때문일 수 있으니 '설치된 위치 찾기'를 고르세요." \
                install "$name 설치" \
                find "설치된 위치 찾기 (경로 지정)" \
                "$BACK" "$BACK_LABEL") || return
            case "$choice" in
                install) install_cli "$provider" ;;
                find) edit_cli_path "$provider" ;;
                *) return ;;
            esac
            cli_resolve "$provider" >/dev/null && continue
            return
        fi

        ui_info "$name 로그인 상태를 확인하는 중..."
        status=$(cli_auth_status "$provider" "$cli")
        token_file=$(conf_get LLM_CLI_TOKEN_FILE "")
        items=()
        case "$provider" in
            claude-code)
                items+=(token "장기 토큰 발급 (claude setup-token) - 화면 없는 서버 권장"
                    paste "다른 PC에서 발급한 토큰 붙여넣기"
                    login "브라우저 로그인 (claude auth login)")
                [ -n "$token_file" ] && items+=(untoken "저장된 토큰 사용 중지 ($token_file)")
                ;;
            codex)
                items+=(device "기기 코드 로그인 (codex login --device-auth) - 화면 없는 서버 권장"
                    login "브라우저 로그인 (codex login)")
                ;;
        esac
        items+=(test "연결 테스트 (짧은 요청 1회)" "$BACK" "$BACK_LABEL")

        choice=$(ui_menu "구독 CLI 인증: $name\n실행 파일: $cli\n실행 계정: $(id -un) (분석도 이 계정으로 실행됩니다)\n\n현재 상태:\n${status:-상태를 읽지 못했습니다}" "${items[@]}") || return
        case "$choice" in
            token)
                clear
                echo "===== Claude Code 장기 토큰 발급 ====="
                echo "1. 표시되는 주소를 브라우저(다른 PC도 가능)에서 열어 Claude 구독 계정으로 로그인합니다."
                echo "2. 화면에 나오는 코드를 여기에 붙여넣습니다."
                echo "3. 마지막에 출력되는 토큰(sk-ant-oat...)을 복사해 두세요. 다음 화면에서 붙여넣습니다."
                echo
                cli_exec "$cli" setup-token
                pause
                save_cli_token
                ;;
            paste)
                save_cli_token
                ;;
            login)
                clear
                echo "===== $name 브라우저 로그인 ====="
                echo "표시되는 주소를 브라우저에서 열어 구독 계정으로 로그인하세요."
                echo
                if [ "$provider" = "claude-code" ]; then
                    cli_exec "$cli" auth login --claudeai
                else
                    cli_exec "$cli" login
                fi
                pause
                ;;
            device)
                clear
                echo "===== Codex 기기 코드 로그인 ====="
                echo "표시되는 주소를 아무 기기의 브라우저에서 열고, 화면의 코드를 입력하세요."
                echo
                cli_exec "$cli" login --device-auth
                pause
                ;;
            untoken)
                if ui_yesno "저장된 토큰 파일을 더 이상 사용하지 않을까요?\n(파일은 지우지 않습니다: $token_file)"; then
                    save_setting LLM_CLI_TOKEN_FILE ""
                fi
                ;;
            test)
                cli_connection_test "$provider" "$cli"
                ;;
            *)
                return
                ;;
        esac
    done
}

menu_settings() {
    local entry key desc kind choice
    local -a items

    if ! config_is_safe; then
        ui_msg "설정 파일 권한이 안전하지 않아 읽지 않습니다.\n소유자가 root 또는 실행 사용자이고 group/other 쓰기 권한이 없어야 합니다.\n\n$CONFIG_FILE"
        return
    fi

    while true; do
        items=()
        for entry in "${SETTINGS[@]}"; do
            IFS='|' read -r key desc kind <<< "$entry"
            if [ "$kind" = "auth" ]; then
                items+=("$key" "$desc")
            else
                items+=("$key" "$desc: $(conf_get "$key" "$(setting_default "$key")")")
            fi
        done
        items+=("$BACK" "$BACK_LABEL")
        choice=$(ui_menu "설정 ($CONFIG_FILE)\n이 서버의 분석과, 원격 서버 리포트의 LLM 분석에 적용됩니다.\nAPI 키는 파일로 관리하고 여기서는 경로만 지정합니다." "${items[@]}") || return
        [ "$choice" = "$BACK" ] && return
        for entry in "${SETTINGS[@]}"; do
            IFS='|' read -r key desc kind <<< "$entry"
            if [ "$key" = "$choice" ]; then
                edit_setting "$key" "$desc" "$kind"
            fi
        done
    done
}

# ---------------------------------------------------------------- 버전/업데이트

info_get() {
    sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1
}

# 버전 표시: 값이 없으면 "버전 정보 없음"으로 보여줍니다(VERSION 파일이 없는 이전 버전).
version_text() {
    case "$1" in
        ''|unknown|'?') echo "버전 정보 없음" ;;
        *) echo "v$1" ;;
    esac
}

current_version() {
    local version
    version=$(info_get VERSION "$INSTALL_INFO")
    [ -n "$version" ] || version=$(head -n 1 "$INSTALL_DIR/VERSION" 2>/dev/null | tr -d '[:space:]')
    printf '%s' "${version:-unknown}"
}

current_commit() {
    local commit
    commit=$(info_get COMMIT "$INSTALL_INFO")
    if [ -z "$commit" ] && command -v git >/dev/null 2>&1; then
        commit=$(git -c safe.directory="$INSTALL_DIR" -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null)
    fi
    printf '%s' "$commit"
}

update_repo() {
    conf_get KDUMP_TOOLS_REPO "$(setting_default KDUMP_TOOLS_REPO)"
}

update_branch() {
    conf_get KDUMP_TOOLS_BRANCH "$(setting_default KDUMP_TOOLS_BRANCH)"
}

# release: 최신 릴리스 태그, branch: KDUMP_TOOLS_BRANCH의 최신 커밋
update_channel() {
    case "$(conf_get KDUMP_TOOLS_CHANNEL "$(setting_default KDUMP_TOOLS_CHANNEL)")" in
        branch) echo branch ;;
        *) echo release ;;
    esac
}

# 업데이트 대상 설명: "최신 릴리스 v1.16.0" 또는 "main 브랜치"
update_target_text() {
    if [ "$(update_channel)" = release ]; then
        printf '최신 릴리스%s' "${LATEST_REF:+ $LATEST_REF}"
    else
        printf '%s 브랜치' "$(update_branch)"
    fi
}

# a가 b보다 새 버전이면 참 (1.10.0 > 1.9.0)
version_gt() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# GitHub의 최신 릴리스 태그를 LATEST_REF에 채웁니다.
latest_release_tag() {
    LATEST_REF=$(curl -fsSL --connect-timeout 3 --max-time 5 \
        "https://api.github.com/repos/$1/releases/latest" 2>/dev/null \
        | sed -n 's/^[[:space:]]*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
    case "$LATEST_REF" in
        ''|*[!A-Za-z0-9._/-]*)
            LATEST_REF=""
            return 1
            ;;
    esac
}

# GitHub에서 최신 릴리스(또는 브랜치)의 커밋과 그 커밋의 VERSION을 읽어
# LATEST_REF/LATEST_COMMIT/LATEST_VERSION을 채우고 캐시에 남깁니다.
check_latest() {
    local repo

    repo=$(update_repo)
    LATEST_REF=""
    LATEST_COMMIT=""
    LATEST_VERSION=""
    command -v curl >/dev/null 2>&1 || return 1
    # 메뉴 시작 때 실행하므로 인터넷이 막힌 서버에서도 오래 기다리지 않도록 짧게 끊습니다.
    if [ "$(update_channel)" = release ]; then
        latest_release_tag "$repo" || return 1
    else
        LATEST_REF=$(update_branch)
    fi
    LATEST_COMMIT=$(curl -fsSL --connect-timeout 3 --max-time 5 -H 'Accept: application/vnd.github.sha' \
        "https://api.github.com/repos/$repo/commits/$LATEST_REF" 2>/dev/null) || return 1
    case "$LATEST_COMMIT" in
        ''|*[!0-9a-f]*)
            LATEST_COMMIT=""
            return 1
            ;;
    esac
    LATEST_VERSION=$(curl -fsSL --connect-timeout 3 --max-time 5 "https://raw.githubusercontent.com/$repo/$LATEST_COMMIT/VERSION" 2>/dev/null \
        | head -n 1 | tr -d '[:space:]')
    {
        echo "LATEST_VERSION=${LATEST_VERSION:-unknown}"
        echo "LATEST_REF=$LATEST_REF"
        echo "LATEST_COMMIT=$LATEST_COMMIT"
        echo "CHECKED_AT=$(date '+%Y-%m-%d %H:%M')"
    } > "$UPDATE_CACHE" 2>/dev/null
    return 0
}

# 두 커밋 사이의 변경 내역(커밋 제목)을 파일로 씁니다.
write_changes() {
    local base="$1" head="$2" out="$3"

    local py
    py=$(find_python) || return 1
    curl -fsSL --max-time 10 "https://api.github.com/repos/$(update_repo)/compare/$base...$head" 2>/dev/null \
        | PYTHONIOENCODING=utf-8 "$py" -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
commits = data.get("commits", [])
print("변경된 커밋 %d개 (최근 순)" % len(commits))
print()
for commit in reversed(commits[-30:]):
    lines = commit["commit"]["message"].splitlines()
    print("- " + commit.get("sha", "")[:7] + " " + (lines[0] if lines else ""))
' > "$out"
}

# 최신 버전 확인 결과: 1 성공, 0 실패, off 설정에서 꺼짐, 빈 값은 아직 확인 안 함
LATEST_OK=""

run_latest_check() {
    ui_info "최신 버전을 확인하는 중... (최대 5초)\n\n$(update_repo) ($(LATEST_REF='' update_target_text))"
    if check_latest; then
        LATEST_OK=1
    else
        LATEST_OK=0
    fi
}

current_text() {
    local commit
    commit=$(current_commit)
    printf '%s%s' "$(version_text "$(current_version)")" "${commit:+ (${commit:0:7})}"
}

# 메인 메뉴와 업데이트 메뉴에 보여줄 "최신 버전" 한 줄. 네트워크는 쓰지 않고 확인해 둔 결과만 씁니다.
latest_status() {
    local current cached

    current=$(current_commit)
    case "$LATEST_OK" in
        1)
            if [ -n "$current" ] && [ "$current" = "$LATEST_COMMIT" ]; then
                printf '최신: %s (%s) - 최신 버전 사용 중' "$(version_text "$LATEST_VERSION")" "$(update_target_text)"
            elif [ -n "$current" ] && [ "$(update_channel)" = release ] && ! update_available; then
                printf '최신: %s (%s) - 최신 릴리스와 같거나 더 새 버전 사용 중' "$(version_text "$LATEST_VERSION")" "$(update_target_text)"
            elif [ -z "$current" ]; then
                printf '최신: %s (%s) - 현재 설치본의 커밋 정보가 없어 비교 불가' "$(version_text "$LATEST_VERSION")" "${LATEST_COMMIT:0:7}"
            else
                printf '▲ 업데이트 가능: %s (%s, %s) - 메뉴의 "업데이트"에서 설치' "$(version_text "$LATEST_VERSION")" "$(update_target_text)" "${LATEST_COMMIT:0:7}"
            fi
            ;;
        off)
            printf '최신: 시작할 때 확인하지 않음 (설정 KDUMP_TOOLS_UPDATE_CHECK)'
            ;;
        *)
            cached=$(info_get LATEST_COMMIT "$UPDATE_CACHE")
            if [ -n "$cached" ]; then
                printf '최신: %s (%s, %s 확인) - 지금은 GitHub 접속 실패' \
                    "$(version_text "$(info_get LATEST_VERSION "$UPDATE_CACHE")")" "${cached:0:7}" "$(info_get CHECKED_AT "$UPDATE_CACHE")"
            else
                printf '최신: 확인 실패 (GitHub 접속 불가)'
            fi
            ;;
    esac
}

update_available() {
    local current version
    current=$(current_commit)
    [ "$LATEST_OK" = "1" ] && [ -n "$current" ] && [ "$current" != "$LATEST_COMMIT" ] || return 1
    # 릴리스 기준에서는 main 등으로 더 새 버전을 설치한 경우 업데이트로 보지 않습니다.
    if [ "$(update_channel)" = release ]; then
        version=$(current_version)
        [ "$version" = unknown ] || version_gt "$LATEST_VERSION" "$version"
    fi
}

can_update() {
    if [ "$(id -u)" -ne 0 ]; then
        ui_msg "업데이트는 root로 실행해야 합니다. (sudo analyze-kdump-ui)"
        return 1
    fi
    if [ ! -f "$INSTALL_INFO" ]; then
        ui_msg "install.sh로 설치한 경우에만 메뉴에서 업데이트할 수 있습니다.\n\n현재 실행 위치: $INSTALL_DIR\n\n저장소에서 직접 실행 중이라면 git pull 후 sudo ./install.sh를 실행하세요."
        return 1
    fi
}

# 새 원본의 install.sh로 같은 위치에 다시 설치합니다. 설정·서버 목록·로그·vmlinux는 install.sh가 보존합니다.
run_install() {
    local src="$1" commit="$2" label="$3" bin_dir
    local -a args=(--prefix "$INSTALL_DIR")

    bin_dir=$(info_get BIN_DIR "$INSTALL_INFO")
    [ -n "$bin_dir" ] && args+=(--bin-dir "$bin_dir")
    # 이전 버전의 install.sh는 --commit/--source를 모릅니다.
    if grep -q -- '--commit)' "$src/install.sh"; then
        [ -n "$commit" ] && args+=(--commit "$commit")
        args+=(--source "$label")
    fi
    bash "$src/install.sh" "${args[@]}"
}

finish_update() {
    local status="$1"

    pause
    # install.sh는 일부 명령 등록을 건너뛰면 2를 반환하지만 설치 자체는 끝난 상태입니다.
    if [ "$status" -eq 0 ] || [ "$status" -eq 2 ]; then
        if ui_yesno "업데이트를 마쳤습니다: v$(current_version)\n\n새 버전으로 메뉴를 다시 시작할까요?"; then
            exec "$INSTALL_DIR/bin/analyze-kdump-ui"
        fi
    else
        ui_msg "업데이트에 실패했습니다 (종료 코드 $status).\n화면에 나온 오류를 확인해 주세요. 기존 설치는 그대로입니다."
    fi
}

update_from_github() {
    local repo ref kind tmp commit status

    can_update || return
    repo=$(update_repo)
    # 메뉴를 확인한 시점의 태그·브랜치를 그대로 설치합니다.
    ref=${LATEST_REF:-$(update_branch)}
    if [ "$(update_channel)" = release ] && [ -n "$LATEST_REF" ]; then kind=tags; else kind=heads; fi
    local warn=""
    if [ "$(current_version)" != unknown ] && version_gt "$(current_version)" "$LATEST_VERSION"; then
        warn="\n\n주의: 현재 설치본이 더 새 버전입니다. 계속하면 이전 버전으로 돌아갑니다."
    fi
    ui_yesno "GitHub($repo, $(update_target_text))에서 받아 설치할까요?\n\n현재: $(current_text)\n설치: $(version_text "$LATEST_VERSION") (${LATEST_COMMIT:0:7})$warn\n\n설정, 접속 서버 목록, 로그, vmlinux는 유지됩니다." || return

    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kdump-tools-update.XXXXXX") || return
    clear
    echo "===== kdump-analyzer 업데이트 ====="
    echo "[1/2] 코드 받는 중: $repo ($(update_target_text))"
    if command -v git >/dev/null 2>&1; then
        git -c advice.detachedHead=false clone -q --depth 1 --branch "$ref" "https://github.com/$repo.git" "$tmp/src"
        status=$?
    elif command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1; then
        mkdir -p "$tmp/src" &&
            curl -fsSL "https://codeload.github.com/$repo/tar.gz/refs/$kind/$ref" | tar xz -C "$tmp/src" --strip-components=1
        status=$?
    else
        echo "git 또는 curl과 tar가 필요합니다."
        status=1
    fi

    if [ "$status" -eq 0 ] && [ -f "$tmp/src/install.sh" ]; then
        commit=$(git -c safe.directory="$tmp/src" -C "$tmp/src" rev-parse HEAD 2>/dev/null || printf '%s' "$LATEST_COMMIT")
        echo "[2/2] 설치 중: $(version_text "$(head -n 1 "$tmp/src/VERSION" 2>/dev/null | tr -d '[:space:]')") (${commit:0:7})"
        echo
        run_install "$tmp/src" "$commit" "github:$repo@$ref"
        status=$?
    else
        echo "최신 코드를 받지 못했습니다."
        [ "$status" -eq 0 ] && status=1
    fi
    case "$tmp" in
        */kdump-tools-update.*) rm -rf "$tmp" ;;
    esac
    finish_update "$status"
}

# 인터넷이 막힌 서버용: 다른 곳에서 받아 서버에 복사해 둔 저장소 디렉터리로 업데이트합니다.
update_from_dir() {
    local dir version

    can_update || return
    dir=$(ui_input "업데이트할 kdump-analyzer 디렉터리 (install.sh가 있는 위치):" "/tmp/kdump-analyzer") || return
    if [ ! -f "$dir/install.sh" ] || [ ! -f "$dir/bin/analyze-kdump" ]; then
        ui_msg "kdump-analyzer 디렉터리가 아닙니다: $dir\n(install.sh와 bin/analyze-kdump가 있어야 합니다)"
        return
    fi
    dir=$(cd "$dir" && pwd)
    version=$(head -n 1 "$dir/VERSION" 2>/dev/null | tr -d '[:space:]')
    ui_yesno "다음 디렉터리에서 설치할까요?\n\n$dir\n현재: $(version_text "$(current_version)") → 설치: $(version_text "$version")\n\n설정, 접속 서버 목록, 로그, vmlinux는 유지됩니다." || return

    clear
    echo "===== kdump-analyzer 업데이트 ====="
    echo "설치 중: $dir ($(version_text "$version"))"
    echo
    run_install "$dir" "" "$dir"
    finish_update "$?"
}

# 1.19.0까지의 기본 위치(/opt/kdump-tools)에 설치돼 있으면 새 기본 위치로 옮길 수 있습니다.
MOVE_TARGET="/opt/kdump-analyzer"

can_move_install() {
    [ "$INSTALL_DIR" = /opt/kdump-tools ] && [ ! -L /opt/kdump-tools ] && [ -f "$INSTALL_INFO" ] \
        && grep -q -- '--move-to)' "$INSTALL_DIR/install.sh" 2>/dev/null
}

# 설정·접속 서버 목록·API 키·vmlinux·리포트를 통째로 새 위치로 옮기고, 새 위치에서 메뉴를 다시 시작합니다.
move_install() {
    local status

    can_update || return
    ui_yesno "설치 위치를 옮길까요?\n\n$INSTALL_DIR → $MOVE_TARGET\n\n설정, 접속 서버 목록, API 키, vmlinux, 리포트를 통째로 옮기고 설정 파일 안의 경로를 고칩니다.\n예전 경로에는 새 위치를 가리키는 링크를 남겨, 다른 곳에 저장된 예전 경로도 계속 동작합니다.\n\n같은 파일 시스템이면 바로 끝나고, 다르면 복사하므로 공간을 먼저 확인합니다." || return

    clear
    echo "===== 설치 위치 옮기기 ====="
    bash "$INSTALL_DIR/install.sh" --prefix "$INSTALL_DIR" --move-to "$MOVE_TARGET"
    status=$?
    pause
    if [ "$status" -eq 0 ] || [ "$status" -eq 2 ]; then
        ui_msg "옮겼습니다: $MOVE_TARGET\n\n새 위치에서 메뉴를 다시 시작합니다."
        exec "$MOVE_TARGET/bin/analyze-kdump-ui"
    fi
    ui_msg "옮기지 못했습니다 (종료 코드 $status).\n화면에 나온 오류를 확인해 주세요. 옮기기 전에 멈췄다면 기존 설치는 그대로입니다."
}

# 버전 정보는 메인 메뉴에 이미 보이므로 여기서는 업데이트 방법만 고릅니다.
# 시작할 때 확인한 결과를 쓰고, 확인하지 못했을 때만 다시 확인합니다.
menu_update() {
    local installed choice changes note
    local -a items

    [ "$LATEST_OK" = "1" ] || run_latest_check
    installed=$(info_get INSTALLED_AT "$INSTALL_INFO")

    while true; do
        items=()
        if update_available; then
            items+=(changes "변경 내역 보기")
        fi
        if [ "$LATEST_OK" = "1" ]; then
            if update_available; then
                items+=(github "GitHub에서 업데이트 ($(update_repo), $(update_target_text))")
            else
                items+=(github "GitHub에서 다시 설치 ($(update_repo), $(update_target_text))")
            fi
            note=""
        else
            note="\n\nGitHub에 접속하지 못했습니다(인터넷 차단 또는 curl 없음).\n폐쇄망이라면 저장소를 서버에 복사한 뒤 '디렉터리에서 업데이트'를 사용하세요."
        fi
        items+=(local "서버의 디렉터리에서 업데이트 (폐쇄망)")
        if can_move_install; then
            items+=(move "설치 위치 옮기기 ($INSTALL_DIR → $MOVE_TARGET)")
        fi
        items+=(recheck "최신 버전 다시 확인" \
            "$BACK" "$BACK_LABEL")

        choice=$(ui_menu "현재: $(current_text)${installed:+, 설치 $installed}\n$(latest_status)$note" "${items[@]}") || return
        case "$choice" in
            recheck)
                run_latest_check
                ;;
            changes)
                changes=$(mktemp "${TMPDIR:-/tmp}/kdump-changes.XXXXXX")
                if write_changes "$(current_commit)" "$LATEST_COMMIT" "$changes"; then
                    view_file "$changes"
                else
                    ui_msg "변경 내역을 가져오지 못했습니다."
                fi
                rm -f "$changes"
                ;;
            github)
                update_from_github
                return
                ;;
            local)
                update_from_dir
                return
                ;;
            move)
                move_install
                return
                ;;
            *)
                return
                ;;
        esac
    done
}

# ---------------------------------------------------------------- 중앙 분석 서버 안내

# 운영 서버의 kdump가 vmcore를 이 서버로 바로 보내게 하는 설정을 이 서버 주소로 채워 보여줍니다.
menu_kdump_guide() {
    local addr crash_dir guide

    addr=$(hostname -I 2>/dev/null | awk '{ print $1 }')
    [ -n "$addr" ] || addr=$(hostname)
    crash_dir=$(server_crash_dir local)
    guide=$(mktemp "${TMPDIR:-/tmp}/kdump-guide.XXXXXX")
    cat > "$guide" <<EOF
중앙 분석 서버 구성: 운영 서버의 vmcore를 패닉 직후 이 서버로 자동 전송
=====================================================================

운영 서버에는 analyze-kdump, crash, vmlinux를 설치하지 않아도 됩니다.
이 서버에 운영 서버 커널 버전별 vmlinux를 모아 두고 '이 서버'에서 분석합니다.

[이 서버] 전송 받을 계정과 디렉터리 준비
  useradd -m kdump
  mkdir -p $crash_dir && chown kdump $crash_dir

[운영 서버] /etc/kdump.conf (SSH 전송)
  ssh kdump@$addr
  sshkey /root/.ssh/kdump_id_rsa
  path $crash_dir
  core_collector makedumpfile -F -l --message-level 7 -d 31

  kdumpctl propagate       # SSH 키를 만들고 이 서버에 등록 (kdump 계정 비밀번호 입력)
  systemctl restart kdump
  kdumpctl status          # "Kdump is operational" 확인

[운영 서버] /etc/kdump.conf (NFS 전송을 쓸 경우)
  nfs <NFS 서버>:/export/crash
  path /
  (NFS 공유를 이 서버의 $crash_dir 에 마운트해 두면 바로 목록에 보입니다)

[운영 서버가 Ubuntu·Debian일 때] /etc/default/kdump-tools (SSH 전송)
  SSH="kdump@$addr"
  SSH_KDUMP_KEY=/root/.ssh/kdump_id_rsa
  KDUMP_COREDIR="$crash_dir"

  kdump-config propagate   # SSH 키를 이 서버에 등록
  systemctl restart kdump-tools
  kdump-config show        # "ready to kdump" 확인

저장 위치
  $crash_dir/<운영 서버 IP>-<시각>/vmcore             (RHEL 계열)
  $crash_dir/<YYYYMMDDHHMM>/dump.<YYYYMMDDHHMM>      (Ubuntu·Debian, 로컬 저장 시)
  SSH 전송은 makedumpfile의 flattened 형식(vmcore.flat)으로 저장됩니다.
  crash 9.0.1 등 최근 crash는 그대로 분석하고, 읽지 못하는 crash면 같은 디렉터리의 vmcore로
  자동 변환합니다(설정 FLAT_CONVERT, 덤프 크기만큼 공간 필요).

분석
  메뉴의 '접속 서버 선택'에서 '이 서버'를 고르고 'vmcore 분석'을 실행합니다.
  운영 서버 커널 버전의 vmlinux가 이 서버에 필요합니다.
  ($(conf_get VMLINUX_BASE "$TOOL_BASE/vmlinux")/<커널 버전>/vmlinux 또는 debuginfo 설치)
EOF
    view_file "$guide"
    rm -f "$guide"
}

# ---------------------------------------------------------------- 메인

main_menu() {
    local choice

    while true; do
        choice=$(UI_CANCEL="종료" ui_menu "현재 서버: $(server_label "$CURRENT_SERVER")\n버전: $(current_text)\n$(latest_status)" \
            analyze "vmcore 분석" \
            results "분석 결과 보기" \
            server "접속 서버 선택" \
            servers "접속 서버 관리" \
            settings "설정" \
            guide "kdump 원격 전송 안내 (중앙 분석 서버 구성)" \
            update "업데이트" \
            quit "종료") || return 0
        case "$choice" in
            analyze) menu_analyze ;;
            results) menu_results ;;
            server) menu_select_server ;;
            servers) menu_servers ;;
            settings) menu_settings ;;
            guide) menu_kdump_guide ;;
            update) menu_update ;;
            quit) return 0 ;;
        esac
    done
}

main() {
    if ! command -v "$WHIPTAIL" >/dev/null 2>&1; then
        echo "whiptail이 필요합니다. 설치: dnf install -y newt (Debian/Ubuntu: apt-get install -y whiptail)" >&2
        exit 1
    fi
    if [ ! -x "$TOOL" ]; then
        echo "analyze-kdump를 찾을 수 없습니다: $TOOL" >&2
        exit 1
    fi
    # 한글 메뉴가 깨지지 않도록 UTF-8 로캘을 사용합니다.
    case "$(locale charmap 2>/dev/null)" in
        UTF-8) ;;
        *) export LANG=C.UTF-8 LC_ALL=C.UTF-8 ;;
    esac
    # analyze-kdump 출력을 tee로 받아도 진행 표시가 나오도록 합니다.
    export ANALYZE_KDUMP_PROGRESS=1
    TITLE="analyze-kdump $(version_text "$(current_version)")"
    # 메인 메뉴에 최신 버전을 바로 보여주기 위해 시작할 때 한 번 확인합니다.
    case "$(conf_get KDUMP_TOOLS_UPDATE_CHECK 1)" in
        0|false|FALSE|no|NO|off|OFF) LATEST_OK=off ;;
        *) run_latest_check ;;
    esac
    if [ "$(id -u)" -ne 0 ]; then
        ui_msg "root가 아닌 계정으로 실행 중입니다.\n이 서버의 vmcore를 읽거나 설정을 저장하지 못할 수 있습니다."
    fi
    main_menu
    clear 2>/dev/null
    exit 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
