#!/bin/bash
# analyze-kdump 터미널 메뉴 UI
#
# 장애 현장에서 SSH나 콘솔로 접속한 서버에서 메뉴로 vmcore를 분석합니다.
#   - 이 서버(local): 이 서버에서 analyze-kdump를 실행합니다.
#   - 원격 서버: 서버 상태에 맞춰 세 가지 방식 중 하나로 분석합니다.
#       installed  원격에 설치된 analyze-kdump로 리포트 생성
#       upload     스크립트를 원격 임시 디렉터리로 보내 실행 (원격에는 crash와 vmlinux만 필요)
#       fetch      vmcore를 이 서버로 가져와서 분석 (원격에는 SSH 접속만 필요)
#     어느 방식이든 LLM 분석은 이 서버의 설정으로 실행합니다(API 키/구독 로그인을 원격에 둘 필요 없음).
#
# 환경변수:
#   ANALYZE_KDUMP_CONF     설정 파일 (기본 /opt/kdump-tools/analyze-kdump.conf)
#   ANALYZE_KDUMP_SERVERS  접속 서버 목록 파일 (기본 /opt/kdump-tools/servers.conf)
#   ANALYZE_KDUMP_BIN      analyze-kdump 경로 (기본: 이 스크립트와 같은 디렉터리)

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
TOOL="${ANALYZE_KDUMP_BIN:-$SCRIPT_DIR/analyze-kdump}"
CONFIG_FILE="${ANALYZE_KDUMP_CONF:-/opt/kdump-tools/analyze-kdump.conf}"
SERVERS_FILE="${ANALYZE_KDUMP_SERVERS:-/opt/kdump-tools/servers.conf}"
WHIPTAIL="${WHIPTAIL:-whiptail}"
PAGER_CMD="${PAGER_CMD:-less}"
TITLE="analyze-kdump"
CURRENT_SERVER="local"

DEFAULT_REMOTE_TOOL="/opt/kdump-tools/bin/analyze-kdump"
DEFAULT_CRASH_DIR="/var/crash"
# install.sh로 설치했다면 bin/의 상위 디렉터리에 설치 정보(.install-info)가 있습니다.
INSTALL_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
INSTALL_INFO="$INSTALL_DIR/.install-info"
UPDATE_CACHE="$INSTALL_DIR/.update-check"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)

# ---------------------------------------------------------------- 화면 helper

ui_size() {
    local lines cols
    lines=$(tput lines 2>/dev/null || echo 24)
    cols=$(tput cols 2>/dev/null || echo 80)
    UI_H=$((lines - 4))
    UI_W=$((cols - 8))
    [ "$UI_H" -gt 30 ] && UI_H=30
    [ "$UI_W" -gt 100 ] && UI_W=100
    [ "$UI_H" -lt 15 ] && UI_H=15
    [ "$UI_W" -lt 60 ] && UI_W=60
    UI_LIST_H=$((UI_H - 8))
}

# 안내 문구가 화면에서 차지하는 줄 수(긴 줄이 접히는 것 포함). 한글은 wc -L이 두 칸으로 셉니다.
ui_text_lines() {
    local width=$((UI_W - 4)) lines=0 line w

    while IFS= read -r line; do
        w=$(printf '%s' "$line" | wc -L)
        if [ "$w" -eq 0 ]; then
            lines=$((lines + 1))
        else
            lines=$((lines + (w + width - 1) / width))
        fi
    done < <(printf '%b\n' "$1")
    echo "$lines"
}

# 메뉴 상자 높이를 안내 문구 줄 수와 항목 수에 맞춥니다.
# 목록 영역을 고정으로 크게 잡으면 whiptail이 안내 문구를 첫 줄만 남기고 잘라 버립니다.
ui_fit() {
    local text="$1" items="$2" text_lines avail max

    ui_size
    max=$UI_H
    text_lines=$(ui_text_lines "$text")
    avail=$((max - 8 - text_lines))
    UI_LIST_H=$items
    if [ "$UI_LIST_H" -gt "$avail" ]; then
        UI_LIST_H=$avail
    fi
    [ "$UI_LIST_H" -lt 3 ] && UI_LIST_H=3
    UI_H=$((text_lines + UI_LIST_H + 8))
    [ "$UI_H" -gt "$max" ] && UI_H=$max
}

# 목록 맨 끝에 붙이는 "이전 메뉴로" 항목의 태그
BACK="<"
BACK_LABEL="← 이전 메뉴로"
# 취소 버튼 이름. 메인 메뉴에서만 "종료"로 바꿉니다.
UI_CANCEL="뒤로"

# whiptail은 선택 결과를 stderr로 내보내므로 stdout과 바꿔서 캡처합니다.
ui_menu() {
    local text="$1"
    shift
    ui_fit "$text" $(($# / 2))
    "$WHIPTAIL" --title "$TITLE" --ok-button "선택" --cancel-button "$UI_CANCEL" \
        --menu "$text" "$UI_H" "$UI_W" "$UI_LIST_H" "$@" 3>&1 1>&2 2>&3
}

ui_radio() {
    local text="$1\n(스페이스: 고르기, Enter: 확인)"
    shift
    ui_fit "$text" $(($# / 3))
    "$WHIPTAIL" --title "$TITLE" --ok-button "선택" --cancel-button "$UI_CANCEL" \
        --radiolist "$text" "$UI_H" "$UI_W" "$UI_LIST_H" "$@" 3>&1 1>&2 2>&3
}

ui_input() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --ok-button "확인" --cancel-button "$UI_CANCEL" \
        --inputbox "$1" 10 "$UI_W" "$2" 3>&1 1>&2 2>&3
}

ui_yesno() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --yesno "$1" 12 "$UI_W"
}

ui_msg() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --msgbox "$1" "$UI_H" "$UI_W"
}

# 오래 걸리는 확인 작업 동안 띄워 두는 안내 화면입니다(입력을 기다리지 않음).
ui_info() {
    ui_size
    "$WHIPTAIL" --title "$TITLE" --infobox "$1" 8 "$UI_W"
}

# 리포트·분석 보기. less 하단에 나가는 방법을 항상 표시합니다(less는 Esc로 닫히지 않음).
view_file() {
    if [ "$PAGER_CMD" = "less" ] && command -v less >/dev/null 2>&1; then
        less -R -Ps"[q] 이전 화면으로   [↑↓ PgUp PgDn] 이동   [/] 검색   %f" "$1"
    elif command -v "$PAGER_CMD" >/dev/null 2>&1; then
        "$PAGER_CMD" "$1"
    else
        ui_size
        "$WHIPTAIL" --title "$(basename "$1") - Enter/Esc: 이전 화면으로" --scrolltext --textbox "$1" "$UI_H" "$UI_W"
    fi
}

# 진행 바: progress_bar <현재> <전체>
progress_bar() {
    local done="$1" total="$2" width=20 filled
    [ "$total" -gt 0 ] || total=1
    filled=$((done * width / total))
    [ "$filled" -gt "$width" ] && filled=$width
    printf '[%s%s]' "$(printf '%*s' "$filled" '' | tr ' ' '#')" "$(printf '%*s' "$((width - filled))" '' | tr ' ' '.')"
}

pause() {
    echo
    read -r -p "Enter를 누르면 메뉴로 돌아갑니다... " _
}

# ---------------------------------------------------------------- 설정 파일

# analyze-kdump와 같은 기준으로 conf 파일 권한을 확인합니다(셸 스크립트로 실행되기 때문).
config_is_safe() {
    local owner mode

    [ -f "$CONFIG_FILE" ] || return 0
    owner=$(stat -c '%u' "$CONFIG_FILE") || return 1
    mode=$(stat -c '%a' "$CONFIG_FILE") || return 1
    if [ "$owner" != "0" ] && [ "$owner" != "$(id -u)" ]; then
        return 1
    fi
    [ $((8#$mode & 8#022)) -eq 0 ]
}

conf_get() {
    local key="$1" default="${2:-}"

    if [ -f "$CONFIG_FILE" ] && config_is_safe; then
        (
            # shellcheck disable=SC1090
            . "$CONFIG_FILE" >/dev/null 2>&1
            printf '%s' "${!key:-$default}"
        )
    else
        printf '%s' "$default"
    fi
}

# conf 파일의 KEY="VALUE" 줄을 바꾸거나 추가합니다. 값은 큰따옴표 안에 들어가도록 이스케이프합니다.
conf_set() {
    local key="$1" value="$2" escaped tmp

    escaped=$(printf '%s' "$value" | sed -e 's/[\\"$`]/\\&/g')
    mkdir -p "$(dirname "$CONFIG_FILE")" || return 1
    tmp=$(mktemp "$CONFIG_FILE.XXXXXX") || return 1

    if [ -f "$CONFIG_FILE" ]; then
        CONF_LINE="$key=\"$escaped\"" awk -v key="$key" '
            index($0, key "=") == 1 { if (!done) print ENVIRON["CONF_LINE"]; done = 1; next }
            { print }
            END { if (!done) print ENVIRON["CONF_LINE"] }
        ' "$CONFIG_FILE" > "$tmp"
    else
        {
            echo "# analyze-kdump 설정 (analyze-kdump-ui에서 생성)"
            echo "$key=\"$escaped\""
        } > "$tmp"
    fi
    chmod 644 "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

report_dir() {
    conf_get REPORT_DIR /opt/kdump-tools/logs
}

# ---------------------------------------------------------------- 접속 서버

# servers.conf 형식 (한 줄에 서버 하나):
#   이름|접속대상(user@host)|포트|sudo 사용(yes/no)|원격 analyze-kdump 경로|crash 디렉터리
servers_list() {
    [ -f "$SERVERS_FILE" ] || return 0
    grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$SERVERS_FILE"
}

server_line() {
    servers_list | awk -F'|' -v name="$1" '$1 == name { print; exit }'
}

# server_field <이름> <번호>: 1 이름, 2 대상, 3 포트, 4 sudo, 5 툴 경로, 6 crash 디렉터리
server_field() {
    server_line "$1" | cut -d'|' -f"$2"
}

server_label() {
    if [ "$1" = "local" ]; then
        echo "이 서버 ($(hostname))"
    else
        echo "$1 ($(server_field "$1" 2))"
    fi
}

servers_write() {
    local tmp

    mkdir -p "$(dirname "$SERVERS_FILE")" || return 1
    tmp=$(mktemp "$SERVERS_FILE.XXXXXX") || return 1
    {
        echo "# analyze-kdump-ui 접속 서버 목록"
        echo "# 이름|접속대상(user@host)|포트|sudo 사용(yes/no)|원격 analyze-kdump 경로|crash 디렉터리|분석 방식(auto/installed/upload/fetch)"
        cat
    } > "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$SERVERS_FILE"
}

server_save() {
    local name="$1" line="$2"
    { servers_list | awk -F'|' -v name="$name" '$1 != name'; echo "$line"; } | servers_write
}

server_delete() {
    servers_list | awk -F'|' -v name="$1" '$1 != name' | servers_write
}

# 원격 서버에서 명령을 실행합니다. 인자는 printf %q로 감싸 원격 셸에 그대로 전달합니다.
remote_run() {
    local name="$1" target port sudo quoted
    shift
    target=$(server_field "$name" 2)
    port=$(server_field "$name" 3)
    sudo=$(server_field "$name" 4)
    printf -v quoted '%q ' "$@"
    if [ "$sudo" = "yes" ]; then
        quoted="sudo -n $quoted"
    fi
    ssh "${SSH_OPTS[@]}" -p "${port:-22}" "$target" "$quoted"
}

# crash 셸처럼 터미널이 필요한 원격 명령을 실행합니다. sudo 비밀번호를 입력할 수 있습니다.
remote_tty() {
    local name="$1" target port sudo quoted
    shift
    target=$(server_field "$name" 2)
    port=$(server_field "$name" 3)
    sudo=$(server_field "$name" 4)
    printf -v quoted '%q ' "$@"
    if [ "$sudo" = "yes" ]; then
        quoted="sudo $quoted"
    fi
    ssh -t -p "${port:-22}" "$target" "$quoted"
}

server_method() {
    local method
    method=$(server_field "$1" 7)
    printf '%s' "${method:-auto}"
}

method_label() {
    case "$1" in
        auto) echo "자동 선택" ;;
        installed) echo "원격 설치본 실행" ;;
        upload) echo "무설치 실행 (스크립트를 임시로 보내 실행)" ;;
        fetch) echo "vmcore 가져와서 이 서버에서 분석" ;;
    esac
}

# 원격 서버 상태를 보고 분석 방식을 고릅니다: 설치본 > 무설치(crash 있음) > vmcore 가져오기
probe_method() {
    local out
    out=$(remote_run "$1" sh -c '
        if [ -x "$1" ]; then echo installed
        elif command -v crash >/dev/null 2>&1; then echo upload
        else echo fetch
        fi' sh "$(remote_tool "$1")" 2>/dev/null)
    case "$out" in
        installed|upload|fetch) printf '%s' "$out" ;;
        *) return 1 ;;
    esac
}

# 이 서버의 analyze-kdump를 원격 임시 디렉터리로 보냅니다. 출력: 원격 임시 디렉터리
upload_tool() {
    local dir
    dir=$(remote_run "$1" mktemp -d /tmp/kdump-tools.XXXXXX) || return 1
    case "$dir" in
        /tmp/kdump-tools.*) ;;
        *) return 1 ;;
    esac
    remote_run "$1" sh -c 'cat > "$1/analyze-kdump" && chmod 700 "$1/analyze-kdump"' sh "$dir" < "$TOOL" || return 1
    printf '%s' "$dir"
}

cleanup_upload() {
    case "$2" in
        /tmp/kdump-tools.*) remote_run "$1" rm -rf "$2" ;;
    esac
}

remote_tool() {
    local tool
    tool=$(server_field "$1" 5)
    printf '%s' "${tool:-$DEFAULT_REMOTE_TOOL}"
}

server_crash_dir() {
    local dir
    if [ "$1" = "local" ]; then
        dir=$(conf_get DEFAULT_VMCORE "")
        [ -d "$dir" ] || dir="$DEFAULT_CRASH_DIR"
    else
        dir=$(server_field "$1" 6)
    fi
    printf '%s' "${dir:-$DEFAULT_CRASH_DIR}"
}

# 원격 서버에서 받은 리포트와 그 분석 결과는 REPORT_DIR/remote/<서버 이름>에 모읍니다.
server_result_dir() {
    if [ "$1" = "local" ]; then
        report_dir
    else
        printf '%s/remote/%s' "$(report_dir)" "$1"
    fi
}

# ---------------------------------------------------------------- vmcore 분석

# 출력: "<mtime> <size> <경로>" (최근 순)
list_vmcores() {
    local dir
    dir=$(server_crash_dir "$1")
    if [ "$1" = "local" ]; then
        stat -c '%Y %s %n' "$dir"/*/vmcore 2>/dev/null | sort -rn
    else
        remote_run "$1" sh -c 'stat -c "%Y %s %n" "$1"/*/vmcore 2>/dev/null | sort -rn' sh "$dir"
    fi
}

human_size() {
    awk -v b="$1" 'BEGIN {
        split("B KB MB GB TB", u); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i]
    }'
}

choose_vmcore() {
    local server="$1" listing line mtime size path i=0 choice
    local -a items paths

    [ "$server" = "local" ] || ui_info "원격 서버에서 vmcore 목록을 읽는 중...\n\n$(server_label "$server")"
    listing=$(list_vmcores "$server")
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        mtime=${line%% *}
        line=${line#* }
        size=${line%% *}
        path=${line#* }
        i=$((i + 1))
        paths[$i]="$path"
        items+=("$i" "$(date -d "@$mtime" '+%Y-%m-%d %H:%M') $(human_size "$size")  $path")
    done <<< "$listing"
    items+=("p" "경로 직접 입력" "$BACK" "$BACK_LABEL")

    choice=$(ui_menu "분석할 vmcore를 선택하세요. ($(server_label "$server"): $(server_crash_dir "$server"))" "${items[@]}") || return 1
    [ "$choice" = "$BACK" ] && return 1
    if [ "$choice" = "p" ]; then
        ui_input "vmcore 파일 또는 crash 디렉터리 경로:" "$(server_crash_dir "$server")"
        return
    fi
    printf '%s' "${paths[$choice]}"
}

# analyze-kdump 출력에서 "report:"/"analysis:" 경로를 읽습니다.
output_path() {
    sed -n "s/^$1:[[:space:]]*//p" "$2" | tail -n 1
}

exit_code_text() {
    case "$1" in
        0) echo "정상" ;;
        1) echo "입력/환경 오류" ;;
        2) echo "crash 실행 실패 (리포트 끝의 crash 실행 로그 확인)" ;;
        3) echo "LLM 분석 실패 (분석 파일에 사유 기록)" ;;
        255) echo "SSH 접속 실패" ;;
        *) echo "알 수 없는 오류" ;;
    esac
}

run_logged() {
    local log="$1"
    shift
    set -o pipefail
    "$@" 2>&1 | tee "$log"
    local status=$?
    set +o pipefail
    return "$status"
}

# 넷째 인자로 리포트 저장 디렉터리를 주면 설정의 REPORT_DIR 대신 씁니다(가져온 vmcore를 서버별로 모을 때).
analyze_local() {
    local vmcore="$1" mode="$2" log="$3" report_dir="${4:-}"
    local -a tool=("$TOOL")

    if [ -n "$report_dir" ]; then
        tool=(env "REPORT_DIR=$report_dir" "$TOOL")
    fi
    case "$mode" in
        shell)
            "${tool[@]}" "$vmcore"
            ;;
        report)
            run_logged "$log" "${tool[@]}" -r "$vmcore"
            ;;
        llm)
            run_logged "$log" "${tool[@]}" -llm "$vmcore"
            ;;
    esac
}

# 원격 서버에서 리포트를 만들고(뒤의 인자가 원격 명령) 가져온 뒤, 필요하면 이 서버에서 LLM 분석을 실행합니다.
remote_report_flow() {
    local server="$1" mode="$2" log="$3"
    local remote_report local_dir local_report status
    shift 3

    echo "[$server] crash 리포트 생성 중..."
    run_logged "$log" remote_run "$server" "$@"
    status=$?
    remote_report=$(output_path report "$log")
    if [ -z "$remote_report" ]; then
        return "$status"
    fi

    local_dir=$(server_result_dir "$server")
    mkdir -p "$local_dir" || return 1
    local_report="$local_dir/$(basename "$remote_report")"
    echo "[$server] 리포트 가져오는 중: $remote_report"
    if ! remote_run "$server" cat "$remote_report" > "$local_report"; then
        echo "리포트를 가져오지 못했습니다." | tee -a "$log"
        return 255
    fi
    echo "report:  $local_report" | tee -a "$log"
    if [ "$status" -ne 0 ] || [ "$mode" != "llm" ]; then
        return "$status"
    fi

    echo
    echo "[이 서버] LLM 분석 중..."
    run_logged "$log.llm" "$TOOL" --llm-report "$local_report"
    status=$?
    cat "$log.llm" >> "$log"
    return "$status"
}

analyze_remote_installed() {
    local server="$1" vmcore="$2" mode="$3" log="$4" tool

    tool=$(remote_tool "$server")
    if [ "$mode" = "shell" ]; then
        remote_tty "$server" "$tool" "$vmcore"
        return
    fi
    remote_report_flow "$server" "$mode" "$log" env ANALYZE_KDUMP_PROGRESS=1 "$tool" -r "$vmcore"
}

# 원격에 설치하지 않고, 이 서버의 analyze-kdump를 원격 임시 디렉터리로 보내 실행한 뒤 지웁니다.
# 원격 설정 파일은 읽지 않고 리포트도 임시 디렉터리에 만듭니다.
analyze_remote_upload() {
    local server="$1" vmcore="$2" mode="$3" log="$4" dir status

    echo "[$server] 스크립트를 임시로 보내는 중..."
    if ! dir=$(upload_tool "$server"); then
        echo "원격 임시 디렉터리에 스크립트를 보내지 못했습니다." | tee -a "$log"
        return 255
    fi

    if [ "$mode" = "shell" ]; then
        remote_tty "$server" "$dir/analyze-kdump" "$vmcore"
        status=$?
    else
        remote_report_flow "$server" "$mode" "$log" \
            env ANALYZE_KDUMP_PROGRESS=1 "REPORT_DIR=$dir/logs" "ANALYZE_KDUMP_CONF=$dir/none.conf" "$dir/analyze-kdump" -r "$vmcore"
        status=$?
    fi
    cleanup_upload "$server" "$dir"
    echo "[$server] 임시 파일 정리: $dir"
    return "$status"
}

# 원격 파일을 받으면서 받은 크기로 진행 바를 그립니다.
copy_with_progress() {
    local server="$1" src="$2" dest="$3" total="$4" pid status=0 start=$SECONDS current pct

    remote_run "$server" cat "$src" > "$dest" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        current=$(stat -c %s "$dest" 2>/dev/null || echo 0)
        pct=$((current * 100 / (total > 0 ? total : 1)))
        printf '\r\033[K  %s %3d%% %s/%s (%d초)' "$(progress_bar "$current" "$total")" "$pct" \
            "$(human_size "$current")" "$(human_size "$total")" "$((SECONDS - start))"
        sleep 0.5
    done
    wait "$pid" || status=$?
    current=$(stat -c %s "$dest" 2>/dev/null || echo 0)
    printf '\r\033[K  %s %3d%% %s/%s (%d초)\n' "$(progress_bar "$current" "$total")" \
        "$((current * 100 / (total > 0 ? total : 1)))" "$(human_size "$current")" "$(human_size "$total")" "$((SECONDS - start))"
    return "$status"
}

# vmcore를 이 서버의 crash 디렉터리(<서버 이름>-<원래 디렉터리 이름>/)로 가져와 이 서버에서 분석합니다.
# 이미 같은 크기로 가져온 vmcore가 있으면 다시 받지 않습니다.
analyze_remote_fetch() {
    local server="$1" vmcore="$2" mode="$3" log="$4"
    local local_crash dest_dir dest size free dmesg

    local_crash=$(server_crash_dir local)
    dest_dir="$local_crash/$server-$(basename "$(dirname "$vmcore")")"
    dest="$dest_dir/vmcore"

    size=$(remote_run "$server" stat -c %s "$vmcore") || {
        echo "원격 vmcore 정보를 읽지 못했습니다: $vmcore" | tee -a "$log"
        return 255
    }

    if [ -f "$dest" ] && [ "$(stat -c %s "$dest")" = "$size" ]; then
        echo "[$server] 이미 가져온 vmcore를 사용합니다: $dest"
    else
        mkdir -p "$dest_dir" || return 1
        free=$(df -PB1 "$dest_dir" | awk 'NR == 2 { print $4 }')
        if [ -n "$free" ] && [ "$size" -gt "$free" ]; then
            echo "디스크 공간이 부족합니다: 필요 $(human_size "$size"), 남은 공간 $(human_size "$free") ($dest_dir)" | tee -a "$log"
            return 1
        fi
        echo "[$server] vmcore 가져오는 중: $vmcore ($(human_size "$size"))"
        copy_with_progress "$server" "$vmcore" "$dest.part" "$size"
        if [ "$?" -ne 0 ] || [ "$(stat -c %s "$dest.part" 2>/dev/null)" != "$size" ]; then
            echo "vmcore를 가져오지 못했습니다." | tee -a "$log"
            rm -f "$dest.part"
            return 255
        fi
        mv "$dest.part" "$dest"
        chmod 600 "$dest"
        dmesg="$(dirname "$vmcore")/vmcore-dmesg.txt"
        remote_run "$server" cat "$dmesg" > "$dest_dir/vmcore-dmesg.txt" 2>/dev/null || rm -f "$dest_dir/vmcore-dmesg.txt"
        echo "[$server] 가져오기 완료: $dest"
    fi

    echo
    echo "[이 서버] 분석 시작"
    analyze_local "$dest" "$mode" "$log" "$(server_result_dir "$server")"
}

analyze_remote() {
    local server="$1" vmcore="$2" mode="$3" log="$4" method="$5" status

    case "$method" in
        installed)
            analyze_remote_installed "$server" "$vmcore" "$mode" "$log"
            ;;
        upload)
            analyze_remote_upload "$server" "$vmcore" "$mode" "$log"
            status=$?
            # 원격에 vmlinux가 없으면 vmcore를 가져와 이 서버에서 분석하도록 제안합니다.
            if [ "$status" -eq 1 ] && grep -q "vmlinux가 없습니다" "$log" && [ "$mode" != "shell" ]; then
                if ui_yesno "원격 서버에 이 커널의 vmlinux(디버그 심볼)가 없습니다.\n\nvmcore를 이 서버로 가져와서 분석할까요?\n(이 서버에 해당 커널의 vmlinux가 있어야 합니다)"; then
                    clear
                    analyze_remote_fetch "$server" "$vmcore" "$mode" "$log"
                    return
                fi
            fi
            return "$status"
            ;;
        fetch)
            analyze_remote_fetch "$server" "$vmcore" "$mode" "$log"
            ;;
    esac
}

# 원격 서버의 분석 방식을 고릅니다. 서버 설정이 auto이면 원격 상태를 확인해 기본 선택을 정합니다.
choose_method() {
    local server="$1" method detected note m
    local -a items=()

    method=$(server_method "$server")
    if [ "$method" = "auto" ]; then
        ui_info "원격 서버 상태를 확인하는 중...\n\n$(server_label "$server")"
        if detected=$(probe_method "$server"); then
            method="$detected"
            note="자동 감지 결과: $(method_label "$detected")"
        else
            ui_msg "원격 서버에 접속하지 못했습니다: $(server_label "$server")"
            return 1
        fi
    else
        note="서버 설정: $(method_label "$method")"
    fi

    for m in installed upload fetch; do
        items+=("$m" "$(method_label "$m")" "$([ "$m" = "$method" ] && echo ON || echo OFF)")
    done
    ui_radio "분석 방식을 고르세요. ($note)\n\n- 원격 설치본: 원격에 analyze-kdump, crash, vmlinux 필요\n- 무설치 실행: 원격에 crash, vmlinux 필요\n- vmcore 가져오기: 원격에는 SSH만 필요, 이 서버에 vmlinux 필요" "${items[@]}"
}

menu_analyze() {
    local vmcore mode log status report analysis choice method=""

    vmcore=$(choose_vmcore "$CURRENT_SERVER") || return
    [ -n "$vmcore" ] || return

    mode=$(ui_menu "분석 방법을 선택하세요.\n\n$vmcore" \
        report "리포트 생성" \
        llm "리포트 생성 + LLM 원인 분석" \
        shell "crash 셸 진입 (직접 분석)" \
        "$BACK" "$BACK_LABEL") || return
    [ "$mode" = "$BACK" ] && return

    if [ "$CURRENT_SERVER" != "local" ]; then
        method=$(choose_method "$CURRENT_SERVER") || return
        [ -n "$method" ] || return
    fi

    log=$(mktemp "${TMPDIR:-/tmp}/analyze-kdump-ui.XXXXXX")
    clear
    echo "===== $(server_label "$CURRENT_SERVER") : $vmcore ($mode${method:+, $(method_label "$method")}) ====="
    echo
    if [ "$CURRENT_SERVER" = "local" ]; then
        analyze_local "$vmcore" "$mode" "$log"
    else
        analyze_remote "$CURRENT_SERVER" "$vmcore" "$mode" "$log" "$method"
    fi
    status=$?

    if [ "$mode" = "shell" ]; then
        rm -f "$log" "$log.llm"
        return
    fi
    pause

    report=$(output_path report "$log")
    analysis=$(output_path analysis "$log")
    rm -f "$log" "$log.llm"

    while true; do
        local -a items=()
        [ -n "$analysis" ] && [ -f "$analysis" ] && items+=(analysis "LLM 분석 보기")
        [ -n "$report" ] && [ -f "$report" ] && items+=(report "리포트 보기")
        items+=(back "$BACK_LABEL")
        choice=$(ui_menu "결과: $(exit_code_text "$status") (종료 코드 $status)\n\n리포트: ${report:-없음}\n분석: ${analysis:-없음}" "${items[@]}") || return
        case "$choice" in
            analysis) view_file "$analysis" ;;
            report) view_file "$report" ;;
            *) return ;;
        esac
    done
}

# ---------------------------------------------------------------- 결과 보기

menu_results() {
    local dir report_prefix analysis_prefix choice file i action
    local -a items files

    dir=$(server_result_dir "$CURRENT_SERVER")
    report_prefix=$(conf_get REPORT_PREFIX kdump-report)
    analysis_prefix=$(conf_get ANALYSIS_PREFIX kdump-analysis)

    while true; do
        items=()
        files=()
        i=0
        while IFS= read -r file; do
            [ -n "$file" ] || continue
            i=$((i + 1))
            files[$i]="$file"
            case "$(basename "$file")" in
                "$analysis_prefix"-*) items+=("$i" "[분석]   $(basename "$file")") ;;
                *) items+=("$i" "[리포트] $(basename "$file")") ;;
            esac
        done < <(ls -1t "$dir/$report_prefix"-*.txt "$dir/$analysis_prefix"-*.txt 2>/dev/null)

        if [ "$i" -eq 0 ]; then
            ui_msg "결과 파일이 없습니다.\n\n$dir"
            return
        fi

        items+=("$BACK" "$BACK_LABEL")
        choice=$(ui_menu "분석 결과 ($(server_label "$CURRENT_SERVER"))\n$dir\n\n파일을 고르면 내용을 보여줍니다. 보기 화면에서는 q로 돌아옵니다." "${items[@]}") || return
        [ "$choice" = "$BACK" ] && return
        file="${files[$choice]}"

        case "$(basename "$file")" in
            "$analysis_prefix"-*)
                view_file "$file"
                ;;
            *)
                action=$(ui_menu "$(basename "$file")" \
                    view "리포트 보기" \
                    llm "이 리포트를 LLM으로 (다시) 분석" \
                    "$BACK" "$BACK_LABEL") || continue
                [ "$action" = "$BACK" ] && continue
                if [ "$action" = "view" ]; then
                    view_file "$file"
                else
                    clear
                    "$TOOL" --llm-report "$file"
                    pause
                fi
                ;;
        esac
    done
}

# ---------------------------------------------------------------- 서버 선택/관리

menu_select_server() {
    local name choice
    local -a items=(local "$(server_label local)" "$([ "$CURRENT_SERVER" = local ] && echo ON || echo OFF)")

    while IFS='|' read -r name _; do
        [ -n "$name" ] || continue
        items+=("$name" "$(server_label "$name")" "$([ "$CURRENT_SERVER" = "$name" ] && echo ON || echo OFF)")
    done < <(servers_list)

    choice=$(ui_radio "분석할 서버를 선택하세요." "${items[@]}") || return
    [ -n "$choice" ] && CURRENT_SERVER="$choice"
}

valid_field() {
    case "$1" in
        *'|'*|'') return 1 ;;
        *) return 0 ;;
    esac
}

edit_server() {
    local name="$1" target port sudo tool crash_dir method current m
    local -a method_items=()

    if [ -z "$name" ]; then
        name=$(ui_input "서버 이름 (영문, 숫자, . _ -):" "") || return
        case "$name" in
            ''|local|*[!A-Za-z0-9._-]*)
                ui_msg "사용할 수 없는 이름입니다: $name"
                return
                ;;
        esac
        if [ -n "$(server_line "$name")" ]; then
            ui_msg "이미 등록된 이름입니다: $name"
            return
        fi
    fi

    target=$(ui_input "접속 대상 (user@host):" "$(server_field "$name" 2)") || return
    port=$(ui_input "SSH 포트:" "$(server_field "$name" 3 | grep . || echo 22)") || return
    tool=$(ui_input "원격 서버의 analyze-kdump 경로:" "$(server_field "$name" 5 | grep . || echo "$DEFAULT_REMOTE_TOOL")") || return
    crash_dir=$(ui_input "원격 서버의 crash 디렉터리:" "$(server_field "$name" 6 | grep . || echo "$DEFAULT_CRASH_DIR")") || return
    if ui_yesno "원격 명령을 sudo로 실행할까요?\n\nroot가 아닌 계정으로 접속한다면 '예'를 선택하세요.\n(리포트 생성에는 비밀번호 없는 sudo(NOPASSWD)가 필요합니다)"; then
        sudo=yes
    else
        sudo=no
    fi

    current=$(server_method "$name")
    for m in auto installed upload fetch; do
        method_items+=("$m" "$(method_label "$m")" "$([ "$m" = "$current" ] && echo ON || echo OFF)")
    done
    method=$(ui_radio "기본 분석 방식을 고르세요. (분석할 때마다 바꿀 수 있습니다)\n\n자동 선택: 원격 설치본 → 무설치 실행(crash 있음) → vmcore 가져오기 순으로 고릅니다." "${method_items[@]}") || return
    [ -n "$method" ] || method=auto

    for f in "$target" "$port" "$tool" "$crash_dir"; do
        if ! valid_field "$f"; then
            ui_msg "빈 값이나 '|' 문자는 사용할 수 없습니다."
            return
        fi
    done
    case "$port" in
        *[!0-9]*)
            ui_msg "포트는 숫자여야 합니다: $port"
            return
            ;;
    esac

    if server_save "$name" "$name|$target|$port|$sudo|$tool|$crash_dir|$method"; then
        ui_msg "저장했습니다: $name ($target, $(method_label "$method"))"
    else
        ui_msg "저장하지 못했습니다: $SERVERS_FILE"
    fi
}

test_server() {
    local name="$1" tool out status detected

    tool=$(remote_tool "$name")
    ui_info "연결 테스트 중...\n\n$(server_label "$name")"
    out=$(remote_run "$name" sh -c '
        echo "접속: OK ($(hostname), $(id -un))"
        if [ -x "$1" ]; then
            v=$("$1" --version 2>/dev/null | grep "^analyze-kdump " | head -n 1)
            echo "analyze-kdump: OK ($1, ${v:-버전 정보 없음: 이전 버전})"
        else
            echo "analyze-kdump: 없음 ($1)"
        fi
        if command -v crash >/dev/null 2>&1; then echo "crash: OK ($(crash --version 2>/dev/null | head -n 1))"; else echo "crash: 없음"; fi
        n=$(ls -1 "$2"/*/vmcore 2>/dev/null | wc -l); echo "vmcore: ${n}개 ($2)"
    ' sh "$tool" "$(server_crash_dir "$name")" 2>&1)
    status=$?
    if [ "$status" -ne 0 ] && [ -z "$out" ]; then
        out="접속 실패 (종료 코드 $status)"
    elif detected=$(probe_method "$name"); then
        out="$out\n\n설정된 분석 방식: $(method_label "$(server_method "$name")")\n자동 선택 시: $(method_label "$detected")"
    fi
    ui_msg "연결 테스트: $(server_label "$name")\n\n$out"
}

menu_servers() {
    local choice name action
    local -a items

    while true; do
        items=()
        while IFS='|' read -r name _; do
            [ -n "$name" ] || continue
            items+=("$name" "$(server_label "$name")")
        done < <(servers_list)
        items+=("+" "새 서버 추가" "$BACK" "$BACK_LABEL")

        choice=$(ui_menu "접속 서버 관리\n($SERVERS_FILE)" "${items[@]}") || return
        [ "$choice" = "$BACK" ] && return
        if [ "$choice" = "+" ]; then
            edit_server ""
            continue
        fi

        action=$(ui_menu "$(server_label "$choice")" \
            test "연결 테스트" \
            edit "수정" \
            delete "삭제" \
            "$BACK" "$BACK_LABEL") || continue
        case "$action" in
            test) test_server "$choice" ;;
            edit) edit_server "$choice" ;;
            delete)
                if ui_yesno "$choice 서버를 목록에서 삭제할까요?"; then
                    server_delete "$choice"
                    [ "$CURRENT_SERVER" = "$choice" ] && CURRENT_SERVER="local"
                fi
                ;;
        esac
    done
}

# ---------------------------------------------------------------- 설정

# 키|설명|종류(text/number/provider/bool)
SETTINGS=(
    "VMLINUX_BASE|vmlinux 보관 디렉터리|text"
    "REPORT_DIR|리포트 저장 디렉터리|text"
    "DEFAULT_VMCORE|기본 vmcore 또는 crash 디렉터리|text"
    "LLM_PROVIDER|LLM provider|provider"
    "LLM_MODEL|LLM 모델 (비우면 provider 기본값)|text"
    "LLM_BASE_URL|API 엔드포인트 (비우면 기본값)|text"
    "LLM_API_KEY_FILE|API 키 파일 경로|text"
    "LLM_CLI_PATH|구독 CLI 경로 (claude-code/codex)|text"
    "LLM_CLI_ARGS|구독 CLI 추가 인자|text"
    "LLM_MASK_SENSITIVE|LLM 입력 민감정보 마스킹|bool"
    "LLM_MAX_REPORT_CHARS|LLM 입력 최대 문자 수|number"
    "LLM_MAX_TOKENS|LLM 출력 최대 토큰|number"
    "LLM_TIMEOUT|LLM 호출 제한 시간(초)|number"
    "KDUMP_TOOLS_REPO|업데이트 저장소 (GitHub owner/repo)|text"
    "KDUMP_TOOLS_BRANCH|업데이트 브랜치|text"
    "KDUMP_TOOLS_UPDATE_CHECK|메뉴 시작 시 최신 버전 확인 (폐쇄망은 끄기)|bool"
)

setting_default() {
    case "$1" in
        VMLINUX_BASE) echo /opt/kdump-tools/vmlinux ;;
        REPORT_DIR) echo /opt/kdump-tools/logs ;;
        LLM_PROVIDER) echo openai ;;
        LLM_MASK_SENSITIVE) echo 1 ;;
        LLM_MAX_REPORT_CHARS) echo 60000 ;;
        LLM_MAX_TOKENS) echo 8192 ;;
        LLM_TIMEOUT) echo 120 ;;
        KDUMP_TOOLS_REPO) echo 621dev/kdump-tools ;;
        KDUMP_TOOLS_BRANCH) echo main ;;
        KDUMP_TOOLS_UPDATE_CHECK) echo 1 ;;
    esac
}

edit_setting() {
    local key="$1" desc="$2" kind="$3" current value p

    current=$(conf_get "$key" "$(setting_default "$key")")
    case "$kind" in
        provider)
            local -a items=()
            for p in openai gemini claude claude-code codex; do
                items+=("$p" "$(case $p in
                    openai) echo "OpenAI / 호환 API (API 키)" ;;
                    gemini) echo "Google Gemini (API 키)" ;;
                    claude) echo "Anthropic Claude (API 키)" ;;
                    claude-code) echo "Claude Code CLI (Claude 구독)" ;;
                    codex) echo "Codex CLI (ChatGPT 구독)" ;;
                esac)" "$([ "$p" = "$current" ] && echo ON || echo OFF)")
            done
            value=$(ui_radio "$desc" "${items[@]}") || return
            ;;
        bool)
            if ui_yesno "$desc\n\n현재: $current\n\n켤까요?"; then value=1; else value=0; fi
            ;;
        number)
            value=$(ui_input "$desc (숫자):" "$current") || return
            case "$value" in
                ''|*[!0-9]*)
                    ui_msg "숫자를 입력해 주세요: $value"
                    return
                    ;;
            esac
            ;;
        *)
            value=$(ui_input "$desc:" "$current") || return
            ;;
    esac

    if conf_set "$key" "$value"; then
        ui_msg "저장했습니다.\n\n$key=\"$value\"\n($CONFIG_FILE)"
    else
        ui_msg "저장하지 못했습니다. 쓰기 권한을 확인해 주세요.\n\n$CONFIG_FILE"
    fi
}

menu_settings() {
    local entry key desc kind choice
    local -a items

    if ! config_is_safe; then
        ui_msg "설정 파일 권한이 안전하지 않아 읽지 않습니다.\n소유자가 root 또는 실행 사용자이고 group/other 쓰기 권한이 없어야 합니다.\n\n$CONFIG_FILE"
        return
    fi

    while true; do
        items=()
        for entry in "${SETTINGS[@]}"; do
            IFS='|' read -r key desc kind <<< "$entry"
            items+=("$key" "$desc: $(conf_get "$key" "$(setting_default "$key")")")
        done
        items+=("$BACK" "$BACK_LABEL")
        choice=$(ui_menu "설정 ($CONFIG_FILE)\n이 서버의 분석과, 원격 서버 리포트의 LLM 분석에 적용됩니다.\nAPI 키는 파일로 관리하고 여기서는 경로만 지정합니다." "${items[@]}") || return
        [ "$choice" = "$BACK" ] && return
        for entry in "${SETTINGS[@]}"; do
            IFS='|' read -r key desc kind <<< "$entry"
            if [ "$key" = "$choice" ]; then
                edit_setting "$key" "$desc" "$kind"
            fi
        done
    done
}

# ---------------------------------------------------------------- 버전/업데이트

info_get() {
    sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1
}

# 버전 표시: 값이 없으면 "버전 정보 없음"으로 보여줍니다(VERSION 파일이 없는 이전 버전).
version_text() {
    case "$1" in
        ''|unknown|'?') echo "버전 정보 없음" ;;
        *) echo "v$1" ;;
    esac
}

current_version() {
    local version
    version=$(info_get VERSION "$INSTALL_INFO")
    [ -n "$version" ] || version=$(head -n 1 "$INSTALL_DIR/VERSION" 2>/dev/null | tr -d '[:space:]')
    printf '%s' "${version:-unknown}"
}

current_commit() {
    local commit
    commit=$(info_get COMMIT "$INSTALL_INFO")
    if [ -z "$commit" ] && command -v git >/dev/null 2>&1; then
        commit=$(git -c safe.directory="$INSTALL_DIR" -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null)
    fi
    printf '%s' "$commit"
}

update_repo() {
    conf_get KDUMP_TOOLS_REPO "$(setting_default KDUMP_TOOLS_REPO)"
}

update_branch() {
    conf_get KDUMP_TOOLS_BRANCH "$(setting_default KDUMP_TOOLS_BRANCH)"
}

# GitHub에서 최신 커밋과 그 커밋의 VERSION을 읽어 LATEST_COMMIT/LATEST_VERSION을 채우고 캐시에 남깁니다.
check_latest() {
    local repo branch

    repo=$(update_repo)
    branch=$(update_branch)
    LATEST_COMMIT=""
    LATEST_VERSION=""
    command -v curl >/dev/null 2>&1 || return 1
    # 메뉴 시작 때 실행하므로 인터넷이 막힌 서버에서도 오래 기다리지 않도록 짧게 끊습니다.
    LATEST_COMMIT=$(curl -fsSL --connect-timeout 3 --max-time 5 -H 'Accept: application/vnd.github.sha' \
        "https://api.github.com/repos/$repo/commits/$branch" 2>/dev/null) || return 1
    case "$LATEST_COMMIT" in
        ''|*[!0-9a-f]*)
            LATEST_COMMIT=""
            return 1
            ;;
    esac
    LATEST_VERSION=$(curl -fsSL --connect-timeout 3 --max-time 5 "https://raw.githubusercontent.com/$repo/$LATEST_COMMIT/VERSION" 2>/dev/null \
        | head -n 1 | tr -d '[:space:]')
    {
        echo "LATEST_VERSION=${LATEST_VERSION:-unknown}"
        echo "LATEST_COMMIT=$LATEST_COMMIT"
        echo "CHECKED_AT=$(date '+%Y-%m-%d %H:%M')"
    } > "$UPDATE_CACHE" 2>/dev/null
    return 0
}

# 두 커밋 사이의 변경 내역(커밋 제목)을 파일로 씁니다.
write_changes() {
    local base="$1" head="$2" out="$3"

    command -v python3 >/dev/null 2>&1 || return 1
    curl -fsSL --max-time 10 "https://api.github.com/repos/$(update_repo)/compare/$base...$head" 2>/dev/null \
        | PYTHONIOENCODING=utf-8 python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
commits = data.get("commits", [])
print("변경된 커밋 %d개 (최근 순)" % len(commits))
print()
for commit in reversed(commits[-30:]):
    lines = commit["commit"]["message"].splitlines()
    print("- " + commit.get("sha", "")[:7] + " " + (lines[0] if lines else ""))
' > "$out"
}

# 최신 버전 확인 결과: 1 성공, 0 실패, off 설정에서 꺼짐, 빈 값은 아직 확인 안 함
LATEST_OK=""

run_latest_check() {
    ui_info "최신 버전을 확인하는 중... (최대 5초)\n\n$(update_repo) ($(update_branch))"
    if check_latest; then
        LATEST_OK=1
    else
        LATEST_OK=0
    fi
}

current_text() {
    local commit
    commit=$(current_commit)
    printf '%s%s' "$(version_text "$(current_version)")" "${commit:+ (${commit:0:7})}"
}

# 메인 메뉴와 업데이트 메뉴에 보여줄 "최신 버전" 한 줄. 네트워크는 쓰지 않고 확인해 둔 결과만 씁니다.
latest_status() {
    local current cached

    current=$(current_commit)
    case "$LATEST_OK" in
        1)
            if [ -n "$current" ] && [ "$current" = "$LATEST_COMMIT" ]; then
                printf '최신: %s (%s) - 최신 버전 사용 중' "$(version_text "$LATEST_VERSION")" "${LATEST_COMMIT:0:7}"
            elif [ -z "$current" ]; then
                printf '최신: %s (%s) - 현재 설치본의 커밋 정보가 없어 비교 불가' "$(version_text "$LATEST_VERSION")" "${LATEST_COMMIT:0:7}"
            else
                printf '▲ 업데이트 가능: %s (%s) - 메뉴의 "업데이트"에서 설치' "$(version_text "$LATEST_VERSION")" "${LATEST_COMMIT:0:7}"
            fi
            ;;
        off)
            printf '최신: 시작할 때 확인하지 않음 (설정 KDUMP_TOOLS_UPDATE_CHECK)'
            ;;
        *)
            cached=$(info_get LATEST_COMMIT "$UPDATE_CACHE")
            if [ -n "$cached" ]; then
                printf '최신: %s (%s, %s 확인) - 지금은 GitHub 접속 실패' \
                    "$(version_text "$(info_get LATEST_VERSION "$UPDATE_CACHE")")" "${cached:0:7}" "$(info_get CHECKED_AT "$UPDATE_CACHE")"
            else
                printf '최신: 확인 실패 (GitHub 접속 불가)'
            fi
            ;;
    esac
}

update_available() {
    local current
    current=$(current_commit)
    [ "$LATEST_OK" = "1" ] && [ -n "$current" ] && [ "$current" != "$LATEST_COMMIT" ]
}

can_update() {
    if [ "$(id -u)" -ne 0 ]; then
        ui_msg "업데이트는 root로 실행해야 합니다. (sudo analyze-kdump-ui)"
        return 1
    fi
    if [ ! -f "$INSTALL_INFO" ]; then
        ui_msg "install.sh로 설치한 경우에만 메뉴에서 업데이트할 수 있습니다.\n\n현재 실행 위치: $INSTALL_DIR\n\n저장소에서 직접 실행 중이라면 git pull 후 sudo ./install.sh를 실행하세요."
        return 1
    fi
}

# 새 원본의 install.sh로 같은 위치에 다시 설치합니다. 설정·서버 목록·로그·vmlinux는 install.sh가 보존합니다.
run_install() {
    local src="$1" commit="$2" label="$3" bin_dir
    local -a args=(--prefix "$INSTALL_DIR")

    bin_dir=$(info_get BIN_DIR "$INSTALL_INFO")
    [ -n "$bin_dir" ] && args+=(--bin-dir "$bin_dir")
    # 이전 버전의 install.sh는 --commit/--source를 모릅니다.
    if grep -q -- '--commit)' "$src/install.sh"; then
        [ -n "$commit" ] && args+=(--commit "$commit")
        args+=(--source "$label")
    fi
    bash "$src/install.sh" "${args[@]}"
}

finish_update() {
    local status="$1"

    pause
    # install.sh는 일부 명령 등록을 건너뛰면 2를 반환하지만 설치 자체는 끝난 상태입니다.
    if [ "$status" -eq 0 ] || [ "$status" -eq 2 ]; then
        if ui_yesno "업데이트를 마쳤습니다: v$(current_version)\n\n새 버전으로 메뉴를 다시 시작할까요?"; then
            exec "$INSTALL_DIR/bin/analyze-kdump-ui"
        fi
    else
        ui_msg "업데이트에 실패했습니다 (종료 코드 $status).\n화면에 나온 오류를 확인해 주세요. 기존 설치는 그대로입니다."
    fi
}

update_from_github() {
    local repo branch tmp commit status

    can_update || return
    repo=$(update_repo)
    branch=$(update_branch)
    ui_yesno "GitHub($repo, $branch)에서 최신 버전을 받아 설치할까요?\n\n현재: v$(current_version)\n최신: $(version_text "$LATEST_VERSION") (${LATEST_COMMIT:0:7})\n\n설정, 접속 서버 목록, 로그, vmlinux는 유지됩니다." || return

    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kdump-tools-update.XXXXXX") || return
    clear
    echo "===== kdump-tools 업데이트 ====="
    echo "[1/2] 최신 코드 받는 중: $repo ($branch)"
    if command -v git >/dev/null 2>&1; then
        git clone -q --depth 1 --branch "$branch" "https://github.com/$repo.git" "$tmp/src"
        status=$?
    elif command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1; then
        mkdir -p "$tmp/src" &&
            curl -fsSL "https://codeload.github.com/$repo/tar.gz/refs/heads/$branch" | tar xz -C "$tmp/src" --strip-components=1
        status=$?
    else
        echo "git 또는 curl과 tar가 필요합니다."
        status=1
    fi

    if [ "$status" -eq 0 ] && [ -f "$tmp/src/install.sh" ]; then
        commit=$(git -c safe.directory="$tmp/src" -C "$tmp/src" rev-parse HEAD 2>/dev/null || printf '%s' "$LATEST_COMMIT")
        echo "[2/2] 설치 중: $(version_text "$(head -n 1 "$tmp/src/VERSION" 2>/dev/null | tr -d '[:space:]')") (${commit:0:7})"
        echo
        run_install "$tmp/src" "$commit" "github:$repo@$branch"
        status=$?
    else
        echo "최신 코드를 받지 못했습니다."
        [ "$status" -eq 0 ] && status=1
    fi
    case "$tmp" in
        */kdump-tools-update.*) rm -rf "$tmp" ;;
    esac
    finish_update "$status"
}

# 인터넷이 막힌 서버용: 다른 곳에서 받아 서버에 복사해 둔 저장소 디렉터리로 업데이트합니다.
update_from_dir() {
    local dir version

    can_update || return
    dir=$(ui_input "업데이트할 kdump-tools 디렉터리 (install.sh가 있는 위치):" "/tmp/kdump-tools") || return
    if [ ! -f "$dir/install.sh" ] || [ ! -f "$dir/bin/analyze-kdump" ]; then
        ui_msg "kdump-tools 디렉터리가 아닙니다: $dir\n(install.sh와 bin/analyze-kdump가 있어야 합니다)"
        return
    fi
    dir=$(cd "$dir" && pwd)
    version=$(head -n 1 "$dir/VERSION" 2>/dev/null | tr -d '[:space:]')
    ui_yesno "다음 디렉터리에서 설치할까요?\n\n$dir\n현재: $(version_text "$(current_version)") → 설치: $(version_text "$version")\n\n설정, 접속 서버 목록, 로그, vmlinux는 유지됩니다." || return

    clear
    echo "===== kdump-tools 업데이트 ====="
    echo "설치 중: $dir ($(version_text "$version"))"
    echo
    run_install "$dir" "" "$dir"
    finish_update "$?"
}

# 버전 정보는 메인 메뉴에 이미 보이므로 여기서는 업데이트 방법만 고릅니다.
# 시작할 때 확인한 결과를 쓰고, 확인하지 못했을 때만 다시 확인합니다.
menu_update() {
    local installed choice changes note
    local -a items

    [ "$LATEST_OK" = "1" ] || run_latest_check
    installed=$(info_get INSTALLED_AT "$INSTALL_INFO")

    while true; do
        items=()
        if update_available; then
            items+=(changes "변경 내역 보기")
        fi
        if [ "$LATEST_OK" = "1" ]; then
            items+=(github "GitHub에서 업데이트 ($(update_repo), $(update_branch))")
            note=""
        else
            note="\n\nGitHub에 접속하지 못했습니다(인터넷 차단 또는 curl 없음).\n폐쇄망이라면 저장소를 서버에 복사한 뒤 '디렉터리에서 업데이트'를 사용하세요."
        fi
        items+=(local "서버의 디렉터리에서 업데이트 (폐쇄망)" \
            recheck "최신 버전 다시 확인" \
            "$BACK" "$BACK_LABEL")

        choice=$(ui_menu "현재: $(current_text)${installed:+, 설치 $installed}\n$(latest_status)$note" "${items[@]}") || return
        case "$choice" in
            recheck)
                run_latest_check
                ;;
            changes)
                changes=$(mktemp "${TMPDIR:-/tmp}/kdump-changes.XXXXXX")
                if write_changes "$(current_commit)" "$LATEST_COMMIT" "$changes"; then
                    view_file "$changes"
                else
                    ui_msg "변경 내역을 가져오지 못했습니다."
                fi
                rm -f "$changes"
                ;;
            github)
                update_from_github
                return
                ;;
            local)
                update_from_dir
                return
                ;;
            *)
                return
                ;;
        esac
    done
}

# ---------------------------------------------------------------- 중앙 분석 서버 안내

# 운영 서버의 kdump가 vmcore를 이 서버로 바로 보내게 하는 설정을 이 서버 주소로 채워 보여줍니다.
menu_kdump_guide() {
    local addr crash_dir guide

    addr=$(hostname -I 2>/dev/null | awk '{ print $1 }')
    [ -n "$addr" ] || addr=$(hostname)
    crash_dir=$(server_crash_dir local)
    guide=$(mktemp "${TMPDIR:-/tmp}/kdump-guide.XXXXXX")
    cat > "$guide" <<EOF
중앙 분석 서버 구성: 운영 서버의 vmcore를 패닉 직후 이 서버로 자동 전송
=====================================================================

운영 서버에는 analyze-kdump, crash, vmlinux를 설치하지 않아도 됩니다.
이 서버에 운영 서버 커널 버전별 vmlinux를 모아 두고 '이 서버'에서 분석합니다.

[이 서버] 전송 받을 계정과 디렉터리 준비
  useradd -m kdump
  mkdir -p $crash_dir && chown kdump $crash_dir

[운영 서버] /etc/kdump.conf (SSH 전송)
  ssh kdump@$addr
  sshkey /root/.ssh/kdump_id_rsa
  path $crash_dir
  core_collector makedumpfile -F -l --message-level 7 -d 31

  kdumpctl propagate       # SSH 키를 만들고 이 서버에 등록 (kdump 계정 비밀번호 입력)
  systemctl restart kdump
  kdumpctl status          # "Kdump is operational" 확인

[운영 서버] /etc/kdump.conf (NFS 전송을 쓸 경우)
  nfs <NFS 서버>:/export/crash
  path /
  (NFS 공유를 이 서버의 $crash_dir 에 마운트해 두면 바로 목록에 보입니다)

저장 위치
  $crash_dir/<운영 서버 IP>-<시각>/vmcore
  SSH 전송은 makedumpfile의 flattened 형식(vmcore.flat)으로 저장될 수 있습니다.
  이 경우 다음처럼 변환한 뒤 분석합니다.
    makedumpfile -R $crash_dir/<디렉터리>/vmcore < $crash_dir/<디렉터리>/vmcore.flat

분석
  메뉴의 '접속 서버 선택'에서 '이 서버'를 고르고 'vmcore 분석'을 실행합니다.
  운영 서버 커널 버전의 vmlinux가 이 서버에 필요합니다.
  ($(conf_get VMLINUX_BASE /opt/kdump-tools/vmlinux)/<커널 버전>/vmlinux 또는 debuginfo 설치)
EOF
    view_file "$guide"
    rm -f "$guide"
}

# ---------------------------------------------------------------- 메인

main_menu() {
    local choice

    while true; do
        choice=$(UI_CANCEL="종료" ui_menu "현재 서버: $(server_label "$CURRENT_SERVER")\n버전: $(current_text)\n$(latest_status)" \
            analyze "vmcore 분석" \
            results "분석 결과 보기" \
            server "접속 서버 선택" \
            servers "접속 서버 관리" \
            settings "설정" \
            guide "kdump 원격 전송 안내 (중앙 분석 서버 구성)" \
            update "업데이트" \
            quit "종료") || return 0
        case "$choice" in
            analyze) menu_analyze ;;
            results) menu_results ;;
            server) menu_select_server ;;
            servers) menu_servers ;;
            settings) menu_settings ;;
            guide) menu_kdump_guide ;;
            update) menu_update ;;
            quit) return 0 ;;
        esac
    done
}

main() {
    if ! command -v "$WHIPTAIL" >/dev/null 2>&1; then
        echo "whiptail이 필요합니다. 설치: dnf install -y newt (Debian/Ubuntu: apt-get install -y whiptail)" >&2
        exit 1
    fi
    if [ ! -x "$TOOL" ]; then
        echo "analyze-kdump를 찾을 수 없습니다: $TOOL" >&2
        exit 1
    fi
    # 한글 메뉴가 깨지지 않도록 UTF-8 로캘을 사용합니다.
    case "$(locale charmap 2>/dev/null)" in
        UTF-8) ;;
        *) export LANG=C.UTF-8 LC_ALL=C.UTF-8 ;;
    esac
    # analyze-kdump 출력을 tee로 받아도 진행 표시가 나오도록 합니다.
    export ANALYZE_KDUMP_PROGRESS=1
    TITLE="analyze-kdump $(version_text "$(current_version)")"
    # 메인 메뉴에 최신 버전을 바로 보여주기 위해 시작할 때 한 번 확인합니다.
    case "$(conf_get KDUMP_TOOLS_UPDATE_CHECK 1)" in
        0|false|FALSE|no|NO|off|OFF) LATEST_OK=off ;;
        *) run_latest_check ;;
    esac
    if [ "$(id -u)" -ne 0 ]; then
        ui_msg "root가 아닌 계정으로 실행 중입니다.\n이 서버의 vmcore를 읽거나 설정을 저장하지 못할 수 있습니다."
    fi
    main_menu
    clear 2>/dev/null
    exit 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
