#!/bin/bash
set -e

# 종료 코드
#   0: 정상
#   1: 사용법/환경/입력 오류
#   2: crash 리포트 생성 실패
#   3: 리포트는 생성했지만 LLM 분석 실패

# 기본 경로의 기준: install.sh로 설치한 위치(bin/의 상위에 .install-info가 있음)면 그 위치,
# 아니면 /opt/kdump-tools입니다. 무설치 실행(/tmp로 보낸 스크립트)이나 저장소에서 바로 실행할 때도
# 이 서버에 설치해 둔 설정·vmlinux를 쓰도록 /opt/kdump-tools로 둡니다.
tool_base() {
    local base
    base=$(cd "$(dirname "$(readlink -f "$0")")/.." 2>/dev/null && pwd) || base=""
    if [ -n "$base" ] && [ -f "$base/.install-info" ]; then
        printf '%s' "$base"
    else
        printf '%s' /opt/kdump-tools
    fi
}
TOOL_BASE=$(tool_base)
CONFIG_FILE="${ANALYZE_KDUMP_CONF:-$TOOL_BASE/analyze-kdump.conf}"
CONFIG_FILE_SET=0
ENV_VMLINUX_BASE="${VMLINUX_BASE:-}"
ENV_REPORT_DIR="${REPORT_DIR:-}"
ENV_REPORT_PREFIX="${REPORT_PREFIX:-}"
ENV_ANALYSIS_PREFIX="${ANALYSIS_PREFIX:-}"
ENV_DEFAULT_VMCORE="${DEFAULT_VMCORE:-}"
ENV_REPORT_COMMANDS="${REPORT_COMMANDS:-}"
ENV_REPORT_COMMAND_FILE="${REPORT_COMMAND_FILE:-}"
ENV_LLM_ENABLED="${LLM_ENABLED:-}"
ENV_LLM_API_KEY="${LLM_API_KEY:-}"
ENV_LLM_API_KEY_FILE="${LLM_API_KEY_FILE:-}"
ENV_LLM_PROVIDER="${LLM_PROVIDER:-}"
ENV_LLM_BASE_URL="${LLM_BASE_URL:-}"
ENV_LLM_MODEL="${LLM_MODEL:-}"
ENV_LLM_MAX_TOKENS="${LLM_MAX_TOKENS:-}"
ENV_LLM_MAX_REPORT_CHARS="${LLM_MAX_REPORT_CHARS:-}"
ENV_LLM_TIMEOUT="${LLM_TIMEOUT:-}"
ENV_LLM_RETRY="${LLM_RETRY:-}"
ENV_LLM_TEMPERATURE="${LLM_TEMPERATURE:-}"
ENV_LLM_OPENAI_TOKEN_PARAM="${LLM_OPENAI_TOKEN_PARAM:-}"
ENV_LLM_MASK_SENSITIVE="${LLM_MASK_SENSITIVE:-}"
ENV_LLM_PROMPT_FILE="${LLM_PROMPT_FILE:-}"
ENV_LLM_CLI_PATH="${LLM_CLI_PATH:-}"
ENV_LLM_CLI_ARGS="${LLM_CLI_ARGS:-}"
ENV_LLM_CLI_TOKEN_FILE="${LLM_CLI_TOKEN_FILE:-}"
ENV_LLM_ANTHROPIC_VERSION="${LLM_ANTHROPIC_VERSION:-}"
VMLINUX_BASE="${VMLINUX_BASE:-$TOOL_BASE/vmlinux}"
REPORT_DIR="${REPORT_DIR:-$TOOL_BASE/logs}"
REPORT_PREFIX="${REPORT_PREFIX:-kdump-report}"
ANALYSIS_PREFIX="${ANALYSIS_PREFIX:-kdump-analysis}"
LLM_ENABLED="${LLM_ENABLED:-0}"
LLM_PROVIDER="${LLM_PROVIDER:-openai}"
LLM_BASE_URL="${LLM_BASE_URL:-}"
# 비어 있으면 provider별 기본값을 씁니다(resolve_llm_model 참고).
LLM_MODEL="${LLM_MODEL:-}"
LLM_CLI_PATH="${LLM_CLI_PATH:-}"
LLM_CLI_ARGS="${LLM_CLI_ARGS:-}"
# claude-code: CLAUDE_CODE_OAUTH_TOKEN으로 넘길 장기 토큰 파일 (claude setup-token으로 발급)
LLM_CLI_TOKEN_FILE="${LLM_CLI_TOKEN_FILE:-}"
LLM_MAX_TOKENS="${LLM_MAX_TOKENS:-8192}"
LLM_MAX_REPORT_CHARS="${LLM_MAX_REPORT_CHARS:-60000}"
LLM_TIMEOUT="${LLM_TIMEOUT:-120}"
LLM_RETRY="${LLM_RETRY:-2}"
LLM_TEMPERATURE="${LLM_TEMPERATURE:-}"
LLM_OPENAI_TOKEN_PARAM="${LLM_OPENAI_TOKEN_PARAM:-auto}"
LLM_MASK_SENSITIVE="${LLM_MASK_SENSITIVE:-1}"
LLM_ANTHROPIC_VERSION="${LLM_ANTHROPIC_VERSION:-2023-06-01}"
REPORT_MODE=0
LLM_MODE=""
LLM_FAILED=0
LLM_REPORT_INPUT=""
VMCORE=""
WORK_DIR=""

cleanup() {
    if [ -n "$WORK_DIR" ]; then
        rm -rf "$WORK_DIR"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    echo "사용법: analyze-kdump [-config <conf-file>] [-report|-r] [-llm|--llm] [-no-llm] [/path/to/vmcore | /path/to/crash-dir]"
    echo "        analyze-kdump [-config <conf-file>] --llm-report <report-file>   # 기존 리포트를 LLM으로만 분석"
    echo "        analyze-kdump --version"
}

# 설치 디렉터리의 .install-info(install.sh가 기록)와 VERSION 파일에서 버전을 읽습니다.
print_version() {
    local base info version commit installed

    base=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
    info="$base/.install-info"
    version=$(sed -n 's/^VERSION=//p' "$info" 2>/dev/null | head -n 1)
    commit=$(sed -n 's/^COMMIT=//p' "$info" 2>/dev/null | head -n 1)
    installed=$(sed -n 's/^INSTALLED_AT=//p' "$info" 2>/dev/null | head -n 1)
    if [ -z "$version" ]; then
        version=$(head -n 1 "$base/VERSION" 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$commit" ] && command -v git >/dev/null 2>&1; then
        commit=$(git -c safe.directory="$base" -C "$base" rev-parse HEAD 2>/dev/null || true)
    fi
    echo "analyze-kdump ${version:-unknown}${commit:+ (commit ${commit:0:7})}${installed:+, 설치 $installed}"
}

# 이미 만든 리포트(다른 서버에서 가져온 리포트 포함)를 LLM으로만 분석합니다.
# crash와 vmcore 없이 동작하므로 원격 서버의 리포트를 로컬에서 분석할 때 씁니다.
run_llm_report_only() {
    local base

    if [ ! -f "$LLM_REPORT_INPUT" ]; then
        echo "리포트 파일을 찾을 수 없습니다: $LLM_REPORT_INPUT" >&2
        exit 1
    fi

    REPORT_DIR=$(cd "$(dirname "$LLM_REPORT_INPUT")" && pwd)
    REPORT_FILE="$REPORT_DIR/$(basename "$LLM_REPORT_INPUT")"
    base=$(basename "$REPORT_FILE" .txt)
    RUN_ID="${base#"${REPORT_PREFIX}-"}"
    # 같은 리포트를 다시 분석해도 이전 분석 파일을 덮어쓰지 않도록 번호를 붙입니다.
    if [ -e "$REPORT_DIR/${ANALYSIS_PREFIX}-${RUN_ID}.txt" ]; then
        local n=2
        while [ -e "$REPORT_DIR/${ANALYSIS_PREFIX}-${RUN_ID}-$n.txt" ]; do
            n=$((n + 1))
        done
        RUN_ID="${RUN_ID}-$n"
    fi

    LLM_ENABLED=1
    ensure_work_dir
    append_llm_analysis

    echo "report:  $REPORT_FILE"
    echo "analysis: $ANALYSIS_FILE"
    if [ "$LLM_FAILED" -eq 1 ]; then
        echo "LLM 분석에 실패했습니다. 사유는 분석 파일을 확인해 주세요." >&2
        exit 3
    fi
    exit 0
}

ensure_work_dir() {
    if [ -z "$WORK_DIR" ]; then
        WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/analyze-kdump.XXXXXX")
    fi
}

check_config_permissions() {
    local owner mode

    owner=$(stat -c '%u' "$CONFIG_FILE")
    mode=$(stat -c '%a' "$CONFIG_FILE")

    # conf 파일은 셸 스크립트로 실행되므로 다른 사용자가 수정할 수 있으면 안 됩니다.
    if [ "$owner" != "0" ] && [ "$owner" != "$(id -u)" ]; then
        echo "conf 파일 소유자가 root 또는 실행 사용자가 아닙니다: $CONFIG_FILE" >&2
        exit 1
    fi
    if [ $((8#$mode & 8#022)) -ne 0 ]; then
        echo "conf 파일에 group/other 쓰기 권한이 있습니다. 'chmod go-w $CONFIG_FILE'로 제한해 주세요." >&2
        exit 1
    fi
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        check_config_permissions
        # shellcheck source=/opt/kdump-tools/analyze-kdump.conf
        . "$CONFIG_FILE"
    elif [ "$CONFIG_FILE_SET" -eq 1 ]; then
        echo "conf 파일을 찾을 수 없습니다: $CONFIG_FILE" >&2
        exit 1
    fi
}

sanitize_number() {
    local name="$1" default="$2"

    case "${!name}" in
        ''|*[!0-9]*)
            printf -v "$name" '%s' "$default"
            ;;
    esac
}

resolve_vmcore() {
    local target="$1" found

    if [ ! -d "$target" ]; then
        printf '%s' "$target"
        return
    fi
    # "/var/crash/x/"처럼 끝에 붙은 '/'를 떼어 경로가 "//vmcore"가 되지 않게 합니다.
    while [ "${#target}" -gt 1 ] && [ "${target%/}" != "$target" ]; do
        target="${target%/}"
    done

    # 덤프 파일 이름: RHEL·SUSE는 vmcore, Ubuntu·Debian(kdump-tools)은 dump.<YYYYMMDDHHMM>
    # SSH로 받은 RHEL 덤프는 vmcore.flat(makedumpfile flattened 형식)입니다. 변환해 둔 vmcore가 있으면 그것을 씁니다.
    if [ -f "$target/vmcore" ]; then
        printf '%s' "$target/vmcore"
        return
    fi
    if [ -f "$target/vmcore.flat" ]; then
        printf '%s' "$target/vmcore.flat"
        return
    fi
    found=$(ls -1t "$target"/dump.[0-9]* 2>/dev/null | head -n 1)
    if [ -n "$found" ]; then
        printf '%s' "$found"
        return
    fi

    # /var/crash 처럼 덤프 디렉터리들의 상위 경로가 주어지면 가장 최근 덤프를 사용합니다.
    found=$(ls -1t "$target"/*/vmcore "$target"/*/vmcore.flat "$target"/*/dump.[0-9]* 2>/dev/null | head -n 1)
    if [ -n "$found" ]; then
        resolve_vmcore "$(dirname "$found")"
    fi
}

# makedumpfile -F(SSH 전송)로 만든 flattened 형식은 파일 맨 앞이 "makedumpfile" 서명입니다.
# 오래된 crash는 이 형식을 열지 못하므로 그때는 makedumpfile -R로 되돌립니다(crash 9.0.1은 바로 읽음).
is_flat_dump() {
    [ "$(head -c 12 "$1" 2>/dev/null | tr -d '\0')" = "makedumpfile" ]
}

# 디렉터리의 남은 공간(바이트)
free_bytes() {
    df -P -B1 "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

# flattened 덤프를 일반 덤프로 바꾸고 바꾼 파일 경로를 출력합니다.
# 같은 디렉터리의 vmcore로 만들어 다음 분석과 덤프 목록에서 다시 쓰고,
# 쓸 수 없거나 공간이 모자라면 임시 작업 디렉터리에 만들어 분석 뒤 지웁니다.
convert_flat_dump() {
    local src="$1" size dir out tmp free

    if ! command -v makedumpfile >/dev/null 2>&1; then
        echo "flattened 형식 덤프를 바꾸려면 makedumpfile이 필요합니다: $src" >&2
        return 1
    fi
    size=$(stat -c '%s' "$src")
    # 변환하면 대략 원본 크기가 되므로 원본 크기 + 64MB 여유를 확인합니다.
    for dir in "$(dirname "$src")" work; do
        if [ "$dir" = work ]; then
            ensure_work_dir
            dir="$WORK_DIR"
        elif [ "$dir/vmcore" = "$src" ]; then
            continue
        fi
        out="$dir/vmcore"
        if [ ! -d "$dir" ] || [ ! -w "$dir" ]; then
            continue
        fi
        free=$(free_bytes "$dir")
        if [ -z "$free" ] || [ "$free" -le $((size + 67108864)) ]; then
            echo "공간이 모자라 여기에는 변환하지 않습니다: $dir (남은 공간 $((${free:-0} / 1048576))MB)" >&2
            continue
        fi
        tmp="$out.converting.$$"
        echo "flattened 형식 덤프를 변환하는 중: $src -> $out ($((size / 1048576))MB)" >&2
        if makedumpfile -R "$tmp" < "$src" >&2 && [ -s "$tmp" ] && mv -f "$tmp" "$out"; then
            printf '%s' "$out"
            return 0
        fi
        rm -f "$tmp"
        echo "변환에 실패했습니다: $dir" >&2
    done
    echo "flattened 형식 덤프를 변환하지 못했습니다: $src ($((size / 1048576))MB 필요)" >&2
    echo "덤프 디렉터리나 ${TMPDIR:-/tmp}에 공간을 확보하거나, TMPDIR을 공간이 있는 위치로 지정해 실행해 주세요." >&2
    return 1
}

find_vmlinux() {
    local candidate

    for candidate in \
        "$VMLINUX_BASE/$KVER/vmlinux" \
        "/usr/lib/debug/lib/modules/$KVER/vmlinux" \
        "/usr/lib/debug/boot/vmlinux-$KVER"; do
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

print_vmlinux_install_hint() {
    local package="kernel"

    echo "설치 예:"
    if command -v apt-get >/dev/null 2>&1; then
        echo "  # dbgsym(ddebs) 저장소가 설정되어 있어야 합니다."
        echo "  apt-get install -y linux-image-$KVER-dbgsym   # 또는 linux-image-unsigned-$KVER-dbgsym"
        echo "  # 설치 후 /usr/lib/debug/boot/vmlinux-$KVER 를 자동으로 사용합니다."
        return
    fi

    case "$KVER" in
        *uek*) package="kernel-uek" ;;
        *.rt*) package="kernel-rt" ;;
    esac
    echo "  dnf debuginfo-install -y $package-$KVER"
    echo "  # 설치 후 /usr/lib/debug/lib/modules/$KVER/vmlinux 를 자동으로 사용합니다."
    echo "  # 별도로 보관하려면:"
    echo "  mkdir -p $VMLINUX_BASE/$KVER"
    echo "  cp /usr/lib/debug/lib/modules/$KVER/vmlinux $VMLINUX_BASE/$KVER/"
}

print_default_report_commands() {
    cat <<'EOF'
set scroll off
sys
bt
bt -a
foreach UN bt
ps
log
kmem -i
mod -t
runq
dev -d
mount
files
EOF
}

# taint된(외부·서명 없음·강제 로드 등) 모듈의 함수가 콜스택에 있는 태스크만 foreach bt 결과에서 골라냅니다.
# 잠금을 쥐고 잠든 태스크처럼 실행 중도 D 상태도 아닌 원인 태스크를 리포트에 남기기 위한 것입니다.
print_tainted_tasks() {
    local all="$1" mods="$2" names

    names=$(awk 'NR > 1 && $1 != "" { printf "%s%s", sep, $1; sep = "|" }' "$mods" 2>/dev/null)
    if [ -z "$names" ]; then
        echo "(taint된 모듈이 없습니다)"
        return
    fi
    echo "# taint 모듈: ${names//|/, }"
    # awk -v는 \[ 같은 이스케이프를 풀어 버리므로 정규식은 환경 변수로 넘깁니다.
    TAINT_RE="\\[(${names})\\]" awk '
        /^PID:/ { if (keep) print block "\n"; block = $0; keep = 0; next }
        { block = block "\n" $0; if ($0 ~ ENVIRON["TAINT_RE"]) keep = 1 }
        END { if (keep) print block }
    ' "$all"
}

# ---- 아키텍처 확인

normalize_arch() {
    case "$1" in
        x86_64|amd64) echo x86_64 ;;
        aarch64|arm64) echo aarch64 ;;
        i?86) echo i386 ;;
        ppc64|ppc64le) echo ppc64 ;;
        s390x|riscv64) echo "$1" ;;
        *) echo "" ;;
    esac
}

# ELF(vmlinux, ELF 형식 vmcore)는 e_machine으로, kdump 압축 형식(makedumpfile)은 헤더의 utsname.machine으로 판단합니다.
file_arch() {
    local file="$1" magic machine

    magic=$(dd if="$file" bs=8 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n') || true
    case "$magic" in
        7f454c46*)
            case "$(od -An -tu2 -j18 -N2 "$file" 2>/dev/null | tr -d ' ')" in
                62) echo x86_64 ;;
                183) echo aarch64 ;;
                3) echo i386 ;;
                21) echo ppc64 ;;
                22) echo s390x ;;
                243) echo riscv64 ;;
            esac
            ;;
        4b44554d50202020)
            # struct disk_dump_header: signature[8], header_version(int), new_utsname(65바이트 x 6, machine은 5번째)
            machine=$(dd if="$file" bs=1 skip=272 count=65 2>/dev/null | tr -d '\0') || true
            normalize_arch "$machine"
            ;;
    esac
}

# crash는 자기와 같은 아키텍처의 덤프만 읽고, vmlinux도 덤프와 같은 아키텍처여야 합니다.
# 어긋나면 crash가 알아보기 어려운 오류로 끝나므로 미리 확인해 원인을 알려 줍니다.
check_arch() {
    VMCORE_ARCH=$(file_arch "$VMCORE")
    VMLINUX_ARCH=$(file_arch "$VMLINUX")
    HOST_ARCH=$(normalize_arch "$(uname -m)")
    is_enabled "${REPORT_ARCH_CHECK:-1}" || return 0
    if [ -n "$VMCORE_ARCH" ] && [ -n "$VMLINUX_ARCH" ] && [ "$VMCORE_ARCH" != "$VMLINUX_ARCH" ]; then
        echo "vmcore와 vmlinux의 아키텍처가 다릅니다: vmcore $VMCORE_ARCH, vmlinux $VMLINUX_ARCH" >&2
        echo "덤프를 만든 커널과 같은 아키텍처의 디버그 커널(vmlinux)이 필요합니다." >&2
        exit 1
    fi
    if [ -n "$VMCORE_ARCH" ] && [ -n "$HOST_ARCH" ] && [ "$VMCORE_ARCH" != "$HOST_ARCH" ]; then
        echo "이 서버($HOST_ARCH)와 덤프($VMCORE_ARCH)의 아키텍처가 다릅니다." >&2
        echo "crash는 보통 자기와 같은 아키텍처의 덤프만 읽습니다. $VMCORE_ARCH 서버에서 분석해 주세요." >&2
        echo "(확인을 건너뛰려면 REPORT_ARCH_CHECK=0)" >&2
        exit 1
    fi
}

arch_summary() {
    printf '%s (vmcore %s, vmlinux %s, 이 서버 %s)' "${VMCORE_ARCH:-${HOST_ARCH:-unknown}}" \
        "${VMCORE_ARCH:-확인 불가}" "${VMLINUX_ARCH:-확인 불가}" "${HOST_ARCH:-확인 불가}"
}

# ---- 장애 유형 판정

# 덤프와 함께 저장된 커널 로그를 찾습니다. 없으면 makedumpfile로 vmcore에서 꺼냅니다(vmlinux 불필요, 빠름).
# 리포트에 남길 덤프 경로. 임시 디렉터리에 변환한 경우는 곧 지워지므로 원본(flattened) 경로를 씁니다.
vmcore_display() {
    case "$VMCORE" in
        "$WORK_DIR"/*) [ -n "$WORK_DIR" ] && [ -n "$FLAT_SOURCE" ] && { printf '%s' "$FLAT_SOURCE"; return; } ;;
    esac
    printf '%s' "$VMCORE"
}

find_dmesg_file() {
    local dir base

    # 변환한 덤프는 원본 위치의 vmcore-dmesg.txt나 dmesg.<시각>을 찾습니다.
    dir=$(dirname "${FLAT_SOURCE:-$VMCORE}")
    base=$(basename "${FLAT_SOURCE:-$VMCORE}")
    if [ -s "$dir/vmcore-dmesg.txt" ]; then
        printf '%s' "$dir/vmcore-dmesg.txt"
        return 0
    fi
    case "$base" in
        dump.*)
            if [ -s "$dir/dmesg.${base#dump.}" ]; then
                printf '%s' "$dir/dmesg.${base#dump.}"
                return 0
            fi
            ;;
    esac
    if command -v makedumpfile >/dev/null 2>&1 \
        && makedumpfile --dump-dmesg "$VMCORE" "$WORK_DIR/dmesg.txt" >/dev/null 2>&1 \
        && [ -s "$WORK_DIR/dmesg.txt" ]; then
        printf '%s' "$WORK_DIR/dmesg.txt"
        return 0
    fi
    return 1
}

# 리포트·JSON에 남길 커널 로그 경로. makedumpfile로 꺼낸 임시 파일은 곧 지워지므로 남기지 않습니다.
dmesg_source_path() {
    case "$DMESG_FILE" in
        ""|"$WORK_DIR"/*) ;;
        *) printf '%s' "$DMESG_FILE" ;;
    esac
}

# 로그 한 줄을 근거로 남길 때 타임스탬프를 떼고 길이를 줄입니다.
# oops는 첫 번째([#1])가 원인이므로 처음 줄을, 나머지(hung task, lockup, OOM)는 패닉 직전의 마지막 줄을 씁니다.
evidence_line() {
    local pick="${2:-first}"
    grep -E "$1" "$DMESG_FILE" 2>/dev/null \
        | { if [ "$pick" = last ]; then tail -n 1; else head -n 1; fi; } \
        | sed -E -e 's/^\[ *[0-9.]+\] //' -e 's/^\[ *[CT][0-9]+\] //' -e 's/[[:space:]]*$//' | cut -c1-200 || true
}

OOPS_RE='kernel BUG at|NULL pointer dereference|unable to handle|general protection fault|stack-protector|Oops:'

set_crash_type() {
    CRASH_TYPE="$1"
    CRASH_TYPE_LABEL="$2"
    CRASH_EVIDENCE=$(evidence_line "$3" "${4:-last}")
    [ -n "$CRASH_EVIDENCE" ] || CRASH_EVIDENCE=$(evidence_line 'Kernel panic - not syncing')
}

# 커널 로그로 장애 유형을 고릅니다. 패닉 메시지를 먼저 보고, 없으면 대표 경고 문구로 판단합니다.
# 결과: CRASH_TYPE(키), CRASH_TYPE_LABEL, CRASH_EVIDENCE, CRASH_RIP(oops일 때 문제 명령 위치), *_SEEN(함께 보이는 증상)
classify_crash() {
    local panic

    CRASH_TYPE=unknown
    CRASH_TYPE_LABEL="판단 불가"
    CRASH_EVIDENCE=""
    CRASH_RIP=""
    HUNG_SEEN=0
    LOCKUP_SEEN=0
    if [ -z "$DMESG_FILE" ]; then
        CRASH_TYPE_LABEL="판단 불가 (커널 로그를 찾지 못함)"
        return 0
    fi
    grep -q 'blocked for more than' "$DMESG_FILE" && HUNG_SEEN=1
    grep -qE 'soft lockup|hard LOCKUP|rcu.*detected stall|self-detected stall' "$DMESG_FILE" && LOCKUP_SEEN=1

    panic=$(grep -m1 'Kernel panic - not syncing' "$DMESG_FILE" || true)
    case "$panic" in
        *hung_task*)
            set_crash_type hung_task "hung task (D 상태로 오래 멈춘 태스크)" 'blocked for more than' ;;
        *softlockup*|*"soft lockup"*)
            set_crash_type soft_lockup "soft lockup (CPU가 커널 안에서 오래 멈춤)" 'soft lockup' ;;
        *"hard LOCKUP"*|*"Hard LOCKUP"*)
            set_crash_type hard_lockup "hard lockup (인터럽트까지 멈춤)" 'hard LOCKUP' ;;
        *"RCU Stall"*|*"rcu"*"stall"*)
            set_crash_type rcu_stall "RCU stall" 'detected stall' ;;
        *"Out of memory"*|*"out of memory"*|*"deadlocked on memory"*)
            set_crash_type oom "메모리 부족 (OOM, panic_on_oom)" 'invoked oom-killer|Out of memory: Kill' ;;
        *sysrq*)
            set_crash_type sysrq "수동 덤프 (sysrq-trigger)" 'sysrq: Trigger a crash|SysRq : Trigger a crash' ;;
        *"Machine check"*)
            set_crash_type mce "하드웨어 오류 (Machine Check)" 'Machine check|Hardware Error' ;;
        *NMI*)
            set_crash_type nmi "NMI" 'NMI' ;;
        *"Fatal exception"*)
            set_crash_type oops "커널 oops (BUG/잘못된 메모리 접근)" "$OOPS_RE" first ;;
        "")
            # 패닉 메시지가 없는 로그(잘린 로그 등)는 대표 문구로 판단합니다.
            if grep -qE 'sysrq: Trigger a crash|SysRq : Trigger a crash' "$DMESG_FILE"; then
                set_crash_type sysrq "수동 덤프 (sysrq-trigger)" 'Trigger a crash'
            elif grep -qE "$OOPS_RE" "$DMESG_FILE"; then
                set_crash_type oops "커널 oops (BUG/잘못된 메모리 접근)" "$OOPS_RE" first
            elif grep -q 'soft lockup' "$DMESG_FILE"; then
                set_crash_type soft_lockup "soft lockup (CPU가 커널 안에서 오래 멈춤)" 'soft lockup'
            elif grep -q 'hard LOCKUP' "$DMESG_FILE"; then
                set_crash_type hard_lockup "hard lockup (인터럽트까지 멈춤)" 'hard LOCKUP'
            elif [ "$HUNG_SEEN" -eq 1 ]; then
                set_crash_type hung_task "hung task (D 상태로 오래 멈춘 태스크)" 'blocked for more than'
            elif grep -q 'Out of memory' "$DMESG_FILE"; then
                set_crash_type oom "메모리 부족 (OOM)" 'Out of memory'
            fi
            ;;
        *)
            set_crash_type other "기타 패닉" 'Kernel panic - not syncing' ;;
    esac

    if [ "$CRASH_TYPE" = oops ]; then
        CRASH_RIP=$(grep -m1 -oE 'RIP: [0-9a-f]{4}:[A-Za-z_][A-Za-z0-9_.]*\+0x[0-9a-f]+' "$DMESG_FILE" \
            | sed 's/^RIP: [0-9a-f]*://' || true)
        case "$CRASH_RIP" in
            *[!A-Za-z0-9_.+x]*) CRASH_RIP="" ;;
        esac
    fi
}

# 장애 유형에 맞춰 기본 명령 뒤에 덧붙이는 crash 명령입니다.
print_type_commands() {
    case "$CRASH_TYPE" in
        hung_task) HUNG_SEEN=1 ;;
        soft_lockup|hard_lockup|rcu_stall) LOCKUP_SEEN=1 ;;
    esac
    if [ "$HUNG_SEEN" -eq 1 ]; then
        echo "ps -m | grep UN"
    fi
    if [ "$LOCKUP_SEEN" -eq 1 ]; then
        echo "runq -t"
        echo "irq -s"
        echo "ps -m | grep RU"
    fi
    case "$CRASH_TYPE" in
        oom)
            echo "kmem -V"
            echo "kmem -z"
            echo "ps -G | sort -n -k8 | tail -30"
            ;;
        oops)
            echo "bt -l"
            if [ -n "$CRASH_RIP" ]; then
                echo "dis -rl $CRASH_RIP"
            fi
            ;;
        mce|nmi)
            echo "mach"
            ;;
    esac
}

# 이미 기본·사용자 명령에 있는 명령은 다시 넣지 않습니다.
print_type_commands_unique() {
    local existing cmd
    existing=$(read_report_commands | sed -e 's/\r$//' -e 's/^[[:space:]]*//')
    print_type_commands | while IFS= read -r cmd; do
        printf '%s\n' "$existing" | grep -qxF -- "$cmd" || printf '%s\n' "$cmd"
    done
}

# ---- 모듈 심볼

# 커널 로그의 콜스택에 나온 모듈("func+0x1/0x2 [module]")입니다. 이 모듈들만 심볼을 불러오면
# 전체(mod -S)보다 훨씬 빠르면서 문제 지점의 함수·소스 줄을 볼 수 있습니다.
trace_modules() {
    [ -n "$DMESG_FILE" ] || return 0
    grep -oE '\+0x[0-9a-f]+/0x[0-9a-f]+ \[[A-Za-z0-9_]+\]' "$DMESG_FILE" 2>/dev/null \
        | sed -e 's/.*\[//' -e 's/\]$//' | sort -u | head -n 20 || true
}

module_debug_dir() {
    local dir
    for dir in "/usr/lib/debug/lib/modules/$KVER" "/usr/lib/debug/modules/$KVER"; do
        if [ -d "$dir" ]; then
            printf '%s' "$dir"
            return 0
        fi
    done
    return 1
}

# crash 입력 맨 앞에 넣을 모듈 심볼 명령을 만듭니다. REPORT_MODULE_SYMBOLS: auto(기본) | all | off
print_module_symbol_commands() {
    local mode="${REPORT_MODULE_SYMBOLS:-auto}" dir name file out="$WORK_DIR/mod-symbols.out"

    MODULE_SYMBOLS_NOTE=""
    MODULE_SYMBOLS_SKIPPED=""
    dir=$(module_debug_dir || true)
    case "$mode" in
        0|off|no|false)
            MODULE_SYMBOLS_NOTE="끔 (REPORT_MODULE_SYMBOLS=off)"
            return 0
            ;;
        all)
            echo "mod -S${dir:+ $dir} > $out"
            MODULE_SYMBOLS_NOTE="전체 모듈 (mod -S)"
            return 0
            ;;
    esac
    for name in $(trace_modules); do
        file=""
        if [ -n "$dir" ]; then
            file=$(find "$dir" \( -name "$name.ko*" -o -name "${name//_/-}.ko*" \) -print -quit 2>/dev/null || true)
        fi
        if [ -n "$dir" ] && [ -z "$file" ]; then
            # 외부 모듈처럼 디버그 정보가 없는 모듈은 건너뜁니다.
            MODULE_SYMBOLS_SKIPPED="${MODULE_SYMBOLS_SKIPPED:+$MODULE_SYMBOLS_SKIPPED, }$name"
            continue
        fi
        echo "mod -s $name${file:+ $file} >> $out"
    done
    MODULE_SYMBOLS_NOTE="콜스택에 나온 모듈만"
}

# 불러온 모듈 이름 목록(mod -s/-S 결과 표에서 오브젝트 파일이 있는 줄)
loaded_module_names() {
    [ -s "$WORK_DIR/mod-symbols.out" ] || return 0
    awk '$NF ~ /\.ko/ && $1 ~ /^[0-9a-f]+$/ { print $2 }' "$WORK_DIR/mod-symbols.out" | sort -u | paste -sd, - || true
}

# ---- JSON 요약

# 리포트에서 핵심 값만 뽑아 같은 이름의 .json 파일로 남깁니다. 다른 도구가 읽기 위한 것입니다.
write_report_json() {
    local json="${REPORT_FILE%.txt}.json"

    is_enabled "${REPORT_JSON:-1}" || return 0
    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3가 없어 JSON 요약은 만들지 않았습니다." >&2
        return 0
    fi
    REPORT_FILE="$REPORT_FILE" JSON_FILE="$json" CRASH_STATUS="$CRASH_STATUS" \
    J_VMCORE="$(vmcore_display)" J_KERNEL="$KVER" J_VMLINUX="$VMLINUX" \
    J_ARCH_VMCORE="${VMCORE_ARCH:-}" J_ARCH_VMLINUX="${VMLINUX_ARCH:-}" J_ARCH_HOST="${HOST_ARCH:-}" \
    J_TYPE="${CRASH_TYPE:-unknown}" J_TYPE_LABEL="${CRASH_TYPE_LABEL:-}" J_EVIDENCE="${CRASH_EVIDENCE:-}" \
    J_DMESG="$(dmesg_source_path)" J_MODULES="$(loaded_module_names)" \
    python3 - <<'PY' || echo "JSON 요약을 만들지 못했습니다." >&2
import json
import os
import re

env = os.environ
with open(env["REPORT_FILE"], encoding="utf-8", errors="replace") as f:
    text = f.read()

sections = []
for match in re.finditer(r"^===== (.+?) =====$", text, re.M):
    sections.append([match.group(1), match.end()])
bodies = {}
for i, (title, start) in enumerate(sections):
    end = text.rfind("\n=====", 0, sections[i + 1][1]) if i + 1 < len(sections) else len(text)
    bodies.setdefault(title, text[start:end].strip("\n"))

sys_info = {}
for line in bodies.get("crash> sys", "").splitlines():
    key, sep, value = line.partition(":")
    if sep and key.strip().isupper():
        sys_info[key.strip()] = value.strip().strip('"')

tainted = []
for line in bodies.get("taint 모듈 관련 태스크 (foreach bt에서 추림)", "").splitlines():
    if line.startswith("# taint 모듈:"):
        tainted = [name.strip() for name in line.split(":", 1)[1].split(",") if name.strip()]

summary = {
    "report": env["REPORT_FILE"],
    "vmcore": env["J_VMCORE"],
    "kernel": env["J_KERNEL"],
    "vmlinux": env["J_VMLINUX"],
    "arch": {"vmcore": env["J_ARCH_VMCORE"] or None, "vmlinux": env["J_ARCH_VMLINUX"] or None,
             "host": env["J_ARCH_HOST"] or None},
    "crash_type": {"type": env["J_TYPE"], "label": env["J_TYPE_LABEL"], "evidence": env["J_EVIDENCE"] or None},
    "dmesg_file": env["J_DMESG"] or None,
    "panic": sys_info.get("PANIC"),
    "sys": sys_info,
    "uninterruptible_tasks": bodies.get("crash> foreach UN bt", "").count("PID:"),
    "tainted_modules": tainted,
    "module_symbols": [m for m in env["J_MODULES"].split(",") if m],
    "crash_exit": int(env["CRASH_STATUS"] or 0),
    "sections": [{"title": t, "lines": len(b.splitlines())} for t, b in bodies.items()],
}
with open(env["JSON_FILE"], "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
    if [ -s "$json" ]; then
        echo "json:    $json"
    fi
}

read_report_commands() {
    if [ -n "${REPORT_COMMAND_FILE:-}" ]; then
        cat "$REPORT_COMMAND_FILE"
    elif [ -n "${REPORT_COMMANDS:-}" ]; then
        printf '%s\n' "$REPORT_COMMANDS"
    else
        print_default_report_commands
    fi
}

# 각 crash 명령의 출력을 별도 파일로 리다이렉트한 뒤 "===== crash> <명령> =====" 섹션으로 합칩니다.
# 섹션 구분이 있어야 LLM 입력을 줄일 때 섹션별로 잘라낼 수 있습니다.
run_crash_report() {
    local section_dir="$WORK_DIR/sections"
    local input_file="$WORK_DIR/crash-input"
    local crash_log="$WORK_DIR/crash.log"
    local cmd count=0 i status=0

    mkdir -p "$section_dir"
    : > "$input_file"
    # 모듈 심볼은 다른 명령보다 먼저 불러와야 bt 등에 반영됩니다.
    print_module_symbol_commands >> "$input_file"

    while IFS= read -r cmd || [ -n "$cmd" ]; do
        cmd="${cmd%$'\r'}"
        cmd="${cmd#"${cmd%%[![:space:]]*}"}"
        case "$cmd" in
            ''|'#'*)
                continue
                ;;
            'set '*)
                # crash 상태만 바꾸는 명령은 섹션으로 만들지 않습니다.
                printf '%s\n' "$cmd" >> "$input_file"
                continue
                ;;
        esac

        count=$((count + 1))
        printf '%s\n' "$cmd" > "$section_dir/$count.cmd"
        case "$cmd" in
            *'>'*)
                # 사용자가 직접 리다이렉트한 명령은 그대로 둡니다.
                printf '%s\n' "$cmd" >> "$input_file"
                ;;
            *)
                printf '%s > %s\n' "$cmd" "$section_dir/$count.out" >> "$input_file"
                ;;
        esac
    done < <(read_report_commands; is_enabled "${REPORT_TYPE_COMMANDS:-1}" && print_type_commands_unique)
    if is_enabled "${REPORT_TAINTED_TASKS:-1}"; then
        # 섹션 목록에는 없는 내부 명령입니다. 결과는 아래에서 걸러 한 섹션으로 붙입니다.
        printf 'mod -t > %s\nforeach bt > %s\n' "$WORK_DIR/mod-taint.out" "$WORK_DIR/foreach-bt.out" >> "$input_file"
    fi
    echo "quit" >> "$input_file"

    crash "$VMLINUX" "$VMCORE" < "$input_file" > "$crash_log" 2>&1 &
    wait_crash_with_progress "$!" "$section_dir" "$count" || status=$?

    {
        for ((i = 1; i <= count; i++)); do
            echo
            echo "===== crash> $(cat "$section_dir/$i.cmd") ====="
            if [ -f "$section_dir/$i.out" ]; then
                cat "$section_dir/$i.out"
            fi
        done
        if [ -s "$WORK_DIR/foreach-bt.out" ]; then
            echo
            echo "===== taint 모듈 관련 태스크 (foreach bt에서 추림) ====="
            print_tainted_tasks "$WORK_DIR/foreach-bt.out" "$WORK_DIR/mod-taint.out"
        fi
        echo
        echo "===== crash 실행 로그 (exit $status) ====="
        cat "$crash_log"
    } >> "$REPORT_FILE"

    return "$status"
}

is_enabled() {
    case "$1" in
        1|true|TRUE|yes|YES|on|ON)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# 진행 표시는 stderr가 터미널이거나 ANALYZE_KDUMP_PROGRESS=1일 때만 stderr에 출력합니다.
# (analyze-kdump-ui가 출력을 tee로 받거나 SSH로 원격 실행할 때 이 변수를 켭니다)
progress_enabled() {
    [ -t 2 ] || is_enabled "${ANALYZE_KDUMP_PROGRESS:-0}"
}

progress_line() {
    printf '\r\033[K%s' "$1" >&2
}

# 진행 표시를 마칠 때는 줄바꿈으로 끝내서, 뒤이어 나오는 "report:" 같은 줄이 섞이지 않게 합니다.
progress_end() {
    progress_line "$1"
    printf '\n' >&2
}

progress_bar() {
    local done="$1" total="$2" width=20 filled
    [ "$total" -gt 0 ] || total=1
    filled=$((done * width / total))
    printf '[%s%s]' "$(printf '%*s' "$filled" '' | tr ' ' '#')" "$(printf '%*s' "$((width - filled))" '' | tr ' ' '.')"
}

# crash가 끝날 때까지 명령별 출력 파일이 생기는 것을 보고 진행 바를 그립니다.
# crash는 명령을 시작할 때 리다이렉트 파일을 만들므로 파일 개수가 현재 명령 번호입니다.
wait_crash_with_progress() {
    local pid="$1" section_dir="$2" total="$3" status=0 start=$SECONDS current cmd

    if progress_enabled; then
        while kill -0 "$pid" 2>/dev/null; do
            current=$(find "$section_dir" -name '*.out' 2>/dev/null | wc -l)
            if [ "$current" -eq 0 ]; then
                cmd="crash 시작 중 (vmlinux 읽는 중)"
            else
                cmd=$(cat "$section_dir/$current.cmd" 2>/dev/null)
            fi
            progress_line "  crash 리포트 생성 $(progress_bar "$current" "$total") $current/$total $cmd ($((SECONDS - start))초)"
            sleep 0.5
        done
    fi
    wait "$pid" || status=$?
    if progress_enabled; then
        if [ "$status" -eq 0 ]; then
            progress_end "  crash 리포트 생성 $(progress_bar "$total" "$total") $total/$total 완료 ($((SECONDS - start))초)"
        else
            progress_end "  crash 리포트 생성 실패 (exit $status, $((SECONDS - start))초)"
        fi
    fi
    return "$status"
}

# 끝나는 시점을 알 수 없는 작업(LLM 호출)을 백그라운드로 실행하며 회전 표시와 경과 시간을 보여줍니다.
run_with_progress() {
    # 회전 표시에 쓰는 역슬래시 문자를 그대로 씁니다.
    # shellcheck disable=SC1003
    local label="$1" pid status=0 start=$SECONDS i=0 spinner='|/-\'
    shift

    if ! progress_enabled; then
        "$@" || status=$?
        return "$status"
    fi
    "$@" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        progress_line "  ${spinner:$((i % 4)):1} $label ... $((SECONDS - start))초"
        i=$((i + 1))
        sleep 0.5
    done
    wait "$pid" || status=$?
    if [ "$status" -eq 0 ]; then
        progress_end "  $label 완료 ($((SECONDS - start))초)"
    else
        progress_end "  $label 실패 (exit $status, $((SECONDS - start))초)"
    fi
    return "$status"
}

get_llm_api_key() {
    local key mode

    if [ -n "${LLM_API_KEY:-}" ]; then
        key="$LLM_API_KEY"
    elif [ -n "${LLM_API_KEY_FILE:-}" ]; then
        if [ ! -r "$LLM_API_KEY_FILE" ]; then
            echo "LLM API key 파일을 읽을 수 없습니다: $LLM_API_KEY_FILE"
            return 1
        fi
        mode=$(stat -c '%a' "$LLM_API_KEY_FILE")
        if [ $((8#$mode & 8#077)) -ne 0 ]; then
            echo "경고: API key 파일 권한이 너무 넓습니다($mode). 'chmod 600 $LLM_API_KEY_FILE'을 권장합니다." >&2
        fi
        key=$(sed -n '1p' "$LLM_API_KEY_FILE")
    else
        echo "LLM_API_KEY 또는 LLM_API_KEY_FILE을 설정해 주세요."
        return 1
    fi

    # Windows 줄바꿈(CR)이나 앞뒤 공백이 섞이면 인증 헤더가 깨지므로 제거합니다.
    key="${key//$'\r'/}"
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    if [ -z "$key" ]; then
        echo "LLM API key가 비어 있습니다."
        return 1
    fi
    printf '%s' "$key"
}

normalize_llm_provider() {
    case "$1" in
        openai|openai-compatible|chat-completions)
            echo "openai"
            ;;
        gemini|google)
            echo "gemini"
            ;;
        claude|anthropic)
            echo "claude"
            ;;
        claude-code|claude_code|claudecode)
            echo "claude-code"
            ;;
        codex|codex-cli)
            echo "codex"
            ;;
        *)
            echo "$1"
            ;;
    esac
}

is_cli_provider() {
    case "$LLM_PROVIDER" in
        claude-code|codex)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# LLM_MODEL이 비어 있으면 provider별 기본 모델을 씁니다.
# CLI provider는 비워 두면 CLI에 설정된 기본 모델을 사용합니다.
resolve_llm_model() {
    if [ -n "$LLM_MODEL" ]; then
        return
    fi
    case "$LLM_PROVIDER" in
        openai)
            LLM_MODEL="gpt-4o-mini"
            ;;
        claude)
            LLM_MODEL="claude-sonnet-5-5"
            ;;
    esac
}

# 구독 계정으로 로그인한 Claude Code / Codex CLI를 비대화 모드로 실행합니다.
# 프로젝트 파일(CLAUDE.md, AGENTS.md 등)을 읽지 않도록 빈 작업 디렉터리에서 실행하고,
# 파일 읽기나 명령 실행 같은 도구는 끈 채 텍스트만 주고받습니다.
llm_cli_command() {
    if [ -n "$LLM_CLI_PATH" ]; then
        printf '%s' "$LLM_CLI_PATH"
    elif [ "$LLM_PROVIDER" = "codex" ]; then
        printf '%s' "codex"
    else
        printf '%s' "claude"
    fi
}

# LLM_CLI_TOKEN_FILE의 첫 줄(Claude Code 장기 토큰)을 읽습니다. 앞뒤 공백과 CR은 제거합니다.
read_cli_token() {
    local token

    [ -n "${LLM_CLI_TOKEN_FILE:-}" ] || return 0
    if [ ! -r "$LLM_CLI_TOKEN_FILE" ]; then
        echo "LLM_CLI_TOKEN_FILE을 읽을 수 없습니다: $LLM_CLI_TOKEN_FILE" >&2
        return 1
    fi
    token=$(sed -n '1p' "$LLM_CLI_TOKEN_FILE" | tr -d '\r')
    token="${token#"${token%%[![:space:]]*}"}"
    token="${token%"${token##*[![:space:]]}"}"
    printf '%s' "$token"
}

run_llm_cli() {
    local prompt_base="$1" output_file="$2" log_file="$3"
    local cli cli_dir token cwd="$WORK_DIR/cli-cwd" status=0
    local -a cmd extra_args

    cli=$(llm_cli_command)
    # nvm 등으로 설치한 CLI는 "#!/usr/bin/env node"로 시작하므로, 같은 폴더의 node를 찾도록 PATH 앞에 붙입니다.
    cli_dir=$(dirname "$(command -v "$cli")")
    mkdir -p "$cwd"
    # LLM_CLI_ARGS는 공백으로 나눕니다. 따옴표로 묶은 인자는 지원하지 않습니다.
    read -r -a extra_args <<< "$LLM_CLI_ARGS"

    case "$LLM_PROVIDER" in
        claude-code)
            token=$(read_cli_token 2> "$log_file") || return 1
            # --bare는 구독(OAuth) 인증을 읽지 않으므로 쓰지 않습니다.
            cmd=("$cli" -p --output-format text --tools "" --strict-mcp-config
                --no-session-persistence --system-prompt "$(cat "$prompt_base.system")")
            if [ -n "$LLM_MODEL" ]; then
                cmd+=(--model "$LLM_MODEL")
            fi
            cmd+=("${extra_args[@]}")
            # 토큰은 명령줄(ps에 보임)이 아니라 이 서브셸의 환경변수로만 넘깁니다.
            (
                cd "$cwd" || exit 1
                # 이 하위 셸 안에서만 PATH를 바꿉니다.
                # shellcheck disable=SC2030
                export PATH="$cli_dir:$PATH"
                if [ -n "$token" ]; then
                    export CLAUDE_CODE_OAUTH_TOKEN="$token"
                fi
                timeout "$LLM_TIMEOUT" "${cmd[@]}"
            ) < "$prompt_base.input" > "$output_file" 2> "$log_file" || status=$?
            ;;
        codex)
            # codex exec에는 시스템 프롬프트 옵션이 없어 지시문과 리포트를 합쳐 넘깁니다.
            {
                cat "$prompt_base.system"
                echo
                echo
                echo "----- crash report -----"
                cat "$prompt_base.input"
            } > "$prompt_base.codex"
            cmd=("$cli" exec --skip-git-repo-check --sandbox read-only --color never
                --ephemeral --output-last-message "$output_file")
            if [ -n "$LLM_MODEL" ]; then
                cmd+=(--model "$LLM_MODEL")
            fi
            cmd+=("${extra_args[@]}" -)
            # 위 하위 셸의 PATH 변경과 무관합니다.
            # shellcheck disable=SC2031
            (cd "$cwd" && PATH="$cli_dir:$PATH" timeout "$LLM_TIMEOUT" "${cmd[@]}") \
                < "$prompt_base.codex" > "$log_file" 2>&1 || status=$?
            ;;
    esac
    return "$status"
}

get_llm_url() {
    if [ -n "${LLM_BASE_URL:-}" ]; then
        printf '%s' "$LLM_BASE_URL"
        return
    fi

    case "$LLM_PROVIDER" in
        openai)
            printf '%s' "https://api.openai.com/v1/chat/completions"
            ;;
        gemini)
            case "$LLM_MODEL" in
                models/*)
                    printf '%s' "https://generativelanguage.googleapis.com/v1beta/${LLM_MODEL}:generateContent"
                    ;;
                *)
                    printf '%s' "https://generativelanguage.googleapis.com/v1beta/models/${LLM_MODEL}:generateContent"
                    ;;
            esac
            ;;
        claude)
            printf '%s' "https://api.anthropic.com/v1/messages"
            ;;
        *)
            echo "지원하지 않는 LLM_PROVIDER입니다: $LLM_PROVIDER"
            return 1
            ;;
    esac
}

# OpenAI 공식 API의 최신 모델은 max_completion_tokens만 받고,
# vLLM/Ollama 같은 호환 서버는 max_tokens를 쓰는 경우가 많습니다.
resolve_openai_token_param() {
    case "$LLM_OPENAI_TOKEN_PARAM" in
        max_tokens|max_completion_tokens|none)
            printf '%s' "$LLM_OPENAI_TOKEN_PARAM"
            ;;
        *)
            if [ -n "${LLM_BASE_URL:-}" ]; then
                printf '%s' "max_tokens"
            else
                printf '%s' "max_completion_tokens"
            fi
            ;;
    esac
}

# curl config 파일의 따옴표 문자열 안에 넣을 수 있도록 \ 와 " 를 이스케이프합니다.
curl_config_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

write_llm_payload() {
    # "$1"은 .system·.input 파일 이름을 만드는 데만 쓰고 읽지 않습니다.
    # shellcheck disable=SC2094
    python3 -"$REPORT_FILE" "$LLM_PROVIDER" "$LLM_MODEL" "$LLM_MAX_REPORT_CHARS" "$LLM_MAX_TOKENS" "${LLM_PROMPT_FILE:-}" "$LLM_TEMPERATURE" "$(resolve_openai_token_param)" "$LLM_MASK_SENSITIVE" "$1" > "$1" <<'PY'
import io
import json
import re
import sys

# LANG=C 같은 환경에서도 한글이 깨지지 않도록 출력 인코딩을 고정합니다.
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding="utf-8", write_through=True)

(report_path, provider, model, max_chars_raw, max_tokens_raw, prompt_file,
 temperature_raw, openai_token_param, mask_raw, output_path) = sys.argv[1:11]


def to_int(raw, default):
    try:
        return int(raw)
    except ValueError:
        return default


max_chars = to_int(max_chars_raw, 60000)
max_tokens = to_int(max_tokens_raw, 8192)
temperature = None
if temperature_raw.strip():
    try:
        temperature = float(temperature_raw)
    except ValueError:
        temperature = None
mask = mask_raw in ("1", "true", "TRUE", "yes", "YES", "on", "ON")

SECTION_RE = re.compile(r"^===== (.+?) =====$", re.M)
# 섹션별 (가중치, 잘릴 때 남길 위치). 가중치가 클수록 더 많은 글자 수를 배정받습니다.
# log는 패닉 메시지가 끝에 있으므로 뒷부분을 남깁니다.
SECTION_POLICY = {
    "crash> sys": (2, "head"),
    "crash> bt": (3, "head"),
    "crash> bt -a": (2, "head"),
    "crash> foreach UN bt": (2, "head"),
    "taint 모듈 관련 태스크 (foreach bt에서 추림)": (2, "head"),
    "crash> log": (3, "tail"),
    "crash> ps": (1, "head"),
    "crash> bt -l": (2, "head"),
    "crash> ps -m | grep UN": (1, "head"),
}


def policy(title):
    if title.startswith("crash 실행 로그"):
        return 1, "tail"
    if title.startswith("crash> dis -rl"):
        return 1, "tail"   # 문제 명령은 함수 시작부터 RIP까지 디스어셈블한 끝부분에 있습니다.
    return SECTION_POLICY.get(title, (1, "both"))


def cut(text, limit, keep):
    if len(text) <= limit:
        return text
    newline = text.find("\n")
    header = text[:newline + 1] if newline >= 0 else ""
    body = text[len(header):]
    marker = f"\n[... {len(text) - limit} chars truncated for LLM input ...]\n"
    room = max(limit - len(header) - len(marker), 0)
    if keep == "head":
        body = body[:room] + marker
    elif keep == "tail":
        body = marker + (body[len(body) - room:] if room > 0 else "")
    else:
        head_len = room // 2
        tail_len = room - head_len
        body = body[:head_len] + marker + (body[len(body) - tail_len:] if tail_len > 0 else "")
    return header + body


def fit(text, limit):
    if limit <= 0 or len(text) <= limit:
        return text

    matches = list(SECTION_RE.finditer(text))
    if not matches:
        return cut(text, limit, "both")

    preamble = text[:matches[0].start()]
    sections = []
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        sections.append((match.group(1), text[match.start():end]))

    # 가중치 기반 water-filling: 몫보다 작은 섹션은 통째로 넣고, 남은 예산을 큰 섹션끼리 나눕니다.
    budget = max(limit - len(preamble), 0)
    pending = list(range(len(sections)))
    alloc = {}
    while pending:
        unit = budget / sum(policy(sections[i][0])[0] for i in pending)
        fitted = [i for i in pending if len(sections[i][1]) <= unit * policy(sections[i][0])[0]]
        if not fitted:
            for i in pending:
                alloc[i] = int(unit * policy(sections[i][0])[0])
            break
        for i in fitted:
            alloc[i] = len(sections[i][1])
            budget -= alloc[i]
        pending = [i for i in pending if i not in fitted]

    return preamble + "".join(
        cut(body, alloc[i], policy(title)[1]) for i, (title, body) in enumerate(sections)
    )


IPV4_RE = re.compile(r"(?<![\d.])(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)(?![\d.])")
MAC_RE = re.compile(r"(?<![0-9A-Fa-f:])(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}(?![0-9A-Fa-f:])")
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
NODENAME_RE = re.compile(r"^\s*NODENAME:\s*(\S+)", re.M)


def mask_text(text):
    for name in set(NODENAME_RE.findall(text)):
        short = name.split(".")[0]
        # 호스트명에 쓰이는 문자(영문, 숫자, '-')만 경계로 봅니다. '_'나 '/' 옆도 마스킹됩니다.
        patterns = {value: r"(?![A-Za-z0-9-])" for value in (name, short)}
        if "-" in short:
            # device-mapper 이름(LVM)에서는 '-'가 '--'로 바뀌고 뒤에 VG/LV 구분자 '-'가 붙습니다.
            # 예: /dev/mapper/rlm_kdump--test-root
            patterns[short.replace("-", "--")] = r"(?=-(?!-)|[^A-Za-z0-9-]|$)"
        for value in sorted(patterns, key=len, reverse=True):
            if len(value) >= 3:
                text = re.sub(r"(?<![A-Za-z0-9-])" + re.escape(value) + patterns[value], "<HOSTNAME>", text)
    text = EMAIL_RE.sub("<EMAIL>", text)
    text = MAC_RE.sub("<MAC>", text)
    text = IPV4_RE.sub("<IPV4>", text)
    return text


with open(report_path, "r", encoding="utf-8", errors="replace") as report:
    report_text = report.read()

if mask:
    report_text = mask_text(report_text)
report_text = fit(report_text, max_chars)

if prompt_file:
    with open(prompt_file, "r", encoding="utf-8", errors="replace") as prompt:
        system_prompt = prompt.read()
else:
    system_prompt = """You are a senior Linux kernel crash dump analyst.
Analyze the crash report and write a concise Korean incident report.
Start the report with exactly one line in the form "판정: <one Korean sentence stating the probable root cause>" before any heading or table.
Include: probable root cause, evidence, impacted subsystem/process, confidence, and recommended next actions.
If evidence is insufficient, say what additional crash commands or data are needed."""

if mask:
    system_prompt += """

Some identifiers in the report are masked as <HOSTNAME>, <IPV4>, <MAC> or <EMAIL>. Treat them as placeholders, not as errors."""

if provider in ("claude-code", "codex"):
    # CLI provider는 JSON 대신 시스템 프롬프트와 입력을 각각 파일로 넘깁니다.
    with open(output_path + ".system", "w", encoding="utf-8") as system_file:
        system_file.write(system_prompt)
    with open(output_path + ".input", "w", encoding="utf-8") as input_file:
        input_file.write(report_text)
    sys.exit(0)

if provider == "openai":
    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": report_text},
        ],
    }
    if openai_token_param in ("max_tokens", "max_completion_tokens") and max_tokens > 0:
        payload[openai_token_param] = max_tokens
    if temperature is not None:
        payload["temperature"] = temperature
elif provider == "gemini":
    generation_config = {"maxOutputTokens": max_tokens}
    if temperature is not None:
        generation_config["temperature"] = temperature
    payload = {
        "systemInstruction": {
            "parts": [{"text": system_prompt}],
        },
        "contents": [
            {
                "role": "user",
                "parts": [{"text": report_text}],
            }
        ],
        "generationConfig": generation_config,
    }
elif provider == "claude":
    payload = {
        "model": model,
        "max_tokens": max_tokens,
        "system": system_prompt,
        "messages": [
            {"role": "user", "content": report_text},
        ],
    }
    # Anthropic Messages API는 2026-10-21부터 temperature를 보내면 400을 반환하므로 전송하지 않습니다.
else:
    raise SystemExit(f"지원하지 않는 LLM_PROVIDER입니다: {provider}")

print(json.dumps(payload, ensure_ascii=False))
PY
}

extract_llm_content() {
    python3 - "$LLM_PROVIDER" "$1" <<'PY'
import io
import json
import sys

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding="utf-8", write_through=True)

provider, response_path = sys.argv[1:3]

with open(response_path, "r", encoding="utf-8", errors="replace") as response:
    data = json.load(response)

content = ""
truncated = False

if provider == "gemini":
    candidates = data.get("candidates") or []
    block_reason = (data.get("promptFeedback") or {}).get("blockReason")
    if not candidates and block_reason:
        raise SystemExit(f"Gemini가 요청을 차단했습니다: {block_reason}")
    parts = []
    for candidate in candidates:
        if candidate.get("finishReason") == "MAX_TOKENS":
            truncated = True
        candidate_content = candidate.get("content") or {}
        for part in candidate_content.get("parts", []):
            if part.get("thought"):
                continue
            text = part.get("text")
            if text:
                parts.append(text)
    content = "\n".join(parts)
elif provider == "claude":
    if data.get("stop_reason") == "max_tokens":
        truncated = True
    parts = []
    for item in data.get("content", []):
        if item.get("type", "text") != "text":
            continue
        text = item.get("text")
        if text:
            parts.append(text)
    content = "\n".join(parts)
else:
    choices = data.get("choices") or []
    if choices:
        if choices[0].get("finish_reason") == "length":
            truncated = True
        message = choices[0].get("message") or {}
        content = message.get("content") or choices[0].get("text") or ""
        if isinstance(content, list):
            content = "\n".join(part.get("text", "") for part in content if isinstance(part, dict))

    if data.get("status") == "incomplete":
        truncated = True

    if not content and isinstance(data.get("output_text"), str):
        content = data["output_text"]

    if not content:
        output = data.get("output") or []
        parts = []
        for item in output:
            for subitem in item.get("content", []):
                text = subitem.get("text")
                if text:
                    parts.append(text)
        content = "\n".join(parts)

if not content:
    if truncated:
        raise SystemExit("LLM 응답이 출력 토큰 한도에서 잘려 분석 내용이 비어 있습니다. LLM_MAX_TOKENS를 늘려 주세요.")
    raise SystemExit("LLM 응답에서 분석 내용을 찾을 수 없습니다.")

print(content.strip())
if truncated:
    print()
    print("[경고] 출력 토큰 한도(LLM_MAX_TOKENS)에 도달해 분석이 중간에 잘렸을 수 있습니다.")
PY
}

llm_skip() {
    echo "LLM 분석을 건너뜁니다: $1" >> "$ANALYSIS_FILE"
    LLM_FAILED=1
}

# 진행 표시와 함께 백그라운드로 돌릴 수 있도록 curl 호출과 리다이렉션을 한 함수로 묶습니다.
# 인자: URL, curl 설정 파일, 요청 파일, 응답 파일, HTTP 상태 코드 파일, stderr 파일
llm_curl() {
    curl -sS --connect-timeout 10 --max-time "$LLM_TIMEOUT" --retry "$LLM_RETRY" -w '%{http_code}' \
        -o "$4" --config "$2" -X POST --data-binary "@$3" "$1" > "$5" 2> "$6"
}

append_llm_cli_analysis() {
    local cli status=0
    local prompt_base="$WORK_DIR/llm-prompt"
    local output_file="$WORK_DIR/llm-cli-output.txt"
    local log_file="$WORK_DIR/llm-cli.log"

    cli=$(llm_cli_command)
    if ! command -v "$cli" >/dev/null 2>&1; then
        llm_skip "$cli 명령을 찾을 수 없습니다. 설치 여부와 LLM_CLI_PATH를 확인해 주세요."
        return 0
    fi

    if ! command -v timeout >/dev/null 2>&1; then
        llm_skip "timeout 명령을 찾을 수 없습니다."
        return 0
    fi

    if ! write_llm_payload "$prompt_base" 2> "$log_file"; then
        llm_skip "요청 내용 생성에 실패했습니다."
        cat "$log_file" >> "$ANALYSIS_FILE"
        return 0
    fi

    run_with_progress "LLM 분석 ($LLM_PROVIDER)" run_llm_cli "$prompt_base" "$output_file" "$log_file" || status=$?

    if [ "$status" -eq 124 ]; then
        llm_skip "$cli 응답이 ${LLM_TIMEOUT}초 안에 오지 않았습니다. LLM_TIMEOUT을 늘려 주세요."
        return 0
    fi
    if [ "$status" -ne 0 ]; then
        llm_skip "$cli 실행 실패(exit $status). 로그인 상태와 사용 한도를 확인해 주세요."
        {
            tail -n 40 "$log_file"
            if [ -f "$output_file" ]; then
                tail -n 20 "$output_file"
            fi
        } >> "$ANALYSIS_FILE"
        return 0
    fi
    if [ ! -f "$output_file" ] || ! grep -q '[^[:space:]]' "$output_file"; then
        llm_skip "$cli 응답이 비어 있습니다."
        tail -n 40 "$log_file" >> "$ANALYSIS_FILE"
        return 0
    fi

    cat "$output_file" >> "$ANALYSIS_FILE"
}

append_llm_analysis() {
    local api_key api_key_escaped llm_url http_status
    local payload_file="$WORK_DIR/llm-payload.json"
    local response_file="$WORK_DIR/llm-response.json"
    local curl_config_file="$WORK_DIR/curl.conf"
    local curl_err_file="$WORK_DIR/curl.err"
    local status_file="$WORK_DIR/curl.status"

    if ! is_enabled "$LLM_ENABLED"; then
        return 0
    fi

    LLM_PROVIDER=$(normalize_llm_provider "$LLM_PROVIDER")
    resolve_llm_model
    ANALYSIS_FILE="$REPORT_DIR/${ANALYSIS_PREFIX}-${RUN_ID}.txt"

    {
        echo "kdump llm root cause analysis"
        echo "source_report: $REPORT_FILE"
        echo "provider:  $LLM_PROVIDER"
        echo "model:     ${LLM_MODEL:-(CLI 기본값)}"
        echo "masking:   $(is_enabled "$LLM_MASK_SENSITIVE" && echo on || echo off)"
        echo "generated: $(date -Is)"
        echo
    } > "$ANALYSIS_FILE"

    if ! command -v python3 >/dev/null 2>&1; then
        llm_skip "python3 명령을 찾을 수 없습니다."
        return 0
    fi

    if is_cli_provider; then
        append_llm_cli_analysis
        return 0
    fi

    if ! command -v curl >/dev/null 2>&1; then
        llm_skip "curl 명령을 찾을 수 없습니다."
        return 0
    fi

    if [ -z "$LLM_MODEL" ]; then
        llm_skip "LLM_MODEL을 설정해 주세요."
        return 0
    fi

    if ! api_key=$(get_llm_api_key); then
        llm_skip "$api_key"
        return 0
    fi

    if ! llm_url=$(get_llm_url); then
        llm_skip "$llm_url"
        return 0
    fi

    # WORK_DIR은 mktemp -d로 만들어 700 권한이고, 종료 시 trap으로 삭제됩니다.
    api_key_escaped=$(curl_config_escape "$api_key")
    {
        echo 'header = "Content-Type: application/json"'
        case "$LLM_PROVIDER" in
            openai)
                printf 'header = "Authorization: Bearer %s"\n' "$api_key_escaped"
                ;;
            gemini)
                printf 'header = "x-goog-api-key: %s"\n' "$api_key_escaped"
                ;;
            claude)
                printf 'header = "x-api-key: %s"\n' "$api_key_escaped"
                printf 'header = "anthropic-version: %s"\n' "$LLM_ANTHROPIC_VERSION"
                ;;
        esac
    } > "$curl_config_file"
    chmod 600 "$curl_config_file"

    if ! write_llm_payload "$payload_file" 2> "$curl_err_file"; then
        llm_skip "요청 payload 생성에 실패했습니다."
        cat "$curl_err_file" >> "$ANALYSIS_FILE"
        return 0
    fi

    if ! run_with_progress "LLM 분석 ($LLM_PROVIDER)" llm_curl "$llm_url" "$curl_config_file" "$payload_file" \
        "$response_file" "$status_file" "$curl_err_file"; then
        llm_skip "API 호출 실패"
        cat "$curl_err_file" >> "$ANALYSIS_FILE"
        return 0
    fi
    http_status=$(cat "$status_file")

    case "$http_status" in
        2[0-9][0-9])
            ;;
        *)
            llm_skip "API 응답 코드 $http_status"
            sed -n '1,40p' "$response_file" >> "$ANALYSIS_FILE"
            return 0
            ;;
    esac

    if ! extract_llm_content "$response_file" >> "$ANALYSIS_FILE" 2>&1; then
        llm_skip "응답 파싱에 실패했습니다."
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -config|--config)
            if [ -z "${2:-}" ]; then
                echo "-config 옵션에는 conf 파일 경로가 필요합니다." >&2
                usage
                exit 1
            fi
            CONFIG_FILE="$2"
            CONFIG_FILE_SET=1
            shift 2
            ;;
        -report|--report|-r)
            REPORT_MODE=1
            shift
            ;;
        -llm|--llm)
            LLM_MODE=1
            REPORT_MODE=1
            shift
            ;;
        -no-llm|--no-llm)
            LLM_MODE=0
            shift
            ;;
        -llm-report|--llm-report)
            if [ -z "${2:-}" ]; then
                echo "--llm-report 옵션에는 리포트 파일 경로가 필요합니다." >&2
                usage
                exit 1
            fi
            LLM_REPORT_INPUT="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -V|-version|--version)
            print_version
            exit 0
            ;;
        -*)
            echo "알 수 없는 옵션입니다: $1" >&2
            usage
            exit 1
            ;;
        *)
            if [ -n "$VMCORE" ]; then
                echo "vmcore 파일은 하나만 지정할 수 있습니다." >&2
                usage
                exit 1
            fi
            VMCORE="$1"
            shift
            ;;
    esac
done

CLI_VMCORE="$VMCORE"
CLI_REPORT_MODE="$REPORT_MODE"
CLI_LLM_MODE="$LLM_MODE"
load_config
REPORT_MODE="$CLI_REPORT_MODE"

# 우선순위: 명령줄 옵션 > 환경변수 > conf 파일 > 스크립트 기본값
[ -n "$ENV_VMLINUX_BASE" ] && VMLINUX_BASE="$ENV_VMLINUX_BASE"
[ -n "$ENV_REPORT_DIR" ] && REPORT_DIR="$ENV_REPORT_DIR"
[ -n "$ENV_REPORT_PREFIX" ] && REPORT_PREFIX="$ENV_REPORT_PREFIX"
[ -n "$ENV_ANALYSIS_PREFIX" ] && ANALYSIS_PREFIX="$ENV_ANALYSIS_PREFIX"
[ -n "$ENV_DEFAULT_VMCORE" ] && DEFAULT_VMCORE="$ENV_DEFAULT_VMCORE"
[ -n "$ENV_REPORT_COMMANDS" ] && REPORT_COMMANDS="$ENV_REPORT_COMMANDS"
[ -n "$ENV_REPORT_COMMAND_FILE" ] && REPORT_COMMAND_FILE="$ENV_REPORT_COMMAND_FILE"
[ -n "$ENV_LLM_ENABLED" ] && LLM_ENABLED="$ENV_LLM_ENABLED"
[ -n "$ENV_LLM_API_KEY" ] && LLM_API_KEY="$ENV_LLM_API_KEY"
[ -n "$ENV_LLM_API_KEY_FILE" ] && LLM_API_KEY_FILE="$ENV_LLM_API_KEY_FILE"
[ -n "$ENV_LLM_PROVIDER" ] && LLM_PROVIDER="$ENV_LLM_PROVIDER"
[ -n "$ENV_LLM_BASE_URL" ] && LLM_BASE_URL="$ENV_LLM_BASE_URL"
[ -n "$ENV_LLM_MODEL" ] && LLM_MODEL="$ENV_LLM_MODEL"
[ -n "$ENV_LLM_MAX_TOKENS" ] && LLM_MAX_TOKENS="$ENV_LLM_MAX_TOKENS"
[ -n "$ENV_LLM_MAX_REPORT_CHARS" ] && LLM_MAX_REPORT_CHARS="$ENV_LLM_MAX_REPORT_CHARS"
[ -n "$ENV_LLM_TIMEOUT" ] && LLM_TIMEOUT="$ENV_LLM_TIMEOUT"
[ -n "$ENV_LLM_RETRY" ] && LLM_RETRY="$ENV_LLM_RETRY"
[ -n "$ENV_LLM_TEMPERATURE" ] && LLM_TEMPERATURE="$ENV_LLM_TEMPERATURE"
[ -n "$ENV_LLM_OPENAI_TOKEN_PARAM" ] && LLM_OPENAI_TOKEN_PARAM="$ENV_LLM_OPENAI_TOKEN_PARAM"
[ -n "$ENV_LLM_MASK_SENSITIVE" ] && LLM_MASK_SENSITIVE="$ENV_LLM_MASK_SENSITIVE"
[ -n "$ENV_LLM_PROMPT_FILE" ] && LLM_PROMPT_FILE="$ENV_LLM_PROMPT_FILE"
[ -n "$ENV_LLM_CLI_PATH" ] && LLM_CLI_PATH="$ENV_LLM_CLI_PATH"
[ -n "$ENV_LLM_CLI_ARGS" ] && LLM_CLI_ARGS="$ENV_LLM_CLI_ARGS"
[ -n "$ENV_LLM_CLI_TOKEN_FILE" ] && LLM_CLI_TOKEN_FILE="$ENV_LLM_CLI_TOKEN_FILE"
[ -n "$ENV_LLM_ANTHROPIC_VERSION" ] && LLM_ANTHROPIC_VERSION="$ENV_LLM_ANTHROPIC_VERSION"
[ -n "$CLI_LLM_MODE" ] && LLM_ENABLED="$CLI_LLM_MODE"

sanitize_number LLM_MAX_TOKENS 8192
sanitize_number LLM_MAX_REPORT_CHARS 60000
sanitize_number LLM_TIMEOUT 120
sanitize_number LLM_RETRY 2

if [ -n "$LLM_REPORT_INPUT" ]; then
    run_llm_report_only
fi

# conf 파일이 내부 변수 VMCORE를 덮어써도 무시하고, 명령줄 인자 또는 DEFAULT_VMCORE만 사용합니다.
VMCORE="$CLI_VMCORE"
if [ -z "$VMCORE" ] && [ -n "${DEFAULT_VMCORE:-}" ]; then
    VMCORE="$DEFAULT_VMCORE"
fi

if [ -z "$VMCORE" ]; then
    usage
    exit 1
fi

VMCORE_INPUT="$VMCORE"
VMCORE=$(resolve_vmcore "$VMCORE_INPUT")

if [ -z "$VMCORE" ]; then
    echo "디렉터리에서 덤프 파일(vmcore, vmcore.flat 또는 dump.<시각>)을 찾을 수 없습니다: $VMCORE_INPUT" >&2
    exit 1
fi

if [ ! -f "$VMCORE" ]; then
    echo "vmcore 파일을 찾을 수 없습니다: $VMCORE" >&2
    exit 1
fi

if ! command -v crash >/dev/null 2>&1; then
    echo "crash 명령을 찾을 수 없습니다. crash 패키지를 설치해 주세요." >&2
    exit 1
fi

# makedumpfile flattened 형식(SSH 전송, Ubuntu·Debian은 로컬 저장도)은 crash 9.0.1 등 최근 crash가 바로 읽습니다.
# crash가 읽지 못할 때만 makedumpfile -R로 일반 덤프로 바꿔서 분석합니다.
FLAT_SOURCE=""
KVER_OK=1
KVER_OUTPUT=$(crash --osrelease "$VMCORE" 2>&1) || KVER_OK=0
if [ "$KVER_OK" -eq 0 ] && is_flat_dump "$VMCORE"; then
    if ! is_enabled "${FLAT_CONVERT:-1}"; then
        echo "이 crash가 읽지 못하는 makedumpfile flattened 형식 덤프입니다: $VMCORE" >&2
        echo "다음처럼 바꾼 뒤 분석하거나, FLAT_CONVERT=1로 자동 변환을 켜 주세요." >&2
        echo "  makedumpfile -R $(dirname "$VMCORE")/vmcore < $VMCORE" >&2
        exit 1
    fi
    echo "이 crash가 flattened 형식을 바로 읽지 못해 변환합니다." >&2
    # 변환은 $( ) 안에서 실행되므로 임시 디렉터리는 여기서 만들어야 종료할 때 지워집니다.
    ensure_work_dir
    FLAT_SOURCE="$VMCORE"
    VMCORE=$(convert_flat_dump "$FLAT_SOURCE") || exit 1
    KVER_OK=1
    KVER_OUTPUT=$(crash --osrelease "$VMCORE" 2>&1) || KVER_OK=0
fi

if [ "$KVER_OK" -eq 0 ]; then
    echo "vmcore 커널 버전을 확인할 수 없습니다." >&2
    echo "$KVER_OUTPUT" >&2
    exit 1
fi

KVER=$(printf '%s\n' "$KVER_OUTPUT" | tail -1)

if [ -z "$KVER" ] || [ "$KVER" = "unknown" ]; then
    echo "vmcore 커널 버전을 확인할 수 없습니다." >&2
    exit 1
fi

# vmcore에서 읽은 값을 경로에 쓰므로 '/'나 '..' 같은 문자가 들어오지 않도록 검사합니다.
case "$KVER" in
    .*|*[!A-Za-z0-9._+-]*)
        echo "vmcore에서 읽은 커널 버전 형식이 올바르지 않습니다: $KVER" >&2
        exit 1
        ;;
esac

if ! VMLINUX=$(find_vmlinux); then
    echo "해당 커널 버전의 vmlinux가 없습니다" >&2
    echo "커널 버전: $KVER" >&2
    echo "찾아본 경로:" >&2
    echo "  $VMLINUX_BASE/$KVER/vmlinux" >&2
    echo "  /usr/lib/debug/lib/modules/$KVER/vmlinux" >&2
    echo "  /usr/lib/debug/boot/vmlinux-$KVER" >&2
    echo >&2
    print_vmlinux_install_hint >&2
    exit 1
fi

check_arch

echo "vmcore:  $VMCORE"
[ -n "$FLAT_SOURCE" ] && echo "변환 원본: $FLAT_SOURCE"
echo "kernel:  $KVER"
echo "vmlinux: $VMLINUX"
echo "arch:    $(arch_summary)"
echo

if [ "$REPORT_MODE" -eq 1 ]; then
    if [ -n "${REPORT_COMMAND_FILE:-}" ] && [ ! -f "$REPORT_COMMAND_FILE" ]; then
        echo "리포트 명령 파일을 찾을 수 없습니다: $REPORT_COMMAND_FILE" >&2
        exit 1
    fi

    ensure_work_dir
    mkdir -p "$REPORT_DIR"
    # 같은 초에 여러 번 실행해도 덮어쓰지 않도록 PID를 붙이고, 분석 파일도 같은 ID를 씁니다.
    RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
    REPORT_FILE="$REPORT_DIR/${REPORT_PREFIX}-${RUN_ID}.txt"

    DMESG_FILE=$(find_dmesg_file || true)
    classify_crash
    # 모듈 심볼 안내(MODULE_SYMBOLS_NOTE)를 헤더에 쓰려고 미리 한 번 계산합니다.
    print_module_symbol_commands > /dev/null

    {
        echo "kdump summary report"
        echo "generated: $(date -Is)"
        echo "vmcore:    $(vmcore_display)"
        if [ -n "$FLAT_SOURCE" ]; then
            if [ "$(vmcore_display)" = "$FLAT_SOURCE" ]; then
                echo "converted: 임시 디렉터리에서 변환해 분석 (makedumpfile flattened 형식, 변환본은 분석 뒤 삭제)"
            else
                echo "converted: $FLAT_SOURCE (makedumpfile flattened 형식에서 변환)"
            fi
        fi
        echo "kernel:    $KVER"
        echo "vmlinux:   $VMLINUX"
        echo "arch:      $(arch_summary)"
        echo "type:      $CRASH_TYPE_LABEL [$CRASH_TYPE]"
        if [ -n "$CRASH_EVIDENCE" ]; then
            echo "evidence:  $CRASH_EVIDENCE"
        fi
        case "$DMESG_FILE" in
            "") echo "dmesg:     (없음)" ;;
            "$WORK_DIR"/*) echo "dmesg:     (vmcore에서 makedumpfile로 추출)" ;;
            *) echo "dmesg:     $DMESG_FILE" ;;
        esac
    } > "$REPORT_FILE"
    echo "type:    $CRASH_TYPE_LABEL"

    CRASH_STATUS=0
    run_crash_report || CRASH_STATUS=$?

    # 불러온 모듈 심볼은 crash를 실행한 뒤에야 알 수 있어 헤더 대신 리포트 끝에 덧붙입니다.
    {
        echo
        echo "===== 모듈 심볼 ====="
        echo "방식: $MODULE_SYMBOLS_NOTE"
        loaded=$(loaded_module_names | sed 's/,/, /g')
        echo "불러온 모듈: ${loaded:-(없음)}"
        if [ -n "$MODULE_SYMBOLS_SKIPPED" ]; then
            echo "디버그 정보가 없어 건너뜀: $MODULE_SYMBOLS_SKIPPED"
        fi
    } >> "$REPORT_FILE"

    echo "report:  $REPORT_FILE"
    write_report_json
    if [ "$CRASH_STATUS" -ne 0 ]; then
        echo "crash 실행이 실패했습니다(exit $CRASH_STATUS). 리포트 끝의 'crash 실행 로그'를 확인해 주세요." >&2
        if [ "$CRASH_STATUS" -eq 137 ]; then
            echo "crash가 강제 종료(SIGKILL)됐습니다. 메모리 부족(OOM)일 가능성이 높으니 'dmesg | grep -i oom'으로 확인하고, 메모리를 늘리거나 swap을 추가해 주세요." >&2
        fi
        if is_enabled "$LLM_ENABLED"; then
            echo "불완전한 리포트이므로 LLM 분석은 건너뜁니다." >&2
        fi
        exit 2
    fi

    append_llm_analysis

    if [ -n "${ANALYSIS_FILE:-}" ]; then
        echo "analysis: $ANALYSIS_FILE"
    fi
    if [ "$LLM_FAILED" -eq 1 ]; then
        echo "LLM 분석에 실패했습니다. 사유는 분석 파일을 확인해 주세요." >&2
        exit 3
    fi
    exit 0
fi

exec crash "$VMLINUX" "$VMCORE"
